# The patch is checked by its sha256 and applied byte for byte; never let git rewrite its line endings.
# A blank unified-diff context line is one space. Preserve that syntax; check restored source whitespace instead.
*.patch -text -whitespace
*.sh text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

# The migration provenance records exact source bytes, including line endings.
# Preserve captured/ adapted frontend sources and original license notices on every OS.
packages/modern-ui/src/** -text
packages/modern-ui/licenses/** -text
packages/modern-ui/LICENSE -text
packages/modern-ui/THIRD_PARTY_NOTICES.md -text

# The captured writer body includes the original trailing blank line in its digest.
tests/compat/fixtures/old-conversation-writer.mjs -whitespace
