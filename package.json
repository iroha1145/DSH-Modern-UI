{
  "name": "dsh-modern-ui-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "preview": "node scripts/create-preview.mjs",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --project tsconfig.client.json --noEmit --noUnusedLocals --noUnusedParameters && tsc --project tsconfig.host.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:compat": "node tests/compat/run.mjs",
    "build:host": "node scripts/build-host.mjs",
    "typecheck:host": "tsc --project tsconfig.host.json",
    "pack:plugin": "npm pack ./packages/modern-ui --pack-destination .artifacts",
    "probe:host": "node scripts/host-compat/probe.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@lexical/headless": "0.49.0",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-virtual": "3.14.10",
    "@types/hosted-git-info": "3.0.5",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "esbuild": "0.25.12",
    "execa": "10.2.1",
    "fflate": "0.8.3",
    "hosted-git-info": "9.0.3",
    "immer": "10.1.1",
    "ipaddr.js": "2.5.0",
    "jsdom": "26.1.0",
    "katex": "0.18.10",
    "lexical": "0.49.0",
    "lightningcss": "1.30.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.4",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.5.0",
    "simple-icons": "16.31.0",
    "typescript": "6.0.3",
    "undici": "8.12.2",
