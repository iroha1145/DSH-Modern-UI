+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+import { Followups } from '../src/client/Followups.tsx'
+import { de, en, es, fr, ja, pt, ru, zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+type Props = Parameters<typeof Followups>[0]
+interface InputState { phase: string; draft: string; attachmentIds: readonly string[] }
+interface SessionState {
+  removed: boolean
+  subagent: null | { address: { mode: string }; parentAvailable?: boolean }
+}
+
+const idle: InputState = { phase: 'plain', draft: '', attachmentIds: [] }
+const fence = 'How do the houses compare with the hotel?\nDraft a three-day agenda\n'
+
+function mount(options: {
+  code?: string
+  closed?: boolean
+  streaming?: boolean
+  input?: InputState
+  session?: SessionState
+  allowed?: boolean
+} = {}) {
+  const input = options.input ?? idle
+  const session = options.session ?? { removed: false, subagent: null }
+  const inputActions = {
+    setDraft: vi.fn(),
+    submit: vi.fn(),
+    insertText: vi.fn(() => true),
+    captureInsertion: vi.fn(() => ({ start: 4, end: 4, draftRev: 2 })),
+  }
+  const props = {
+    code: options.code ?? fence,
+    lang: 'followups',
+    closed: options.closed ?? true,
+    streaming: options.streaming ?? false,
+    settled: !(options.streaming ?? false),
+    matched: {},
+    labels: { copyLabel: 'Copy', copiedLabel: 'Copied' },
+    inputActions,
+    useInput: <T,>(selector: (state: InputState) => T): T => selector(input),
+    useSession: <T,>(selector: (state: SessionState) => T): T => selector(session),
+    useAccess: vi.fn(() => options.allowed ?? true),
+    t: (key: keyof typeof en) => en[key],
+  } as Props
+  const view = render(<Followups {...props} />)
+  return { ...view, inputActions, props }
+}
+
+function rows(container: HTMLElement): HTMLButtonElement[] {
+  return [...container.querySelectorAll<HTMLButtonElement>('li button')]
+}
+
+describe('followups section', () => {
+  it('shows nothing while the fence is open, even mid-stream, and nothing for an empty or unparsable block', () => {
+    expect(mount({ closed: false, streaming: true }).container.innerHTML).toBe('')
+    expect(mount({ closed: false, streaming: false }).container.innerHTML).toBe('')
+    expect(mount({ code: '\n  \n- \n' }).container.innerHTML).toBe('')
+  })
+
+  it('lists the questions under a localized heading as native buttons with a decorative chevron', () => {
+    const { container } = mount()
+    const section = container.querySelector('section[data-followups]')!
+    expect(section.getAttribute('aria-label')).toBe('Related')
+    expect(section.querySelector('[aria-hidden="true"]')?.textContent).toBe('Related')
+    const list = rows(container)
+    expect(list.map(row => row.textContent)).toEqual(['How do the houses compare with the hotel?', 'Draft a three-day agenda'])
+    for (const row of list) {
+      expect(row.tagName).toBe('BUTTON')
+      expect(row.type).toBe('button')
+      expect(row.querySelector('svg')?.getAttribute('aria-hidden')).toBe('true')
+      expect(row.hasAttribute('aria-disabled')).toBe(false)
+    }
+    expect(container.querySelectorAll('li')).toHaveLength(2)
+  })
+
+  it('shows the section when the fence is closed while the answer is still streaming', () => {
+    expect(rows(mount({ closed: true, streaming: true }).container)).toHaveLength(2)
+  })
+
+  it('sends the clicked question as the next message through the composer when it is empty', () => {
+    const { container, inputActions } = mount()
+    fireEvent.click(rows(container)[1]!)
+    expect(inputActions.setDraft).toHaveBeenCalledExactlyOnceWith('Draft a three-day agenda')
+    expect(inputActions.submit).toHaveBeenCalledOnce()
+    expect(inputActions.setDraft.mock.invocationCallOrder[0]).toBeLessThan(inputActions.submit.mock.invocationCallOrder[0]!)
+    expect(inputActions.insertText).not.toHaveBeenCalled()
+  })
+
+  it('sends a question once while the other rows stay available', () => {
+    const { container, inputActions } = mount()
+    const [first, second] = rows(container)
+    fireEvent.click(second!)
+    fireEvent.click(second!)
+    expect(inputActions.setDraft).toHaveBeenCalledExactlyOnceWith('Draft a three-day agenda')
+    expect(inputActions.submit).toHaveBeenCalledOnce()
+    expect(second?.getAttribute('aria-disabled')).toBe('true')
+    expect(first?.hasAttribute('aria-disabled')).toBe(false)
+    fireEvent.click(first!)
+    fireEvent.click(first!)
+    expect(inputActions.setDraft.mock.calls).toEqual([['Draft a three-day agenda'], ['How do the houses compare with the hotel?']])
+    expect(inputActions.submit).toHaveBeenCalledTimes(2)
+    expect(first?.getAttribute('aria-disabled')).toBe('true')
+  })
+
+  it.each([
+    ['typed text', { phase: 'plain', draft: 'half a thought', attachmentIds: [] }],
+    ['an attachment', { phase: 'plain', draft: '', attachmentIds: ['file-1'] }],
+    ['a claimed command', { phase: 'claimed', draft: '/goal ', attachmentIds: [] }],
+  ])('only inserts the question at the caret when the composer holds %s', (_name, input) => {
+    const { container, inputActions } = mount({ input })
+    fireEvent.click(rows(container)[0]!)
+    expect(inputActions.captureInsertion).toHaveBeenCalledOnce()
+    expect(inputActions.insertText).toHaveBeenCalledExactlyOnceWith('How do the houses compare with the hotel?', { start: 4, end: 4, draftRev: 2 })
+    expect(inputActions.setDraft).not.toHaveBeenCalled()
+    expect(inputActions.submit).not.toHaveBeenCalled()
+    expect(rows(container)[0]?.hasAttribute('aria-disabled')).toBe(false)
+  })
+
+  it.each(['adjudicating', 'submitting'])('disables rows during %s without changing the draft', (phase) => {
+    const { container, inputActions } = mount({ input: { phase, draft: 'Keep this draft', attachmentIds: [] } })
+    const row = rows(container)[0]!
+    expect(row.disabled).toBe(true)
+    expect(row.getAttribute('aria-disabled')).toBe('true')
+    fireEvent.click(row)
+    expect(inputActions.insertText).not.toHaveBeenCalled()
+    expect(inputActions.setDraft).not.toHaveBeenCalled()
+    expect(inputActions.submit).not.toHaveBeenCalled()
+  })
+
+  it('reports an insertion refused by the editor and allows a later retry', () => {
+    const { container, inputActions, getByRole, queryByRole } = mount({ input: { phase: 'plain', draft: 'Keep this draft', attachmentIds: [] } })
+    inputActions.insertText.mockReturnValueOnce(false)
+    fireEvent.click(rows(container)[0]!)
+    expect(getByRole('status').textContent).toBe(en.insertRejected)
+    expect(inputActions.setDraft).not.toHaveBeenCalled()
+    expect(inputActions.submit).not.toHaveBeenCalled()
+    expect(rows(container)[0]!.disabled).toBe(false)
+    fireEvent.click(rows(container)[0]!)
+    expect(inputActions.insertText).toHaveBeenCalledTimes(2)
+    expect(queryByRole('status')).toBeNull()
+  })
+
+  it('shows nothing where the Session cannot take a prompt', () => {
+    expect(mount({ allowed: false }).container.innerHTML).toBe('')
+    expect(mount({ session: { removed: true, subagent: null } }).container.innerHTML).toBe('')
+    const oneShot = { address: { mode: 'one-shot' }, parentAvailable: true }
+    expect(mount({ session: { removed: false, subagent: oneShot } }).container.innerHTML).toBe('')
+    const orphan = { address: { mode: 'continuable' }, parentAvailable: false }
+    expect(mount({ session: { removed: false, subagent: orphan } }).container.innerHTML).toBe('')
+    const child = { address: { mode: 'continuable' }, parentAvailable: true }
+    expect(rows(mount({ session: { removed: false, subagent: child } }).container)).toHaveLength(2)
+  })
+
+  it('asks the access hook about prompting', () => {
+    const { props } = mount()
+    expect(props.useAccess).toHaveBeenCalledWith('session/prompt')
+  })
+
+  it('cleans the model output before showing it', () => {
+    const { container } = mount({ code: '1. "First question?"\n- Second question?\n- Second question?' })
+    expect(rows(container).map(row => row.textContent)).toEqual(['First question?', 'Second question?'])
+  })
+})
+
+describe('related heading copy', () => {
+  it.each([
+    ['zh', zh.related, '相关问题'], ['en', en.related, 'Related'], ['ja', ja.related, '関連する質問'],
+    ['de', de.related, 'Verwandte Fragen'], ['es', es.related, 'Preguntas relacionadas'], ['fr', fr.related, 'Questions associées'],
+    ['ru', ru.related, 'Похожие вопросы'], ['pt', pt.related, 'Perguntas relacionadas'],
+  ])('is localized for %s', (_locale, actual, expected) => {
+    expect(actual).toBe(expected)
+  })
+})
diff --git a/packages/client/ui-intelligent-ui/tests/frame-measurement.client.spec.ts b/packages/client/ui-intelligent-ui/tests/frame-measurement.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3200dc0d237ca0420d84ffec2c4d5848fdb64989
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/tests/frame-measurement.client.spec.ts
@@ -0,0 +1,55 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { FRAME_EVENT_TYPE, frameProgram } from '../src/client/frame-content.ts'
+
+afterEach(() => { Reflect.deleteProperty(document.body, 'scrollHeight'); vi.restoreAllMocks(); vi.unstubAllGlobals(); document.body.replaceChildren(); document.head.replaceChildren() })
+
+it('reports natural content growth and shrinkage independently of viewport height', () => {
+  const root = document.createElement('main')
+  root.id = 'dsh-visual'
+  document.body.appendChild(root)
+  let naturalHeight = 500
+  Object.defineProperty(root, 'scrollHeight', { get: () => naturalHeight })
+  // A document measurement would retain the old viewport floor after shrinkage.
+  Object.defineProperty(document.body, 'scrollHeight', { configurable: true, get: () => 2400 })
+  const measure = vi.spyOn(root, 'getBoundingClientRect').mockImplementation(() => ({ height: naturalHeight } as DOMRect))
+  const observe = vi.fn()
+  let resized: (() => void) | undefined
+  vi.stubGlobal('ResizeObserver', class {
+    constructor(callback: () => void) { resized = callback }
+    observe = observe
+    disconnect = vi.fn()
+  })
+  const post = vi.spyOn(window.parent, 'postMessage').mockImplementation(() => undefined)
+  // Execute the shipped initializer; jsdom does not execute inserted authored scripts.
+  const program = frameProgram({ version: 1, title: 'Measurement', html: '<p>Content</p>' }, 'measure-test')
+  window.eval(program)
+  window.dispatchEvent(new MessageEvent('message', {
+    source: window.parent, data: { type: FRAME_EVENT_TYPE, token: 'measure-test', state: 'start' },
+  }))
+  const heights = () => post.mock.calls.map(([data]) => data as { state: string; height?: number })
+    .filter(data => data.state === 'resize').map(data => data.height)
+  // The body is observed too: a script may add content beside #dsh-visual.
+  expect(observe.mock.calls).toEqual([[root], [document.body]])
+  expect(heights()).toEqual([504])
+  const overflow = (): string => getComputedStyle(document.documentElement).overflowY
+  expect(overflow()).toBe('hidden')
+  naturalHeight = 5000
+  resized!()
+  resized!()
+  // Only content past the cap scrolls, so growing into the frame never shows a scrollbar.
+  expect(overflow()).toBe('auto')
+  naturalHeight = 100
+  resized!()
+  expect(heights()).toEqual([504, 5004, 104])
+  expect(measure).toHaveBeenCalled()
+  expect(overflow()).toBe('hidden')
+  vi.spyOn(document.body, 'getBoundingClientRect').mockImplementation(() => ({ height: 900 } as DOMRect))
+  resized!()
+  expect(heights().at(-1)).toBe(900)
+})
+
+it('joins fragment arrays into one authored document', () => {
+  const program = frameProgram({ version: 1, title: 'Fragments', html: ['<p>', 'Joined</p>'] }, 'fragments')
+  expect(program).toContain(JSON.stringify('<p>Joined</p>').replace(/</g, '\\u003c'))
+})
diff --git a/packages/client/ui-intelligent-ui/tests/parse-followups.client.spec.ts b/packages/client/ui-intelligent-ui/tests/parse-followups.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b9a60a7937e85a70a6c68340df190640d09853e1
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/tests/parse-followups.client.spec.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest'
+import { parseFollowups } from '../src/client/parse-followups.ts'
+
+describe('followups fence parsing', () => {
+  it('reads one question per line', () => {
+    expect(parseFollowups('How do the two options compare?\nWhat should I set up first?\n')).toEqual([
+      'How do the two options compare?', 'What should I set up first?',
+    ])
+    expect(parseFollowups('第一个问题是什么？\r\n第二个问题呢？\r\n')).toEqual(['第一个问题是什么？', '第二个问题呢？'])
+  })
+
+  it('drops bullets, numbering, and wrapping quotation marks the model adds anyway', () => {
+    expect(parseFollowups([
+      '- Dashed question?', '* Starred question?', '• Dotted question?', '1. Numbered question?', '2) Parenthesised question?',
+      '3、顿号问题？', '(4) Bracketed question?', '（5）全角括号问题？',
+    ].join('\n'))).toEqual([
+      'Dashed question?', 'Starred question?', 'Dotted question?', 'Numbered question?', 'Parenthesised question?',
+    ])
+    expect(parseFollowups('"Quoted question?"\n“Curly question?”\n「括号问题？」')).toEqual(['Quoted question?', 'Curly question?', '括号问题？'])
+  })
+
+  it('keeps quotation marks and hyphens that belong to the question', () => {
+    expect(parseFollowups('What does "foo" mean?\nIs -1 a valid index?\nWhy is it called "bar"')).toEqual([
+      'What does "foo" mean?', 'Is -1 a valid index?', 'Why is it called "bar"',
+    ])
+    expect(parseFollowups('"unbalanced question?')).toEqual(['"unbalanced question?'])
+  })
+
+  it('ignores blank lines, lone markers, and duplicates', () => {
+    expect(parseFollowups('\n  \nSame question?\n- \n…\nSame question?\n-\n   Next one?   \n')).toEqual(['Same question?', 'Next one?'])
+    expect(parseFollowups('')).toEqual([])
+    expect(parseFollowups('- \n1.\n')).toEqual([])
+  })
+
+  it('keeps at most five questions and drops lines too long to be one', () => {
+    const lines = Array.from({ length: 8 }, (_unused, index) => `Question ${index + 1}?`)
+    expect(parseFollowups(lines.join('\n'))).toEqual(lines.slice(0, 5))
+    const essay = `${'word '.repeat(60)}?`
+    expect(parseFollowups(`${essay}\nShort one?`)).toEqual(['Short one?'])
+    expect(parseFollowups('x'.repeat(200))).toEqual(['x'.repeat(200)])
+    expect(parseFollowups('x'.repeat(201))).toEqual([])
+  })
+
+  it('reads the example the system prompt shows the model', () => {
+    // presentation.host.spec.ts asserts the prompt carries exactly this fence body.
+    const example = 'How do the two options compare on cost?\nWhat should I set up first?'
+    expect(parseFollowups(example)).toEqual(['How do the two options compare on cost?', 'What should I set up first?'])
+  })
+})
diff --git a/packages/client/ui-intelligent-ui/tests/presentation.host.spec.ts b/packages/client/ui-intelligent-ui/tests/presentation.host.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..436b70cd91f9d23e5a7e1df3cd51a8a937319d08
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/tests/presentation.host.spec.ts
@@ -0,0 +1,47 @@
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt, { renderPrompt } from '@deepseek-ai/dsh-system-prompt'
+import { createScope, type ScopeKey } from '@deepseek-ai/dsh-scope'
+import * as Persona from '@deepseek-ai/dsh-persona'
+import { describe, expect, it } from 'vitest'
+import * as IntelligentUI from '../src/index.ts'
+
+async function harness(enabled: boolean) {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt, { personaPrefix: 'Deployment identity.', personaSuffix: 'Global suffix.' })
+  const fiber = await ctx.plugin(IntelligentUI, { enabled })
+  const key: ScopeKey = { agent: 'visual-test' }
+  const scope = createScope(ctx, key)
+  await scope.ctx.plugin(Persona, { prefix: 'Scoped identity.', suffix: '' })
+  return { ctx, fiber, scope, key }
+}
+
+describe('additive Web presentation guidance', () => {
+  it('survives an empty scoped persona suffix without changing persona identity', async () => {
+    const { ctx, key, fiber } = await harness(true)
+    const assembly = await ctx.systemPrompt.assemble({ scope: key })
+    const text = renderPrompt(assembly)
+    expect(text).toContain('Scoped identity.')
+    expect(text).not.toContain('Global suffix.')
+    expect(text).toContain('Response presentation in this DSH web interface:')
+    expect(text).toContain('fenced code block whose language is openui and whose body is a self-contained HTML fragment')
+    expect(text).toContain('do not create files, build scripts, previews, screenshots, or tests')
+    expect(text).toContain('[1]: https://example.com/actual-page')
+    expect(text).toContain('write their numbers side by side, as in [1][3]')
+    expect(text).toContain('fenced code block whose language is followups')
+    expect(text).toContain("two or three short questions the reader may want to ask next, one per line, in the user's language")
+    expect(text).toContain('Skip it for short replies, simple facts, code or writing deliverables, and when the user wants text only')
+    expect(text).toContain('Place the block last in the answer, after any reference definitions')
+    expect(text).toContain('```followups\nHow do the two options compare on cost?\nWhat should I set up first?\n```')
+    expect(assembly.sections.find(section => section.name === 'deployment:response-presentation')?.interpolate).toBe(false)
+    await fiber.dispose()
+    expect(renderPrompt(await ctx.systemPrompt.assemble({ scope: key }))).not.toContain('Response presentation')
+    await ctx.fiber.dispose()
+  })
+  it('can disable the guidance without changing the original prompt', async () => {
+    const { ctx, key } = await harness(false)
+    const text = renderPrompt(await ctx.systemPrompt.assemble({ scope: key }))
+    expect(text).toContain('Scoped identity.')
+    expect(text).not.toContain('Response presentation')
+    await ctx.fiber.dispose()
+  })
+})
diff --git a/packages/client/ui-intelligent-ui/tests/sandbox.client.spec.ts b/packages/client/ui-intelligent-ui/tests/sandbox.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0edd3cf1424329d85c4156093e1d9130e5c183a7
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/tests/sandbox.client.spec.ts
@@ -0,0 +1,123 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mountVisualization, outerDocument } from '../src/client/sandbox.ts'
+import { FRAME_CSP, FRAME_EVENT_TYPE } from '../src/client/frame-content.ts'
+
+const content = { version: 1 as const, title: 'Sandbox', fallback: 'Text stays visible', html: '<p>Chart</p>' }
+afterEach(() => { vi.useRealTimers(); document.body.replaceChildren() })
+
+function mount() {
+  const container = document.createElement('div')
+  document.body.appendChild(container)
+  const callbacks = { ready: vi.fn(), failed: vi.fn(), scriptError: vi.fn(), resized: vi.fn(), openLink: vi.fn() }
+  const dispose = mountVisualization(container, content, callbacks, { scheme: 'dark' })
+  const frame = container.querySelector('iframe')!
+  const token = /const token="([^"]+)"/.exec(frame.srcdoc)![1]
+  const send = (data: object, source: MessageEventSource | null = frame.contentWindow) => {
+    window.dispatchEvent(new MessageEvent('message', { source, data: { type: FRAME_EVENT_TYPE, token, ...data } }))
+  }
+  return { container, callbacks, dispose, frame, send }
+}
+
+describe('native nested frame lifecycle', () => {
+  it('paints the frame canvas in the light scheme when no palette is given', () => {
+    const container = document.createElement('div')
+    document.body.appendChild(container)
+    const callbacks = { ready: vi.fn(), failed: vi.fn(), scriptError: vi.fn(), resized: vi.fn(), openLink: vi.fn() }
+    const dispose = mountVisualization(container, content, callbacks)
+    expect(container.querySelector('iframe')!.style.colorScheme).toBe('light')
+    dispose()
+  })
+  it('uses policy-first documents with script-only sandbox and no host API', () => {
+    const { frame, dispose } = mount()
+    expect(frame.getAttribute('sandbox')).toBe('allow-scripts')
+    expect(frame.getAttribute('allow')).toContain("camera 'none'")
+    expect(frame.referrerPolicy).toBe('no-referrer')
+    expect(frame.style.colorScheme).toBe('dark')
+    const doc = outerDocument({ ...content, html: '</script><script>parent.evil=1</script>' }, 'token')
+    expect(doc.indexOf(FRAME_CSP)).toBeLessThan(doc.indexOf('<script>'))
+    expect(doc).toContain("inner.setAttribute('sandbox','allow-scripts')")
+    expect(doc).toContain('event.source!==inner.contentWindow')
+    expect(doc).not.toContain('parent.evil=1</script>')
+    expect(doc).not.toContain('Websandbox')
+    dispose()
+  })
+  it('ignores forged windows, invalid tokens, non-finite heights and unknown messages', () => {
+    const one = mount()
+    const two = mount()
+    one.send({ state: 'resize', height: 900 }, two.frame.contentWindow)
+    one.send({ state: 'resize', height: 900, token: 'forged' })
+    one.send({ state: 'resize', height: Infinity })
+    one.send({ state: 'resize', height: '800' })
+    one.send({ state: 'run', code: 'parent.evil=1' })
+    expect(one.callbacks.resized).not.toHaveBeenCalled()
+    one.send({ state: 'resize', height: 5000 })
+    expect(one.callbacks.resized).toHaveBeenCalledWith(2400)
+    one.send({ state: 'ready' })
+    expect(one.callbacks.ready).toHaveBeenCalledOnce()
+    expect(two.callbacks.ready).not.toHaveBeenCalled()
+    one.dispose(); two.dispose()
+  })
+  it('reports script errors once and keeps the rendered frame', () => {
+    const view = mount()
+    view.send({ state: 'error' })
+    view.send({ state: 'error' })
+    view.send({ state: 'ready' })
+    expect(view.callbacks.scriptError).toHaveBeenCalledOnce()
+    expect(view.callbacks.failed).not.toHaveBeenCalled()
+    expect(view.callbacks.ready).toHaveBeenCalledOnce()
+    expect(view.container.childElementCount).toBe(1)
+    view.dispose()
+  })
+  it('removes the frames once after navigation away and ignores later messages', () => {
+    const view = mount()
+    view.send({ state: 'failed' })
+    view.send({ state: 'failed' })
+    view.send({ state: 'ready' })
+    expect(view.callbacks.failed).toHaveBeenCalledOnce()
+    expect(view.callbacks.ready).not.toHaveBeenCalled()
+    expect(view.container.childElementCount).toBe(0)
+    view.dispose()
+  })
+  it('relays only HTTPS link clicks to the page', () => {
+    const view = mount()
+    view.send({ state: 'open', href: 'javascript:alert(1)' })
+    view.send({ state: 'open', href: 'data:text/html,hi' })
+    view.send({ state: 'open', href: 'not a url' })
+    view.send({ state: 'open', href: 'http://example.com/insecure' })
+    view.send({ state: 'open', href: 'HTTP://example.com/insecure' })
+    view.send({ state: 'open', href: 'https://example.com/' + 'a'.repeat(2100) })
+    view.send({ state: 'open', href: 42 })
+    // A user part makes the address read as another site.
+    view.send({ state: 'open', href: 'https://docs.python.org@evil.example/' })
+    view.send({ state: 'open', href: 'https://user:secret@example.com/' })
+    expect(view.callbacks.openLink).not.toHaveBeenCalled()
+    view.send({ state: 'open', href: 'https://example.com/docs?q=1' })
+    expect(view.callbacks.openLink).toHaveBeenCalledExactlyOnceWith('https://example.com/docs?q=1')
+    const policy = outerDocument(content, 'token')
+    expect(policy).toContain("data.state==='open'")
+    expect(policy).toContain("!/^https:/i.test(data.href)")
+    expect(policy).not.toContain("!/^https?:/i.test(data.href)")
+    view.dispose()
+  })
+  it('keeps dollar sequences in authored code literal', () => {
+    const doc = outerDocument({ ...content, html: '<p id="x"></p>', jsExpressions: ["const $$ = s => [...document.querySelectorAll(s)]; const a = '$' + '$&';"] }, 'token')
+    expect(doc).toContain('const $$ = s =>')
+    expect(doc).toContain("'$' + '$&'")
+  })
+  it('cleans the message listener and timeout on unload, including before readiness', () => {
+    vi.useFakeTimers()
+    const view = mount()
+    view.dispose()
+    view.send({ state: 'ready' })
+    vi.advanceTimersByTime(30_000)
+    expect(view.container.childElementCount).toBe(0)
+    expect(view.callbacks.ready).not.toHaveBeenCalled()
+    expect(view.callbacks.failed).not.toHaveBeenCalled()
+    const stalled = mount()
+    vi.advanceTimersByTime(15_000)
+    expect(stalled.callbacks.failed).toHaveBeenCalledOnce()
+    expect(stalled.container.childElementCount).toBe(0)
+    stalled.dispose()
+  })
+})
diff --git a/packages/client/ui-intelligent-ui/tests/schema.client.spec.ts b/packages/client/ui-intelligent-ui/tests/schema.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fafacc6a0d521c1824770c604a0bd835f681d17a
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/tests/schema.client.spec.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from 'vitest'
+import { CONTENT_LIMIT, MAX_FRAGMENTS, parseContent, partialTitle, reportedHeight } from '../src/client/schema.ts'
+import { FRAME_CSP, frameDocument, frameProgram } from '../src/client/frame-content.ts'
+
+const valid = { version: 1, title: 'Timeline', fallback: 'Three stages', html: '<button>Next</button>' }
+const parse = (source: string) => parseContent(source, 'Untitled')
+
+describe('completed visualization JSON', () => {
+  it('accepts standalone and fragment fields without AG-UI streaming flags', () => {
+    expect(parse(JSON.stringify(valid))).toEqual({ ok: true, format: 'json', content: valid })
+    expect(parse(JSON.stringify({ ...valid, html: ['<p>', 'Text</p>'], jsFunctions: 'function next(){}', jsExpressions: ['next()'], initialHeight: 320 }))).toMatchObject({ ok: true, format: 'json' })
+  })
+  it.each([
+    'null', '[]', '{', JSON.stringify({ ...valid, version: 2 }),
+    JSON.stringify({ ...valid, title: '' }), JSON.stringify({ ...valid, fallback: ' ' }),
+    JSON.stringify({ ...valid, html: [] }), JSON.stringify({ ...valid, html: [''] }),
+    JSON.stringify({ ...valid, html: 12 }), JSON.stringify({ ...valid, css: null }), JSON.stringify({ ...valid, initialHeight: 10 }),
+    JSON.stringify({ ...valid, initialHeight: 2401 }), JSON.stringify({ ...valid, css: 1 }),
+    JSON.stringify({ ...valid, hostAPI: 'file' }), JSON.stringify({ ...valid, generating: false }),
+    JSON.stringify({ version: 1, title: 'No fallback', html: '<p>Chart</p>' }),
+  ])('rejects malformed or unsupported input %s', (source) => {
+    expect(parse(source)).toEqual({ ok: false, reason: 'invalid' })
+  })
+  it('bounds total text and fragment counts', () => {
+    expect(parse(' '.repeat(CONTENT_LIMIT + 1))).toEqual({ ok: false, reason: 'tooLarge' })
+    expect(parse(JSON.stringify({ ...valid, html: Array(129).fill('a') }))).toEqual({ ok: false, reason: 'invalid' })
+  })
+  it('ignores non-finite measurements and clamps frame size', () => {
+    for (const value of [null, undefined, '300', NaN, Infinity, {}, []]) expect(reportedHeight(value)).toBeUndefined()
+    expect(reportedHeight(-200)).toBe(24)
+    expect(reportedHeight(200.2)).toBe(201)
+    expect(reportedHeight(1e9)).toBe(2400)
+  })
+})
+
+describe('completed visualization HTML fragments', () => {
+  it('separates the title and inline scripts from markup, keeping script order and text', () => {
+    const source = '<title>Hourly <b>temperature</b></title>\n<style>.bar{fill:var(--accent)}</style>\n<svg id="chart"></svg>\n<script>const $$ = s => [...document.querySelectorAll(s)]; const price = \'$\' + 1;</script>\n<script type="text/javascript">draw()</script>'
+    const result = parse(source)
+    expect(result).toEqual({
+      ok: true,
+      format: 'html',
+      content: {
+        version: 1,
+        title: 'Hourly temperature',
+        html: '\n<style>.bar{fill:var(--accent)}</style>\n<svg id="chart"></svg>\n\n',
+        jsExpressions: ['const $$ = s => [...document.querySelectorAll(s)]; const price = \'$\' + 1;', 'draw()'],
+      },
+    })
+  })
+  it('uses the supplied title without a title element and drops empty scripts', () => {
+    expect(parse('<div id="app"></div><script src="https://example.invalid/x.js"></script>')).toEqual({
+      ok: true, format: 'html', content: { version: 1, title: 'Untitled', html: '<div id="app"></div>', jsExpressions: [] },
+    })
+  })
+  it('rejects empty fragments and too many scripts', () => {
+    expect(parse('  <title>Only a title</title>  ')).toEqual({ ok: false, reason: 'invalid' })
+    expect(parse('<p>x</p>' + '<script>1</script>'.repeat(MAX_FRAGMENTS + 1))).toEqual({ ok: false, reason: 'tooLarge' })
+  })
+  it('reads the title written so far in either notation', () => {
+    expect(partialTitle('<title>Rain chance</title><svg')).toBe('Rain chance')
+    expect(partialTitle('<title>Rain ch')).toBeUndefined()
+    expect(partialTitle('{"version":1,"title":"Say \\"hi\\"","html')).toBe('Say "hi"')
+    expect(partialTitle('{"version":1,"tit')).toBeUndefined()
+  })
+})
+
+describe('sandbox document construction', () => {
+  it('places fixed policy before any bridge or model data', () => {
+    const doc = frameDocument()
+    expect(doc.indexOf('Content-Security-Policy')).toBeLessThan(doc.indexOf('<meta charset'))
+    expect(doc).toContain(FRAME_CSP)
+    expect(FRAME_CSP).toContain("connect-src 'none'")
+    expect(FRAME_CSP).not.toContain('unsafe-eval')
+  })
+  it('keeps hostile closing tags inside string data', () => {
+    const program = frameProgram({ ...valid, version: 1, html: '</script><meta http-equiv="refresh" content="0;url=https://evil.invalid">', css: '</style><script>parent.x=1</script>', jsFunctions: '</script><script>parent.x=1</script>' }, 'instance')
+    expect(program).not.toContain('</script>')
+    expect(program).not.toContain('</style>')
+    expect(program).toContain('\\u003c/script>')
+    expect(program).toContain('meta,base,script,link,iframe,object,embed')
+  })
+  it('offers theme-aware color variables to authored styles', () => {
+    const program = frameProgram({ ...valid, version: 1 }, 'instance', 'dark')
+    for (const name of ['--fg', '--bg', '--muted', '--line', '--accent']) expect(program).toContain(`${name}:`)
+    expect(program).toContain('color-scheme:dark')
+  })
+})
