+++ b/apps/web/tests/beautiful-ui-surfaces.e2e.ts
@@ -0,0 +1,308 @@
+/** Keyless browser regression over the real assembled Beautiful UI surfaces. */
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { chromium, type Browser, type Page, type Locator } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it, onTestFailed } from 'vitest'
+import { ToolCallId, createAssistantMessage, createToolResultMessage, createUserMessage, type StreamChunk } from '@deepseek-ai/dsh-llm'
+import { Session, SessionId, SESSION_FORMAT_VERSION } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-tool-todo/client'
+import { launchWebScaffold, seedSession, watchConsole, webSnapshotMode, type WebScaffold } from './scaffold.ts'
+import { expandTurnProcesses, newEnglishPage, saveFailureShot, REPO_ROOT } from './support.ts'
+
+const SCREENSHOTS = join(REPO_ROOT, '.artifacts/screenshots/beautiful-ui')
+const SOURCE = `const message = "测试示例：${'中文长行'.repeat(90)}";`
+const STREAM_TEXT = '正在验证中文逐步显示。标点、汉字和最终内容应当保持完整。'
+
+/** Same durable event protocol as code-card-layout; the content is explicitly a test sample. */
+function sampleHistory(): string {
+  const session = Session.create(SessionId('beautiful-ui-sample-source'))
+  session.append('turn/start', { turn: 1 })
+  session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text: '测试示例：代码、任务和工具详情。' }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  session.append('step/start', { turn: 1, step: 1 })
+  const callId = ToolCallId('beautiful-ui-sample-tool')
+  const args = JSON.stringify({ code: 'console.log("测试示例")', description: '测试工具详情' })
+  session.append('assistant/message', {
+    turn: 1, step: 1, stream: [], message: createAssistantMessage({
+      content: [{ type: 'reasoning', text: '测试示例：思考内容默认折叠。' }, { type: 'tool-call', id: callId, name: 'run_code', arguments: args }],
+      source: { provider: 'fixture', model: 'fixture' },
+    }),
+  }, { surfaceOp: 'append' })
+  const call = session.append('tool/call', { turn: 1, step: 1, callId, name: 'run_code', arguments: args })
+  session.append('tool/result', { turn: 1, step: 1, message: createToolResultMessage({
+    callId, content: [{ type: 'text', text: 'BEAUTIFUL_TOOL_DETAIL_SAMPLE' }], isError: false,
+  }) }, { surfaceOp: 'append', sourceEventSeqs: [call.seq] })
+  session.append('todo/write', { todos: [
+    { content: '测试示例：已完成步骤', status: 'completed' },
+    { content: '测试示例：进行中步骤', status: 'in_progress' },
+    { content: '测试示例：待处理步骤', status: 'pending' },
+  ] })
+  session.append('step/end', { turn: 1, step: 1 })
+  session.append('step/start', { turn: 1, step: 2 })
+  session.append('assistant/message', {
+    turn: 1, step: 2, stream: [], message: createAssistantMessage({
+      content: [{ type: 'text', text: `BEAUTIFUL_SAMPLE_READY\n\n\`\`\`typescript\n${SOURCE}\n\`\`\`` }],
+      source: { provider: 'fixture', model: 'fixture' },
+    }),
+  }, { surfaceOp: 'append' })
+  session.append('step/end', { turn: 1, step: 2 })
+  session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  return [JSON.stringify({ type: 'session', version: SESSION_FORMAT_VERSION, id: '{{sessionId}}', createdAt: 0,
+    cwd: '{{cwd}}', isSeeded: false, delegationDepth: 0 }), ...session.snapshotEvents().map(event => JSON.stringify(event)), ''].join('\n')
+}
+
+function streamedReply(): StreamChunk[] {
+  return [
+    { type: 'block-start', index: 0, blockType: 'text' },
+    ...Array.from(STREAM_TEXT).map(text => ({ type: 'text-delta' as const, index: 0, text })),
+    { type: 'block-end', index: 0, block: { type: 'text', text: STREAM_TEXT } },
+    { type: 'usage', usage: { inputTokens: 512, outputTokens: 32 } },
+    { type: 'finish', reason: { kind: 'stop' } },
+  ]
+}
+
+async function controlPaint(control: Locator) {
+  return control.evaluate((element) => {
+    const style = getComputedStyle(element)
+    return { border: style.borderTopWidth, borderStyle: style.borderTopStyle, background: style.backgroundColor,
+      outlineStyle: style.outlineStyle, outlineWidth: style.outlineWidth, shadow: style.boxShadow }
+  })
+}
+
+async function nextFrames(page: Page): Promise<void> {
+  await page.evaluate(() => new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => { resolve() }))))
+}
+
+describe('web e2e: Beautiful UI assembled surfaces', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let replayDir: string
+  let releaseModel: () => void = () => undefined
+  let disposeHold: () => void = () => undefined
+  let tripwire: ReturnType<typeof watchConsole>
+
+  beforeAll(async () => {
+    if (webSnapshotMode() === 'record') throw new Error('Beautiful UI regression permits keyless replay only')
+    replayDir = await mkdtemp(join(tmpdir(), 'dsh-beautiful-ui-'))
+    const override = join(replayDir, 'replay.override.json')
+    await writeFile(override, JSON.stringify([{ kind: 'chunks', chunks: streamedReply() }]))
+    scaffold = await launchWebScaffold({ replayFixture: join(replayDir, 'override-only.jsonl'), replayOverride: override,
+      replayContextWindow: 10_000_000, paceMs: 90 })
+    await seedSession(scaffold, sampleHistory(), 'beautiful-ui-sample')
+    const gate = Promise.withResolvers<undefined>()
+    releaseModel = () => { gate.resolve(undefined) }
+    disposeHold = scaffold.ctx.on('llm/stream', async function* (_options, next) {
+      await gate.promise
+      for await (const chunk of next()) yield chunk
+    })
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser, 1000)
+    await page.context().grantPermissions(['clipboard-read', 'clipboard-write'])
+    await page.emulateMedia({ reducedMotion: 'no-preference' })
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+    await page.locator('[role="treeitem"]').first().click()
+    await page.locator('[role="treeitem"]').nth(1).click()
+    await page.getByText('BEAUTIFUL_SAMPLE_READY', { exact: true }).waitFor()
+  })
+
+  afterAll(async () => {
+    releaseModel()
+    disposeHold()
+    try { await browser?.close() } finally {
+      try { await scaffold?.close() } finally {
+        if (replayDir !== undefined) await rm(replayDir, { recursive: true, force: true })
+      }
+    }
+  })
+
+  it('keeps pointer focus quiet and opens both plain composer selectors', async () => {
+    onTestFailed(() => saveFailureShot(page, 'beautiful-ui-composer'))
+    const input = page.locator('[data-composer-input][contenteditable="true"]').last()
+    await input.click()
+    const focused = await input.evaluate((element) => {
+      const card = element.closest('[data-composer-card]')
+      if (card === null) throw new Error('composer has no card')
+      return [element, card].map((node) => {
+        const css = getComputedStyle(node)
+        return { outline: css.outlineStyle, width: css.outlineWidth, shadow: css.boxShadow }
+      })
+    })
+    for (const paint of focused) {
+      expect(paint.outline === 'none' || paint.width === '0px').toBe(true)
+      expect(paint.shadow).not.toMatch(/rgb\(65, 118, 230\)|rgb\(122, 170, 255\)/)
+    }
+    const composer = await page.locator('[data-composer-card]').evaluate((element) => {
+      const card = getComputedStyle(element)
+      const material = getComputedStyle(element, '::before')
+      const seat = element.closest('[data-composer-seat]')
+      if (seat === null) throw new Error('composer has no seat')
+      return { filter: card.backdropFilter, border: card.borderTopWidth, background: card.backgroundColor,
+        materialFilter: material.backdropFilter, materialFill: material.backgroundColor,
+        seatBackground: getComputedStyle(seat).backgroundImage, shadow: card.boxShadow }
+    })
+    expect(composer.filter).toBe('none')
+    expect(composer.background).toBe('rgba(0, 0, 0, 0)')
+    expect(composer.border).toBe('0px')
+    expect(composer.shadow).toContain('0.5px')
+    expect(composer.materialFilter).toContain('blur(24px)')
+    expect(composer.materialFill).toMatch(/0\.68\)/)
+    expect(composer.seatBackground).toBe('none')
+    await page.mouse.move(1, 1)
+    for (const control of [page.getByRole('button', { name: /^Select model/ }), page.getByRole('button', { name: /^Access mode, current:/ })]) {
+      const paint = await controlPaint(control)
+      expect(paint.border === '0px' || paint.borderStyle === 'none').toBe(true)
+      expect(paint.background).toBe('rgba(0, 0, 0, 0)')
+      await control.click()
+      const modelPicker = (await control.getAttribute('aria-label'))?.startsWith('Select model') === true
+      const popup = modelPicker ? page.getByRole('dialog', { name: 'Model and reasoning effort', exact: true }) : page.getByRole('menu')
+      await popup.waitFor({ state: 'visible' })
+      if (modelPicker) {
+        const material = await popup.evaluate((element) => {
+          const layer = element.querySelector('[class*="material"]')
+          if (layer === null) throw new Error('model menu has no glass material')
+          return { fill: getComputedStyle(element).animationFillMode, filter: getComputedStyle(layer).backdropFilter }
+        })
+        expect(material.fill).toBe('none')
+        expect(material.filter).toContain('blur(40px)')
+      }
+      await page.keyboard.press('Escape')
+      await popup.waitFor({ state: 'hidden' })
+    }
+    await page.getByRole('button', { name: 'Add files or run commands', exact: true }).click()
+    const triggerMenu = page.locator('[data-trigger-menu]')
+    await triggerMenu.waitFor({ state: 'visible' })
+    const triggerMaterial = await triggerMenu.evaluate((element) => {
+      const layer = element.querySelector('[class*="material"]')
+      if (layer === null) throw new Error('trigger menu has no glass material')
+      return { fill: getComputedStyle(element).animationFillMode, filter: getComputedStyle(layer).backdropFilter }
+    })
+    expect(triggerMaterial.fill).toBe('none')
+    expect(triggerMaterial.filter).toContain('blur(40px)')
+    await page.keyboard.press('Escape')
+    await triggerMenu.waitFor({ state: 'hidden' })
+  })
+
+  it('preserves real todo states, copies complete long source, and opens tool details', async () => {
+    onTestFailed(() => saveFailureShot(page, 'beautiful-ui-code-tasks-tools'))
+    const todo = page.getByTestId('todo-panel')
+    expect(await todo.evaluate(element => getComputedStyle(element).borderTopLeftRadius)).toBe('10px')
+    const items = todo.getByRole('listitem')
+    expect(await items.evaluateAll(nodes => nodes.map(node => node.getAttribute('data-status'))))
+      .toEqual(['completed', 'in_progress', 'pending'])
+    expect(await items.nth(0).textContent()).toContain('Completed')
