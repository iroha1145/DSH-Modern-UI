index 0000000000000000000000000000000000000000..8a022a14ee3e019a0a9db5ad8d9975f719d66ca4
--- /dev/null
+++ b/packages/client/ui-primitives/tests/code-block-disclosure.client.spec.tsx
@@ -0,0 +1,106 @@
+// @vitest-environment jsdom
+/** Code-body disclosure must preserve the source and its streaming instance. */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { CodeBlock } from '../src/markdown/CodeBlock.tsx'
+import { MarkdownText } from '../src/markdown/MarkdownText.tsx'
+import { writeClipboard } from '../src/clipboard.ts'
+
+vi.mock('../src/clipboard.ts', () => ({ writeClipboard: vi.fn(async () => true) }))
+
+const toolbarLabels = {
+  codeLabel: 'Code', wrapLabel: 'Wrap lines', unwrapLabel: 'Do not wrap lines',
+  collapseLabel: 'Collapse code', expandLabel: 'Expand code',
+}
+const labels = { copyLabel: 'Copy', copiedLabel: 'Copied', toolbarLabels }
+
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+})
+
+describe('code-body disclosure', () => {
+  it('starts expanded, controls its own stable content, and retains the mounted tree while hidden', () => {
+    const contentRef = { current: null as HTMLDivElement | null }
+    const view = render(<CodeBlock code="complete source" contentRef={contentRef} {...labels} />)
+    const content = contentRef.current!
+    const pre = content.querySelector('pre')
+    const collapse = screen.getByRole('button', { name: 'Collapse code', expanded: true })
+    expect(collapse.getAttribute('aria-controls')).toBe(content.id)
+    expect(content.hidden).toBe(false)
+    fireEvent.click(collapse)
+    expect(screen.getByRole('button', { name: 'Expand code', expanded: false })).toBe(collapse)
+    expect(content.hidden).toBe(true)
+    expect(content.querySelector('pre')).toBe(pre)
+    expect(screen.getByRole('button', { name: 'Copy' })).toBeTruthy()
+    fireEvent.click(collapse)
+    expect(content.hidden).toBe(false)
+    expect(content.querySelector('pre')).toBe(pre)
+    view.unmount()
+    expect(contentRef.current).toBeNull()
+  })
+
+  it('keeps collapsed streaming source current, copies it in full, and preserves the choice when settled', async () => {
+    const source = 'const first = 1;\n'
+    const final = `${source}const second = 2;`
+    const view = render(<CodeBlock code={source} lang="javascript" streaming {...labels} />)
+    await waitFor(() => { expect(view.container.querySelector('pre.shiki')).not.toBeNull() })
+    const pre = view.container.querySelector('pre')!
+    const firstLine = pre.querySelector('.line')
+    const id = screen.getByRole('button', { name: 'Collapse code' }).getAttribute('aria-controls')!
+    fireEvent.click(screen.getByRole('button', { name: 'Collapse code' }))
+    view.rerender(<CodeBlock code={final} lang="javascript" streaming {...labels} />)
+    const panel = document.getElementById(id)!
+    expect(panel.hidden).toBe(true)
+    expect(panel.textContent).toBe(final)
+    expect(panel.querySelector('pre')).toBe(pre)
+    expect(panel.querySelector('.line')).toBe(firstLine)
+    await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Copy' })) })
+    expect(writeClipboard).toHaveBeenCalledExactlyOnceWith(final)
+    view.rerender(<CodeBlock code={final} lang="javascript" streaming={false} {...labels} />)
+    expect(panel.hidden).toBe(true)
+    expect(screen.getByRole('button', { name: 'Expand code' }).getAttribute('aria-controls')).toBe(id)
+    fireEvent.click(screen.getByRole('button', { name: 'Expand code' }))
+    expect(panel.hidden).toBe(false)
+    expect(panel.querySelector('pre')).toBe(pre)
+    expect(panel.textContent).toBe(final)
+  })
+
+  it('retains the user choice when the real Markdown fence grows, closes, and settles', () => {
+    const markdownLabels = { code: labels, footnotes: 'Notes' }
+    const prefix = '前文\n\n```javascript\nconst first = 1;\n'
+    const view = render(<MarkdownText text={prefix} streaming labels={markdownLabels} />)
+    const toggle = screen.getByRole('button', { name: 'Collapse code' })
+    const contentId = toggle.getAttribute('aria-controls')!
+    fireEvent.click(toggle)
+    const grown = `${prefix}const second = 2;\n`
+    view.rerender(<MarkdownText text={grown} streaming labels={markdownLabels} />)
+    expect(document.getElementById(contentId)!.hidden).toBe(true)
+    view.rerender(<MarkdownText text={`${grown}\`\`\`\n`} streaming labels={markdownLabels} />)
+    expect(document.getElementById(contentId)!.hidden).toBe(true)
+    view.rerender(<MarkdownText text={`${grown}\`\`\`\n`} streaming={false} labels={markdownLabels} />)
+    expect(screen.getByRole('button', { name: 'Expand code' }).getAttribute('aria-controls')).toBe(contentId)
+    expect(document.getElementById(contentId)!.hidden).toBe(true)
+    expect(document.getElementById(contentId)!.textContent).toBe('const first = 1;\nconst second = 2;')
+  })
+
+  it('assigns separate accessible targets to separate code blocks', () => {
+    render(<><CodeBlock code="first" {...labels} /><CodeBlock code="second" {...labels} /></>)
+    const buttons = screen.getAllByRole('button', { name: 'Collapse code' })
+    const targets = buttons.map(button => button.getAttribute('aria-controls'))
+    expect(new Set(targets).size).toBe(2)
+    fireEvent.click(buttons[0]!)
+    expect(document.getElementById(targets[0]!)!.hidden).toBe(true)
+    expect(document.getElementById(targets[1]!)!.hidden).toBe(false)
+  })
+
+  it('does not offer disclosure without both localized actions or a visible header', () => {
+    const view = render(<CodeBlock code="visible source" copyLabel="Copy" copiedLabel="Copied"
+      toolbarLabels={{ codeLabel: 'Code', wrapLabel: 'Wrap', unwrapLabel: 'Unwrap', collapseLabel: 'Collapse code' }} />)
+    expect(screen.queryByRole('button', { name: 'Collapse code' })).toBeNull()
+    expect(view.container.querySelector('[data-code-block-content]')!.hasAttribute('hidden')).toBe(false)
+    view.rerender(<CodeBlock code="visible source" showHeader={false} {...labels} />)
+    expect(screen.queryByRole('button')).toBeNull()
+    expect(view.container.querySelector('[data-code-block-content]')!.hasAttribute('hidden')).toBe(false)
+  })
+})
