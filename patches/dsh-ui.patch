+/** Real-browser hit testing of the shipped visualization actions and model-effort styles. */
+import { readFile } from 'node:fs/promises'
+import { chromium, type Browser } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+
+const styleFile = (name: string, file: string) => new URL(`../../../packages/client/${name}/src/client/${file}`, import.meta.url)
+
+describe('web e2e: audit action accessibility', () => {
+  let browser: Browser
+  beforeAll(async () => {
+    const executablePath = process.env.DSH_PLAYWRIGHT_EXECUTABLE_PATH
+    browser = await chromium.launch(executablePath === undefined ? {} : { executablePath })
+  })
+  afterAll(async () => { await browser?.close() })
+
+  it('keeps source actions hittable on touch and reveals them through desktop hover or keyboard focus', async () => {
+    const css = await readFile(styleFile('ui-intelligent-ui', 'IntelligentUI.module.css'), 'utf8')
+    for (const touch of [true, false]) {
+      const context = await browser.newContext({ viewport: { width: 375, height: 700 }, hasTouch: touch, isMobile: touch })
+      try {
+        const page = await context.newPage()
+        await page.setContent('<style>:root{--dsw-focus-ring-width:2px}</style><div class="visual"><div class="stage" style="height:200px"><div class="frame"></div><div class="actions"><button>View source</button></div></div><div class="status"><button>Error source</button></div></div>')
+        await page.addStyleTag({ content: css })
+        await page.evaluate(() => {
+          for (const button of document.querySelectorAll('button')) button.addEventListener('click', () => { button.dataset.clicked = 'true' })
+        })
+        const action = page.getByRole('button', { name: 'View source', exact: true })
+        expect(await page.evaluate(() => matchMedia('(hover: none)').matches)).toBe(touch)
+        if (!touch) {
+          await expect.poll(() => action.evaluate(button => getComputedStyle(button.parentElement!).opacity)).toBe('0')
+          await page.keyboard.press('Tab')
+          expect(await action.evaluate(button => document.activeElement === button)).toBe(true)
+          await page.keyboard.press('Enter')
+          expect(await action.getAttribute('data-clicked')).toBe('true')
+          await page.keyboard.press('Tab')
+          await page.locator('.stage').hover()
+        }
+        await expect.poll(() => action.evaluate(button => getComputedStyle(button.parentElement!).opacity)).toBe('1')
+        if (touch) await action.tap()
+        else await action.click()
+        expect(await action.getAttribute('data-clicked')).toBe('true')
+        await page.getByRole('button', { name: 'Error source' }).click()
+        expect(await page.getByRole('button', { name: 'Error source' }).getAttribute('data-clicked')).toBe('true')
+      } finally { await context.close() }
+    }
+  })
+
+  it('keeps all six effort choices visible, hittable, and focusable at narrow widths and with larger long labels', async () => {
+    const css = await readFile(styleFile('ui-model-selection', 'ModelSelect.module.css'), 'utf8')
+    for (const width of [320, 360, 375]) {
+      for (const larger of [false, true]) {
+        const page = await browser.newPage({ viewport: { width, height: 900 } })
+        try {
+          const labels = larger
+            ? ['Minimum reasoning effort', 'Low reasoning effort', 'Medium reasoning effort', 'High reasoning effort', 'Extra high reasoning effort', 'Maximum reasoning effort']
+            : ['Min', 'Low', 'Med', 'High', 'XHigh', 'Max']
+          await page.setContent(`<div class="menu" style="left:12px;top:12px"><div class="settings"><div class="fold" data-open><div class="clip"><div class="effort"><span class="effortLabel">Reasoning effort</span><div class="pills" role="radiogroup">${labels.map((label, index) => `<button class="pill" role="radio" aria-checked="false" data-choice="${index}">${label}</button>`).join('')}</div></div></div></div></div></div>`)
+          await page.addStyleTag({ content: css + '\n:root{--dsw-focus-ring-width:2px;--dsw-focus-ring-color:blue}.menu{opacity:1;max-height:850px}.fold{transition:none}.pill{font-size:' + (larger ? '18px' : '12px') + '}' })
+          await page.evaluate(() => {
+            for (const button of document.querySelectorAll('button')) button.addEventListener('click', () => { button.setAttribute('aria-checked', 'true') })
+          })
+          const choices = page.getByRole('radio')
+          expect(await choices.count()).toBe(6)
+          for (let index = 0; index < 6; index += 1) {
+            const choice = choices.nth(index)
+            const geometry = await choice.evaluate((button) => {
+              const rect = button.getBoundingClientRect()
+              const clip = button.closest('.clip')!.getBoundingClientRect()
+              const center = document.elementFromPoint(rect.x + rect.width / 2, rect.y + rect.height / 2)
+              return {
+                left: rect.left, right: rect.right, top: rect.top, bottom: rect.bottom,
+                clipLeft: clip.left, clipRight: clip.right, clipTop: clip.top, clipBottom: clip.bottom,
+                hittable: center === button,
+              }
+            })
+            expect(geometry.left).toBeGreaterThanOrEqual(geometry.clipLeft + 3)
+            expect(geometry.right).toBeLessThanOrEqual(geometry.clipRight - 3)
+            expect(geometry.top).toBeGreaterThanOrEqual(geometry.clipTop + 3)
+            expect(geometry.bottom).toBeLessThanOrEqual(geometry.clipBottom - 3)
+            expect(geometry.hittable).toBe(true)
+            await choice.click()
+            expect(await choice.getAttribute('aria-checked')).toBe('true')
+            await choice.focus()
+            expect(await choice.evaluate(button => document.activeElement === button)).toBe(true)
+          }
+        } finally { await page.close() }
+      }
+    }
+  })
+})
