 import { Switch } from '@deepseek-ai/dsh-client-ui-primitives'
 
 afterEach(cleanup)
@@ -52,3 +52,120 @@ describe('Switch', () => {
     expect(control.classList.length).toBeGreaterThan(1)
   })
 })
+
+
+describe('Switch Feel spring', () => {
+  let now = 0
+  let nextFrame = 0
+  let reduced = false
+  const frames = new Map<number, FrameRequestCallback>()
+  const listeners = new Set<(event: MediaQueryListEvent) => void>()
+
+  beforeEach(() => {
+    now = 0
+    nextFrame = 0
+    reduced = false
+    frames.clear()
+    listeners.clear()
+    vi.spyOn(performance, 'now').mockImplementation(() => now)
+    vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => {
+      frames.set(++nextFrame, callback)
+      return nextFrame
+    })
+    vi.stubGlobal('cancelAnimationFrame', (id: number) => { frames.delete(id) })
+    vi.stubGlobal('matchMedia', () => ({
+      get matches() { return reduced },
+      addEventListener: (_name: string, callback: (event: MediaQueryListEvent) => void) => { listeners.add(callback) },
+      removeEventListener: (_name: string, callback: (event: MediaQueryListEvent) => void) => { listeners.delete(callback) },
+    }))
+  })
+  afterEach(() => { cleanup(); vi.restoreAllMocks(); vi.unstubAllGlobals() })
+
+  const step = (time: number) => {
+    now = time
+    const pending = [...frames.values()]
+    frames.clear()
+    act(() => { pending.forEach((callback) => { callback(time) }) })
+  }
+  const position = (control: HTMLElement) => Number.parseFloat(control.style.getPropertyValue('--dsh-switch-x'))
+  const setReduced = (value: boolean) => {
+    reduced = value
+    const event = Object.assign(new Event('change'), { matches: value, media: '(prefers-reduced-motion: reduce)' })
+    act(() => { listeners.forEach((listener) => { listener(event) }) })
+  }
+
+  it('starts at rest, follows the official snappy/precise prediction and stays inside its track', () => {
+    const view = render(<Switch checked={false} label="Toggle" onChange={() => {}} />)
+    const control = screen.getByRole('switch')
+    expect(position(control)).toBe(0)
+    expect(frames.size).toBe(0)
+    view.rerender(<Switch checked label="Toggle" onChange={() => {}} />)
+    expect(control.getAttribute('aria-checked')).toBe('true')
+    expect(position(control)).toBe(0)
+    step(16)
+    // Reference samples generated by official Feel.response(Feel.words(...).params, -16, 0).
+    expect(position(control)).toBeCloseTo(0.9759540786458576, 8)
+    step(64)
+    expect(position(control)).toBeCloseTo(7.867556636336255, 8)
+    step(160)
+    expect(position(control)).toBeCloseTo(15.04782452354965, 8)
+    step(320)
+    expect(position(control)).toBe(16)
+    expect(frames.size).toBe(0)
+  })
+
+  it('preserves position and momentum on rapid reversal, then settles without queued motion', () => {
+    const view = render(<Switch checked={false} label="Toggle" onChange={() => {}} />)
+    const control = screen.getByRole('switch')
+    view.rerender(<Switch checked label="Toggle" onChange={() => {}} />)
+    step(64)
+    const turning = position(control)
+    view.rerender(<Switch checked={false} label="Toggle" onChange={() => {}} />)
+    expect(position(control)).toBe(turning)
+    expect(frames.size).toBe(1)
+    step(80)
+    // The body still has forward velocity; resetting it would immediately move left.
+    expect(position(control)).toBeGreaterThan(turning)
+    for (let time = 96; time <= 800; time += 16) {
+      step(time)
+      expect(position(control)).toBeGreaterThanOrEqual(0)
+      expect(position(control)).toBeLessThanOrEqual(16)
+    }
+    expect(position(control)).toBe(0)
+    expect(frames.size).toBe(0)
+  })
+
+  it('jumps to rest for reduced motion, including changes made during a spring', () => {
+    const view = render(<Switch checked={false} label="Toggle" onChange={() => {}} />)
+    const control = screen.getByRole('switch')
+    view.rerender(<Switch checked label="Toggle" onChange={() => {}} />)
+    step(16)
+    setReduced(true)
+    expect(position(control)).toBe(16)
+    expect(frames.size).toBe(0)
+    view.rerender(<Switch checked={false} label="Toggle" onChange={() => {}} />)
+    expect(position(control)).toBe(0)
+    expect(frames.size).toBe(0)
+    setReduced(false)
+    view.rerender(<Switch checked label="Toggle" onChange={() => {}} />)
+    expect(position(control)).toBe(0)
+    expect(frames.size).toBe(1)
+  })
+
+  it('owns and releases its frame and preference listener independently of other switches', () => {
+    const first = render(<Switch checked={false} label="First" onChange={() => {}} />)
+    const second = render(<Switch checked={false} label="Second" onChange={() => {}} />)
+    first.rerender(<Switch checked label="First" onChange={() => {}} />)
+    second.rerender(<Switch checked label="Second" onChange={() => {}} />)
+    expect(frames.size).toBe(2)
+    expect(listeners.size).toBe(2)
+    first.unmount()
+    expect(frames.size).toBe(1)
+    expect(listeners.size).toBe(1)
+    step(64)
+    expect(position(screen.getByRole('switch', { name: 'Second' }))).toBeGreaterThan(0)
+    second.unmount()
+    expect(frames.size).toBe(0)
+    expect(listeners.size).toBe(0)
+  })
+})
