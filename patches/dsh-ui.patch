+    let preset!: Scope
+    await ctx.plugin(Object.assign((inner: Context) => { preset = createScope(inner, presetKey) }, { inject: ['tools'] }))
+    await preset.ctx.plugin(ToolWeb, {})
+    registerTool(preset.ctx, 'mcp__tavily__search')
+    const { agent } = await agentWithSession(ctx, 'preset-agent', { parent: presetKey })
+    const { agent: outsider } = await agentWithSession(ctx, 'outsider-agent')
+    await switchReady(ctx, agent)
+    expect(await admitted(ctx, agent)).toEqual([MCP_SEARCH, 'mcp__tavily__search', 'read', 'web_fetch', 'web_search'])
+    expect(await web(ctx, outsider, ' off')).toBeUndefined()
+
+    expect(await web(ctx, agent, ' off')).toEqual({ kind: 'success', text: 'Web search off.' })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    expect(await admitted(ctx, outsider)).toEqual([MCP_SEARCH, 'read'])
+    await web(ctx, agent, ' on')
+    expect(await admitted(ctx, agent)).toEqual([MCP_SEARCH, 'mcp__tavily__search', 'read', 'web_fetch', 'web_search'])
+  })
+})
+
+describe('web-search switch through the agent loop', () => {
+  it('a /web selection made during a step changes the next request\'s tools and is logged before that step starts', async () => {
+    const ctx = new Context()
+    mounted.push(ctx)
+    await mountAgentLoopTestDependencies(ctx)
+    await ctx.plugin(CommandRuntime)
+    await ctx.plugin(WebRuntime, {})
+    await ctx.plugin(ToolWeb, {})
+    registerTool(ctx, 'read')
+    registerTool(ctx, MCP_SEARCH)
+    ctx.tools.register(defineContentToolFixture({
+      name: 'select_web',
+      description: 'test tool that runs one /web selection for the calling agent',
+      parameters: { state: { type: 'string', required: true } },
+      execute: async (args, exec) => {
+        if (exec.agent === undefined) throw new Error('select_web needs a calling agent')
+        const execution = await ctx.commands.execute(exec.agent, `/web ${args.state}`, [], exec.signal)
+        return [{ type: 'text', text: execution?.result.kind ?? 'unknown command' }]
+      },
+    }))
+    const harness = await mountAgentLoopTestHarness(ctx)
+    const adapter = new MockAdapter([
+      toolCallResponse('call-off', 'select_web', { state: 'off' }),
+      toolCallResponse('call-on', 'select_web', { state: 'on' }),
+      textResponse('done'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const agent = await harness.create(SessionId('loop-web-switch'), { provider: 'mock', model: 'mock' })
+    await switchReady(ctx, agent)
+
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'search, then stop searching' }], source: { kind: 'user' } }))
+    await agent.whenIdle()
+
+    const requestTools = adapter.requests.map(request => (request.tools ?? []).map(tool => tool.name).sort())
+    expect(requestTools).toEqual([
+      [MCP_SEARCH, 'read', 'select_web', 'web_fetch', 'web_search'],
+      ['read', 'select_web'],
+      [MCP_SEARCH, 'read', 'select_web', 'web_fetch', 'web_search'],
+    ])
+    const log = agent.session.snapshotEvents()
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }, { enabled: true }])
+    const stepStarts = log.filter(event => event.type === 'step/start').map(event => event.seq)
+    const switches = log.filter(event => event.type === 'web/search').map(event => event.seq)
+    expect(stepStarts).toHaveLength(3)
+    expect(switches[0]).toBeGreaterThan(stepStarts[0] ?? Infinity)
+    expect(switches[0]).toBeLessThan(stepStarts[1] ?? -Infinity)
+    expect(switches[1]).toBeGreaterThan(stepStarts[1] ?? Infinity)
+    expect(switches[1]).toBeLessThan(stepStarts[2] ?? -Infinity)
+  })
+})
