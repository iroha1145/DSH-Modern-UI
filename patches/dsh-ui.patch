+
+/* Text wrapping (TypeUI): headings even out their lines, and prose keeps a
+ * word or character from sitting alone on its last line. The longhand leaves
+ * wrap modes alone (single-line rows, preformatted code), and the
+ * zero-specificity selectors let any component rule decide otherwise. */
+:where(h1, h2, h3, h4, h5, h6) {
+  text-wrap-style: balance;
+}
+
+:where(p, li, dd, blockquote, figcaption) {
+  text-wrap-style: pretty;
+}
+
+/* Beautiful UI Motion Primitives */
+@keyframes shimmer-text {
+  0% {
+    background-position: 100% 0;
+  }
+  100% {
+    background-position: -100% 0;
+  }
+}
+
+.shimmer-text {
+  background: linear-gradient(
+    90deg,
+    var(--ink-2) 0%,
+    var(--ink-2) 38%,
+    var(--ink) 50%,
+    var(--ink-2) 62%,
+    var(--ink-2) 100%
+  );
+  background-size: 220% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: shimmer-text 2.2s linear infinite;
+}
+
+body[data-ds-dark-theme] .shimmer-text {
