+// @vitest-environment jsdom
+/**
+ * The card registered into the Models page's footer list on the real slot
+ * runtime: its place and dictionaries, the rendered rows, an edit saved
+ * through the settings form, a price refresh, and its removal with the
+ * calling scope.
+ */
+
+import { act, cleanup, fireEvent, waitFor, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotTestRuntime } from '@deepseek-ai/dsh-client-test-runtime'
+import type { ModelPickerSettings } from '../src/model-settings.ts'
+import { de, en, es, fr, ja, pt, ru, zh } from '../src/client/settings/locales.ts'
+import { registerModelPickerSettings, type ModelPickerSettingsDeps } from '../src/client/settings/register.ts'
+import { blurbOf, catalogStore, effortNameOf, FETCHED_PRICES, presetOf, priceFetch, readyForm } from './model-settings-fixtures.client.ts'
+
+afterEach(cleanup)
+
+const FOOTER = 'settings.models.footer'
+
+interface BenchOptions {
+  value?: ModelPickerSettings
+  user?: unknown
+  writable?: boolean
+  status?: 'loading' | 'ready' | 'unavailable'
+  deps?: Partial<ModelPickerSettingsDeps>
+}
+
+/** The footer list on a slot runtime, with the card registered over a stubbed form and catalog. */
+async function bench(options: BenchOptions = {}) {
+  const host = await SlotTestRuntime.create()
+  onTestFinished(() => host.dispose())
+  const locale = new LocaleRuntime(host.ctx)
+  for (const [id, label] of [['ja', '日本語'], ['es', 'Español'], ['fr', 'Français'], ['de', 'Deutsch'], ['ru', 'Русский'], ['pt', 'Português']] as const) {
+    locale.addLanguage({ id, label, fallback: 'en' })
+  }
+  locale.setLocale('en')
+  host.ctx.provide('locale', locale)
+  host.slots.installLocale(locale)
+  await host.declare({ [FOOTER]: { kind: 'list', scope: 'root' } })
+  const form = readyForm(options.value ?? {}, options.user, options.writable ?? true)
+  if (options.status !== undefined) form.publish({ status: options.status })
+  const catalog = catalogStore()
+  const loadCatalog = vi.fn()
+  const plugin = await host.mount({
+    inject: ['slots', 'locale'],
+    apply(ctx) {
+      registerModelPickerSettings(ctx, {
+        form: form.scope, catalog, loadCatalog, blurb: blurbOf, effortName: effortNameOf, ...options.deps,
+      })
+    },
+  })
+  const view = host.renderSlot(FOOTER, {})
+  return { host, locale, form, catalog, loadCatalog, plugin, view }
+}
+
+describe('registerModelPickerSettings', () => {
+  it('joins the Models page footer list under its own id and dictionary namespace', async () => {
+    const { host } = await bench()
+
+    const entries = host.slots.entries(FOOTER)
+    expect(entries).toHaveLength(1)
+    expect(entries[0]?.options).toMatchObject({ id: 'model-picker-details', order: 10 })
+    expect(entries[0]?.locale).toBe('modelSettings')
+  })
+
+  it('renders the catalog\'s models and asks for the catalog once shown', async () => {
+    const { view, loadCatalog } = await bench()
+
+    expect(loadCatalog).toHaveBeenCalled()
+    expect(view.view.getByRole('heading', { name: en['card.title'] })).toBeTruthy()
+    expect(view.view.getAllByRole('listitem')).toHaveLength(4)
+    expect(view.view.getByRole('button', { name: /Flash \(account\)/ })).toBeTruthy()
+    expect(view.view.getByRole('button', { name: /Claude Opus 5\.5/ })).toBeTruthy()
+  })
+
+  it.each([
+    ['zh', zh], ['en', en], ['ja', ja], ['es', es], ['fr', fr], ['de', de], ['ru', ru], ['pt', pt],
+  ] as const)('speaks %s', async (id, dictionary) => {
+    const { view, locale } = await bench()
+
+    act(() => { locale.setLocale(id) })
+
+    expect(view.view.getByRole('heading', { name: dictionary['card.title'] })).toBeTruthy()
+    expect(view.view.getByText(dictionary['prices.note'])).toBeTruthy()
+  })
+
+  it('renders nothing until the section is ready, then shows the rows', async () => {
+    const { view, form } = await bench({ status: 'loading' })
+    expect(view.container.textContent).toBe('')
+
+    act(() => { form.publish({ status: 'ready', value: {} }) })
+
+    expect(view.view.getByRole('heading', { name: en['card.title'] })).toBeTruthy()
+  })
+
+  it('renders nothing where the section is not served', async () => {
+    const { view } = await bench({ status: 'unavailable' })
+
+    expect(view.container.textContent).toBe('')
+  })
+
+  it('saves an edit through the settings form and closes the editor', async () => {
+    const { view, form } = await bench()
+    fireEvent.click(view.view.getByRole('button', { name: /Claude Opus 5\.5/ }))
+    const editor = within(view.view.getByRole('group', { name: 'Details for Claude Opus 5.5' }))
+
+    expect(editor.getByLabelText(en['field.speed'])).toHaveProperty('value', '')
+    expect(editor.getByLabelText(en['field.description'])).toHaveProperty('placeholder', blurbOf(presetOf('claude-opus-5-5').blurb))
+    expect(editor.getByRole('button', { name: en['action.save'] })).toHaveProperty('disabled', true)
+    fireEvent.change(editor.getByLabelText(en['field.description']), { target: { value: 'My notes' } })
+    fireEvent.change(editor.getByLabelText(en['field.speed']), { target: { value: '3' } })
+    fireEvent.change(editor.getByLabelText(en['field.priceOutput']), { target: { value: '18.5' } })
+    expect(editor.getByLabelText(en['field.description'])).toHaveProperty('value', 'My notes')
+    fireEvent.click(editor.getByRole('button', { name: en['action.save'] }))
+
+    expect(form.mutate).toHaveBeenCalledWith([
+      { op: 'set', path: ['models', 'claude-opus-5-5', 'description'], value: 'My notes' },
+      { op: 'set', path: ['models', 'claude-opus-5-5', 'speed'], value: 3 },
+      { op: 'set', path: ['models', 'claude-opus-5-5', 'priceOutput'], value: 18.5 },
+    ], 1)
+    await waitFor(() => { expect(view.view.queryByRole('group', { name: /^Details for/ })).toBeNull() })
+    act(() => {
+      form.publish({
+        value: { models: { 'claude-opus-5-5': { description: 'My notes', speed: 3, priceOutput: 18.5 } } },
+        user: { models: { 'claude-opus-5-5': { description: 'My notes', speed: 3, priceOutput: 18.5 } } },
+      })
+    })
+    const row = view.view.getByRole('button', { name: /Claude Opus 5\.5/ })
+    expect(within(row).getByText(en['row.customized'])).toBeTruthy()
+    expect(within(row).getByText(en['source.user'])).toBeTruthy()
+    expect(within(row).getByRole('img', { name: 'Speed 3 of 5' })).toBeTruthy()
+  })
+
+  it('says so, and keeps the editor open, when the Host refuses an edit', async () => {
+    const { view, form } = await bench()
+    form.mutate.mockResolvedValueOnce(false)
+    fireEvent.click(view.view.getByRole('button', { name: /Custom Model/ }))
+    const editor = within(view.view.getByRole('group', { name: 'Details for Custom Model' }))
+    expect(editor.getByLabelText(en['field.description'])).toHaveProperty('placeholder', 'Words from the catalog')
+
+    fireEvent.change(editor.getByLabelText(en['field.latency']), { target: { value: 'soon' } })
+    expect(editor.getByText(en['field.invalidSeconds'])).toBeTruthy()
+    expect(editor.getByRole('button', { name: en['action.save'] })).toHaveProperty('disabled', true)
+    fireEvent.change(editor.getByLabelText(en['field.latency']), { target: { value: '0.8' } })
+    fireEvent.click(editor.getByRole('button', { name: en['action.save'] }))
+
+    await waitFor(() => { expect(editor.getByRole('alert').textContent).toBe(en['editor.saveFailed']) })
+  })
+
+  it('narrows the reasoning levels and writes the kept ones', async () => {
+    const { view, form } = await bench()
+    fireEvent.click(view.view.getByRole('button', { name: /Flash \(account\)/ }))
+    const editor = within(view.view.getByRole('group', { name: 'Details for Flash (account)' }))
+
+    expect(editor.getAllByRole('checkbox').map(box => (box as HTMLInputElement).labels?.[0]?.textContent)).toEqual([
+      '关闭', '高', '最高', 'Extra',
+    ])
+    fireEvent.click(editor.getByRole('checkbox', { name: '最高' }))
+    fireEvent.click(editor.getByRole('checkbox', { name: 'Extra' }))
+    fireEvent.click(editor.getByRole('button', { name: en['action.save'] }))
+
+    expect(form.mutate).toHaveBeenCalledWith([{
+      op: 'set', path: ['models', 'deepseek-flash', 'efforts'], value: ['off', 'high'],
+    }], 1)
+    await waitFor(() => { expect(view.view.queryByRole('group', { name: /^Details for/ })).toBeNull() })
+  })
+
+  it('restores the built-in details of a customized model', async () => {
+    const { view, form } = await bench({
+      value: { models: { 'claude-opus-5-5': { speed: 3 } } },
+      user: { models: { 'claude-opus-5-5': { speed: 3 } } },
+    })
+    fireEvent.click(view.view.getByRole('button', { name: /Claude Opus 5\.5/ }))
+
+    fireEvent.click(view.view.getByRole('button', { name: en['action.restore'] }))
+
+    expect(form.mutate).toHaveBeenCalledWith([{ op: 'unset', path: ['models', 'claude-opus-5-5'] }], 1)
+    await waitFor(() => { expect(view.view.queryByRole('group', { name: /^Details for/ })).toBeNull() })
+  })
+
+  it('reads prices from models.dev and shows them once the Host accepts them', async () => {
+    const fetcher = priceFetch()
+    const now = new Date('2026-10-25T08:30:00.000Z')
+    const { view, form } = await bench({ deps: { fetcher, now: () => now } })
+
+    fireEvent.click(view.view.getByRole('button', { name: en['prices.refresh'] }))
+    expect(view.view.getByRole('button', { name: en['prices.refreshing'] })).toHaveProperty('disabled', true)
+
+    await waitFor(() => { expect(view.view.getByRole('button', { name: en['prices.refresh'] })).toHaveProperty('disabled', false) })
+    expect(form.mutate).toHaveBeenCalledWith([
+      { op: 'set', path: ['prices'], value: FETCHED_PRICES },
+      { op: 'set', path: ['pricesUpdatedAt'], value: '2026-10-25T08:30:00.000Z' },
+    ])
+    act(() => { form.publish({ value: { prices: FETCHED_PRICES, pricesUpdatedAt: '2026-10-25T08:30:00.000Z' } }) })
+    const time = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short' }).format(now)
+    expect(view.view.getByText(`Last updated: ${time}, from models.dev`)).toBeTruthy()
+    const luna = view.view.getByRole('button', { name: /GPT Luna/ })
+    expect(within(luna).getByText('$0.2 / $0.8 per million tokens')).toBeTruthy()
+    expect(within(luna).getByText(en['source.fetched'])).toBeTruthy()
+  })
+
+  it('reports a price source that cannot be read, and keeps the stored prices', async () => {
+    const fetcher = vi.fn(() => Promise.reject(new Error('Failed to fetch')))
+    const { view, form } = await bench({ deps: { fetcher } })
+
+    fireEvent.click(view.view.getByRole('button', { name: en['prices.refresh'] }))
+
+    await waitFor(() => { expect(view.view.getByRole('alert').textContent).toBe('Could not read models.dev: Failed to fetch') })
+    expect(form.mutate).not.toHaveBeenCalled()
+  })
+
+  it('locks editing and refreshing while the document is read-only', async () => {
+    const { view } = await bench({ writable: false })
+
+    expect(view.view.getByText(en['card.readOnly'])).toBeTruthy()
+    expect(view.view.getByRole('button', { name: en['prices.refresh'] })).toHaveProperty('disabled', true)
+  })
+
+  it('leaves with the calling scope: entry, dictionaries, and form subscription', async () => {
+    const { host, plugin, form, locale, view } = await bench()
+    expect(form.listenerCount()).toBe(1)
+    expect(locale.bind('modelSettings')('card.title')).toBe(en['card.title'])
+
+    await plugin.dispose()
+
+    expect(host.slots.entries(FOOTER)).toHaveLength(0)
+    expect(form.listenerCount()).toBe(0)
+    expect(locale.bind('modelSettings')('card.title')).toBe('card.title')
+    expect(view.container.textContent).toBe('')
+  })
+})
