+  '[3]: https://docs.python.org/3/library/os.html?highlight=path#os "OS docs"',
+  '[4]: https://gvisor.dev/docs/ "Fourth source"',
+].join('\n')
+
+function view(markdown: string, extra: string = definitions) {
+  return render(<MarkdownText text={`${markdown}\n\n${extra}`} labels={labels} citations />)
+}
+
+function elements(container: ParentNode, selector: string): HTMLElement[] {
+  return [...container.querySelectorAll<HTMLElement>(selector)]
+}
+
+function chips(container: ParentNode): HTMLElement[] {
+  return elements(container, '[data-citation-kind="reference"]')
+}
+
+function cards(container: ParentNode): HTMLElement[] {
+  return elements(container, '[data-citation-kind="source"]')
+}
+
+/** Last input is the keyboard, so focus may open the preview. */
+function useKeyboard(): void {
+  window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Tab' }))
+}
