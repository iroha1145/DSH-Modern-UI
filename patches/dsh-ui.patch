@@ -0,0 +1,94 @@
+/** Real-app regressions for Windows caption actions and reduced-motion welcome content. */
+import { fileURLToPath } from 'node:url'
+import { chromium, type Locator } from 'playwright'
+import { expect, it, onTestFinished } from 'vitest'
+import { launchWebScaffold, watchConsole } from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage } from './support.ts'
+
+/** Check the complete caption hit target, including points near its four corners. */
+async function captionActionIsReachable(button: Locator): Promise<boolean> {
+  return button.evaluate((element) => {
+    const bounds = element.getBoundingClientRect()
+    if (bounds.width < 24 || bounds.height < 24 || bounds.x < 0 || bounds.y < 0 || bounds.bottom > 40) return false
+    const inset = 6
+    const points: readonly (readonly [number, number])[] = [
+      [bounds.x + bounds.width / 2, bounds.y + bounds.height / 2],
+      [bounds.left + inset, bounds.top + inset], [bounds.right - inset, bounds.top + inset],
+      [bounds.left + inset, bounds.bottom - inset], [bounds.right - inset, bounds.bottom - inset],
+    ]
+    return points.every(([x, y]) => {
+      const hit = document.elementFromPoint(x, y)
+      return hit !== null && element.contains(hit)
+    })
+  })
+}
+
+it('keeps Windows caption actions clickable after collapsing the sidebar', async () => {
+  const scaffold = await launchWebScaffold({
+    extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)),
+  })
+  onTestFinished(() => scaffold.close())
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await newEnglishPage(browser, 800)
+  const tripwire = watchConsole(page)
+  // Use the caption marker channel from caption-overlays.e2e.ts before React mounts.
+  await page.addInitScript(() => {
+    const mark = () => {
+      document.documentElement.setAttribute('data-windows-titlebar', '')
+      document.documentElement.style.setProperty('--dsh-windows-titlebar-height', '40px')
+    }
+    if (document.documentElement === null) document.addEventListener('DOMContentLoaded', mark, { once: true })
+    else mark()
+  })
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await connectFreshWorkspace(page, scaffold.workspaceCwd)
+  const collapse = page.getByRole('button', { name: 'Collapse sidebar', exact: true })
+  await expect.poll(() => captionActionIsReachable(collapse)).toBe(true)
+  await collapse.click()
+
+  const reopen = page.getByRole('button', { name: 'Open sidebar', exact: true })
+  const newSession = page.getByRole('button', { name: 'New session', exact: true })
+  await reopen.waitFor({ state: 'visible' })
+  await newSession.waitFor({ state: 'visible' })
+  await expect.poll(() => captionActionIsReachable(reopen)).toBe(true)
+  await expect.poll(() => captionActionIsReachable(newSession)).toBe(true)
+
+  const creation = page.waitForResponse('**/api/session/create')
+  await newSession.click()
+  const created = await creation
+  expect(created.ok()).toBe(true)
+  expect(await created.json()).toMatchObject({ result: { ok: true } })
+  await page.locator('[data-composer-input][contenteditable="true"]').waitFor()
+  await page.getByRole('heading', { name: 'Into the Unknown', exact: true }).waitFor()
+  await reopen.click()
+  await collapse.waitFor({ state: 'visible' })
+  await expect.poll(() => captionActionIsReachable(collapse)).toBe(true)
+  expect(tripwire.pageErrors).toEqual([])
+})
+
+it('removes all welcome entrance animations when reduced motion is requested', async () => {
+  const scaffold = await launchWebScaffold()
+  onTestFinished(() => scaffold.close())
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await newEnglishPage(browser)
+  const tripwire = watchConsole(page)
+  await page.emulateMedia({ reducedMotion: 'reduce' })
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  const welcome = [
+    page.getByText('DeepSeek Harness · Development workspace', { exact: true }).locator('..'),
+    page.getByRole('heading', { name: 'Into the Unknown', exact: true }),
+    page.getByText('Choose a workspace, describe a task, or start with a suggestion', { exact: true }),
+  ]
+  for (const element of welcome) {
+    await element.waitFor({ state: 'visible' })
+    expect(await element.evaluate(node => getComputedStyle(node).animationName)).toBe('none')
+  }
+  // The same live elements retain their entrance treatment without that preference.
+  await page.emulateMedia({ reducedMotion: 'no-preference' })
+  for (const element of welcome) {
+    await expect.poll(() => element.evaluate(node => getComputedStyle(node).animationName)).not.toBe('none')
+  }
+  expect(tripwire.pageErrors).toEqual([])
+})
