--- /dev/null
+++ b/snapshots/session/web-search-pending/select-during-tool.mjs
@@ -0,0 +1,16 @@
+/** Select web search off through the production command during a recorded tool step. */
+export const name = 'web-search-pending-fixture'
+export const inject = ['commands', 'tools']
+
+/**
+ * @param {import('@deepseek-ai/cordis').Context} ctx - Scenario context.
+ */
+export function apply(ctx) {
+  ctx.on('tools/execute', async (exec, next) => {
+    if (exec.name === 'bash') {
+      const execution = await ctx.commands.execute(exec.agent, '/web off', [], exec.signal)
+      if (execution?.result.kind !== 'success' || execution.result.text !== 'Turning web search off (applies from the next step).') throw new Error('web-search fixture could not select off')
+    }
+    return next()
+  })
+}
