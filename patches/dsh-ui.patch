+/** Web visualization presentation guidance and its browser plugin registration. */
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type {} from '@deepseek-ai/dsh-system-prompt'
+import { PRESENTATION_PROMPT } from './presentation-prompt.ts'
+
+/** Prompt registry required for additive Web response guidance. */
+export const inject = ['systemPrompt']
+
+/** Deployment switch for the additive presentation guidance. */
+export interface Config {
+  /** Add visual, image, and citation guidance to model requests made through this Web composition. */
+  enabled: boolean
+}
+
+/** Validate the guidance switch without replacing persona or model settings. */
+export const Config: z<Config> = z.object({ enabled: z.boolean().default(true) })
+
+/**
+ * Add presentation guidance as its own section, independent of a scoped persona suffix.
+ * @param ctx - Host context carrying the prompt registry.
+ * @param config - Validated guidance switch.
+ */
+export function apply(ctx: Context, config: Config): void {
+  if (!config.enabled) return
+  ctx.effect(() => ctx.systemPrompt.section({
+    name: 'deployment:response-presentation',
+    order: ctx.systemPrompt.getSectionOrder('DEPLOYMENT_PERSONA_SUFFIX') - 1,
+    interpolate: false,
+    text: PRESENTATION_PROMPT,
+  }), 'ui-intelligent-ui: response presentation guidance')
+}
