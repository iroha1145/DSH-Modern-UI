+// @vitest-environment jsdom
+/**
+ * The Models settings card as the Models page renders it: header and price
+ * refresh, one row per model with its effective ratings and price, and the
+ * editor that opens under a row. State arrives through the bound selector
+ * hook, as the renderer binds the controller's store.
+ */
+
+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { bindSnapshotSelector, makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import type { ModelEditorState, ModelRowState, ModelSettingsState } from '../src/client/settings/controller.ts'
+import { de, en, es, fr, ja, pt, ru, zh } from '../src/client/settings/locales.ts'
+import { ModelPickerSettingsCard, type ModelPickerSettingsCardProps } from '../src/client/settings/ModelPickerSettingsCard.tsx'
+
+afterEach(cleanup)
+
+function row(overrides: Partial<ModelRowState> = {}): ModelRowState {
+  return {
+    id: 'model-one',
+    name: 'Model One',
+    glyph: 'M',
+    mark: undefined,
+    speed: 4,
+    quality: 3,
+    cost: 1,
+    priceInput: 0.15,
+    priceOutput: 0.6,
