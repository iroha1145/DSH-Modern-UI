+/** Isolated OpenIntelligentUI presentation, with no host or model capability bridge, and the related-questions list. */
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+import type {} from '@deepseek-ai/dsh-client-ui-theme/client'
+import { Followups } from './Followups.tsx'
+import { IntelligentUI, type ThemeInjected } from './IntelligentUI.tsx'
+import { zh, en, ja, es, fr, de, ru, pt } from './locales.ts'
+
+/** Slot and locale services required by this browser-only plugin. */
+export const inject = ['slots', 'locale', 'theme']
+
+/**
+ * Register localized completed-message rendering in the chat-owned code-renderer chain slot:
+ * `openui` fences become inline visualizations and `followups` fences become a list of related questions.
+ * @param ctx - Browser plugin context.
+ */
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.locale.register('intelligent', { zh, en, ja, es, fr, de, ru, pt }), 'ui-intelligent-ui: dictionaries')
+  ctx.slots.inject('conversation.chat.message.code', () => ctx.slots.register({
+    name: 'conversation.chat.message.code', locale: 'intelligent', priority: 0,
+    select: owner => owner.lang?.trim().toLowerCase() === 'openui' ? {} : null,
+    inject: (): ThemeInjected => ({ hooks: { theme: {
+      getSnapshot: () => ctx.theme.getTheme(),
+      subscribe: listener => ctx.on('theme/change', listener),
+    } } }),
+  }, IntelligentUI))
+  ctx.slots.inject('conversation.chat.message.code', () => ctx.slots.register({
+    name: 'conversation.chat.message.code', locale: 'intelligent', priority: 0,
+    select: owner => owner.lang?.trim().toLowerCase() === 'followups' ? {} : null,
+  }, Followups))
+}
