+// @vitest-environment jsdom
+import { Context } from '@deepseek-ai/cordis'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type { ThemeSnapshot } from '@deepseek-ai/dsh-client-ui-theme/client'
+import { describe, expect, it, vi } from 'vitest'
+import { Followups } from '../src/client/Followups.tsx'
+import { IntelligentUI } from '../src/client/IntelligentUI.tsx'
+import * as plugin from '../src/client/index.ts'
+
+async function fixture() {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  ctx.provide('locale', new LocaleRuntime(ctx))
+  const dark = { active: { colorScheme: 'dark' } } as ThemeSnapshot
+  const theme = { getTheme: vi.fn(() => dark) }
+  ctx.provide('theme', theme)
+  const fiber = ctx.plugin(plugin)
+  await fiber.await()
+  const declare = () => ctx.slots.register({
+    name: 'root',
+    children: { 'conversation.chat.message.code': { kind: 'chain', scope: 'session' } },
+  } as never, (() => null) as never)
+  return { ctx, fiber, declare, theme, dark }
+}
+
+type Entry = ReturnType<Context['slots']['entries']>[number]
+
+function elect(entry: Entry | undefined, lang: string | undefined): unknown {
+  return entry?.select?.({ lang } as never)
+}
+
+describe('intelligent-ui browser plugin', () => {
+  it('requires the slot, locale, and theme services', () => {
+    expect(plugin.inject).toEqual(['slots', 'locale', 'theme'])
+  })
+
+  it('adds one localized entry for openui fences and one for followups fences to the chat code chain', async () => {
+    const { ctx, declare } = await fixture()
+    const dispose = declare()
+    const entries = ctx.slots.entries('conversation.chat.message.code')
+    expect(entries.map(entry => entry.component)).toEqual([IntelligentUI, Followups])
+    expect(entries.map(entry => entry.options.priority)).toEqual([0, 0])
+    expect(entries.map(entry => entry.locale)).toEqual(['intelligent', 'intelligent'])
+    const [visual, related] = entries
+    expect([undefined, 'openui', ' OpenUI ', 'followups', 'ts'].map(lang => elect(visual, lang))).toEqual([null, {}, {}, null, null])
+    expect([undefined, 'openui', 'followups', ' FollowUps ', 'ts'].map(lang => elect(related, lang))).toEqual([null, null, {}, {}, null])
+    dispose()
+  })
+
+  it('feeds the visualization the live theme and gives the related list no business face', async () => {
+    const { ctx, declare, theme, dark } = await fixture()
+    declare()
+    const [visual, related] = ctx.slots.entries('conversation.chat.message.code')
+    const injected = visual?.inject?.() as { hooks: { theme: { getSnapshot(): unknown; subscribe(listener: () => void): () => void } } }
+    expect(injected.hooks.theme.getSnapshot()).toBe(dark)
+    expect(theme.getTheme).toHaveBeenCalledOnce()
+    const listener = vi.fn()
+    const unsubscribe = injected.hooks.theme.subscribe(listener)
+    ctx.emit('theme/change', dark)
+    expect(listener).toHaveBeenCalledOnce()
+    unsubscribe()
+    ctx.emit('theme/change', dark)
+    expect(listener).toHaveBeenCalledOnce()
+    expect(related?.inject).toBeUndefined()
+  })
+
+  it('releases every contribution with the plugin', async () => {
+    const { ctx, fiber, declare } = await fixture()
+    declare()
+    expect(ctx.slots.entries('conversation.chat.message.code')).toHaveLength(2)
+    await fiber.dispose()
+    expect(ctx.slots.entries('conversation.chat.message.code')).toHaveLength(0)
+  })
+})
