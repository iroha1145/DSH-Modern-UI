diff --git a/packages/session/session-persistence/tests/modern-ui-compatibility.spec.ts b/packages/session/session-persistence/tests/modern-ui-compatibility.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bc4bec31d0e4d0f9097606f5541b3e690e544d9
--- /dev/null
+++ b/packages/session/session-persistence/tests/modern-ui-compatibility.spec.ts
@@ -0,0 +1,57 @@
+/** Required Modern UI events remain readable only by readers that understand their semantics. */
+import { mkdtemp, mkdir, cp, readFile, writeFile, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { describe, expect, it } from 'vitest'
+import { SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { validateStoredEvents } from '../src/storage-contract.ts'
+import { validateStoredEvents as officialRead } from './fixtures/official-reader/storage-contract.ts'
+import { KNOWN_SESSION_EVENT_TYPES as officialTypes } from './fixtures/official-reader/known-event-types.ts'
+import { meta, oneTurnLog } from './contract.ts'
+
+// The fixture copies the official 0.2.1-rc.3 storage validator and generated event list.
+// Only imports are relocated; neither reader's global event set is modified.
+describe('official and Modern UI session compatibility', () => {
+  it('reads official events with both readers and refuses required web/search in the official reader', () => {
+    const header = meta('compatibility')
+    const official = oneTurnLog()
+    expect(() => officialRead(header, structuredClone(official))).not.toThrow()
+    expect(() => validateStoredEvents(header, structuredClone(official))).not.toThrow()
+    const event: SessionEvent = { type: 'web/search', seq: SessionSeq(official.length), time: 20, data: { enabled: false } }
+    const modern = [...official, event]
+    expect(event.ignorable).not.toBe(true)
+    expect(officialTypes.has('web/search')).toBe(false)
+    expect(validateStoredEvents(header, structuredClone(modern)).at(-1)).toEqual(event)
+    expect(() => officialRead(header, structuredClone(modern))).toThrow('unknown to this harness and not marked ignorable')
+  })
+
+  it('keeps original and backup readable after an imported copy writes a Modern UI event', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-compatibility-'))
+    try {
+      const original = join(root, 'official')
+      const backup = join(root, 'backup')
+      const imported = join(root, 'modern')
+      await mkdir(original)
+      const header = meta('copy')
+      const official = oneTurnLog()
+      const bytes = JSON.stringify(official)
+      await writeFile(join(original, 'events.json'), bytes)
+      await cp(original, backup, { recursive: true, errorOnExist: true, force: false })
+      await cp(original, imported, { recursive: true, errorOnExist: true, force: false })
+      const event: SessionEvent = { type: 'web/search', seq: SessionSeq(official.length), time: 20, data: { enabled: false } }
+      await writeFile(join(imported, 'events.json'), JSON.stringify([...official, event]))
+      for (const directory of [original, backup]) {
+        const saved = await readFile(join(directory, 'events.json'), 'utf8')
+        expect(saved).toBe(bytes)
+        const events = JSON.parse(saved) as SessionEvent[]
+        expect(() => officialRead(header, events)).not.toThrow()
+      }
+      const modern = JSON.parse(await readFile(join(imported, 'events.json'), 'utf8')) as SessionEvent[]
+      expect(() => validateStoredEvents(header, structuredClone(modern))).not.toThrow()
+      expect(() => officialRead(header, structuredClone(modern))).toThrow('web/search')
+    } finally {
+      await rm(root, { recursive: true, force: true })
+    }
+  })
+})
