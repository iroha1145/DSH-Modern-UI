+    expect(editor.getByRole('button', { name: en['action.saving'] })).toHaveProperty('disabled', true)
+    expect(editor.getByRole('button', { name: en['action.cancel'] })).toHaveProperty('disabled', true)
+    expect(editor.getByRole('button', { name: en['action.restore'] })).toHaveProperty('disabled', true)
+    for (const control of [...editor.getAllByRole('textbox'), ...editor.getAllByRole('combobox')]) {
+      expect(control).toHaveProperty('disabled', true)
+    }
+  })
+})
+
+describe('the dictionaries', () => {
+  const placeholdersOf = (text: string): string[] => (text.match(/\{\w+\}/g) ?? []).sort()
+
+  it.each([
+    ['en', en], ['ja', ja], ['es', es], ['fr', fr], ['de', de], ['ru', ru], ['pt', pt],
+  ])('carry the Chinese keys and placeholders in %s', (_language, dictionary) => {
+    const keys = Object.keys(zh)
+    expect(Object.keys(dictionary).sort()).toEqual([...keys].sort())
+    for (const key of keys) {
+      const translated = (dictionary as Record<string, string>)[key]!
+      expect(placeholdersOf(translated), key).toEqual(placeholdersOf((zh as Record<string, string>)[key]!))
+    }
+  })
+
+  it('names a date locale for every language', () => {
+    expect([zh, en, ja, es, fr, de, ru, pt].map(dictionary => dictionary['time.locale'])).toEqual([
+      'zh-CN', 'en', 'ja-JP', 'es', 'fr', 'de', 'ru', 'pt',
+    ])
+  })
+})
diff --git a/packages/client/ui-model-selection/tests/profiles.client.spec.ts b/packages/client/ui-model-selection/tests/profiles.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02b324564fb85ef37cb15e758235bd99aeac4d04
--- /dev/null
+++ b/packages/client/ui-model-selection/tests/profiles.client.spec.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { ModelCatalogModel } from '@deepseek-ai/dsh-api-session-controller/types'
+import { glyphFor, PRESET_BLURBS, presetFor } from '../src/client/presets.ts'
+import {
+  costTier, isOffEffort, preferredEffort, presetEfforts, profileOf, thinkingLatency, visibleEfforts,
+} from '../src/client/profiles.ts'
+import { autoMark, isVendorMark, MARK_IDS, VENDOR_MARKS } from '../src/client/vendor-marks.ts'
+import { fetchPrices, PRICE_SOURCE_URL, pricesFrom } from '../src/client/price-source.ts'
+import { zh, en } from '../src/client/locales.ts'
+
+const levels = (...ids: string[]) => ids.map(id => ({ id, name: id.toUpperCase() }))
+
+describe('model presets', () => {
+  it('matches vendor ids, aliases, route prefixes, and dated releases', () => {
+    expect(presetFor('claude-opus-5-5')?.vendor).toBe('anthropic')
+    expect(presetFor('MiniMax-M3')?.blurb).toBe('agentTasks')
+    expect(presetFor('k3')).toBe(presetFor('kimi-k3'))
+    // Kimi's coding endpoint publishes the K3.1 Pro ids without the vendor
+    // prefix; they are the same models the preset table describes.
+    expect(presetFor('k3.1-pro')).toBe(presetFor('kimi-k3.1-pro'))
+    expect(presetFor('k3.1-pro-highspeed')).toBe(presetFor('kimi-k3.1-pro-highspeed'))
+    expect(presetFor('k3.1-pro')?.efforts).toEqual(['low', 'high', 'max'])
+    // Only K3.1 Pro's levels were read from the vendor listing; the highspeed variant keeps the route's.
+    expect(presetFor('k3.1-pro-highspeed')?.efforts).toBeUndefined()
+    expect(presetFor('deepseek-v4-flash')).toBe(presetFor('deepseek-flash'))
+    expect(presetFor('openrouter/anthropic/claude-sonnet-5-5')).toBe(presetFor('claude-sonnet-5-5'))
+    expect(presetFor('deepseek-v4-pro-0813')).toBe(presetFor('deepseek-v4-pro'))
+    expect(presetFor('claude-haiku-5-5-20261007')).toBe(presetFor('claude-haiku-5-5'))
+    expect(presetFor('k3-20260101')).toBe(presetFor('kimi-k3'))
+    expect(presetFor('my-local-model')).toBeUndefined()
+    expect(presetFor('my-local-model-0101')).toBeUndefined()
+  })
+
+  it('draws vendor monograms for presets and name initials otherwise', () => {
+    expect(glyphFor('Claude Opus 5.5', presetFor('claude-opus-5-5'))).toBe('A')
+    expect(glyphFor('GLM-5.3', presetFor('glm-5.3'))).toBe('Z')
+    expect(glyphFor('  llama local', undefined)).toBe('L')
+    expect(glyphFor('3B tiny', undefined)).toBe('3')
+    expect(glyphFor('—', undefined)).toBe('')
+  })
+
+  it('localizes every description key in every dictionary', () => {
+    for (const blurb of PRESET_BLURBS) {
+      expect(zh[`preset.${blurb}`]).toBeTruthy()
+      expect(en[`preset.${blurb}`]).toBeTruthy()
+    }
+  })
+})
+
+describe('model profiles', () => {
+  const flash: ModelCatalogModel = {
+    id: 'deepseek-flash',
+    name: 'DeepSeek-V4.1-Flash',
+    reasoning: { efforts: levels('off', 'low', 'high', 'max'), defaultEffort: 'high' },
+  }
+
+  it('rates cost from the output price', () => {
+    expect([0.5, 1, 2.9, 3, 8, 19, 20, 21, 50].map(costTier)).toEqual([1, 1, 2, 2, 3, 4, 4, 5, 5])
+  })
+
+  it('uses the preset when the user changed nothing', () => {
+    const profile = profileOf(flash, undefined)
+    expect(profile).toEqual({
+      glyph: 'D', mark: 'deepseek', description: undefined, blurb: 'everyday', speed: 4, quality: 4, cost: 1, latencyMs: 900,
+      priceInput: 0.15, priceOutput: 0.6, priceSource: 'preset', efforts: flash.reasoning?.efforts,
+    })
+  })
+
+  it('layers fetched prices under the user\'s values', () => {
+    const fetched = profileOf(flash, { prices: { 'deepseek-flash': { input: 0.3, output: 1.2, provider: 'deepseek' } } })
+    expect([fetched.priceInput, fetched.priceOutput, fetched.priceSource, fetched.cost]).toEqual([0.3, 1.2, 'fetched', 2])
+    const user = profileOf(flash, {
+      prices: { 'deepseek-flash': { input: 0.3, output: 1.2, provider: 'deepseek' } },
+      models: { 'deepseek-flash': { priceOutput: 30, description: 'Mine', speed: 2, quality: 1, latencyMs: 100 } },
+    })
+    expect(user).toMatchObject({
+      priceInput: 0.3, priceOutput: 30, priceSource: 'user', cost: 5, description: 'Mine', blurb: undefined,
+      speed: 2, quality: 1, latencyMs: 100,
+    })
+    expect(profileOf(flash, { models: { 'deepseek-flash': { priceInput: 1 } } }).priceSource).toBe('user')
+    expect(profileOf(flash, { models: { 'deepseek-flash': { cost: 3 } } }).cost).toBe(3)
+  })
+
+  it('keeps the catalog description for models without a preset', () => {
+    const local: ModelCatalogModel = { id: 'local', name: 'Local model', description: 'From the catalog' }
+    expect(profileOf(local, undefined)).toMatchObject({
+      glyph: 'L', description: 'From the catalog', blurb: undefined, cost: undefined, priceSource: undefined, efforts: [],
+    })
+  })
+
+  it('narrows effort levels to the user\'s list and ignores a list naming nothing advertised', () => {
+    expect(profileOf(flash, { models: { 'deepseek-flash': { efforts: ['off', 'max'] } } }).efforts.map(level => level.id))
+      .toEqual(['off', 'max'])
+    expect(profileOf(flash, { models: { 'deepseek-flash': { efforts: ['ultra'] } } }).efforts).toBe(flash.reasoning?.efforts)
+  })
+
+  it('offers a preset\'s own levels when a route advertises a broader generic list', () => {
+    const generic = levels('off', 'minimal', 'low', 'medium', 'high')
+    const sonnet: ModelCatalogModel = { id: 'claude-sonnet-5-5', name: 'Claude Sonnet 5.5', reasoning: { efforts: generic } }
+    expect(profileOf(sonnet, undefined).efforts.map(level => level.id)).toEqual(['low', 'medium', 'high'])
+    expect(presetEfforts('claude-sonnet-5-5', levels('off', 'minimal'))).toEqual(levels('off', 'minimal'))
+    expect(presetEfforts('deepseek-v4-pro', generic)).toBe(generic)
+    expect(presetEfforts('my-local-model', generic)).toBe(generic)
+    expect(profileOf(sonnet, { models: { 'claude-sonnet-5-5': { efforts: ['off', 'minimal'] } } }).efforts.map(level => level.id))
+      .toEqual(['off', 'minimal'])
+    expect(profileOf(sonnet, { models: { 'claude-sonnet-5-5': { efforts: [] } } }).efforts.map(level => level.id))
+      .toEqual(['low', 'medium', 'high'])
+  })
+
+  it('uses the model name initial only when the user explicitly chooses a letter', () => {
+    const model = { id: 'claude-opus-5-5', name: 'Claude Opus 5.5' }
+    expect(profileOf(model, {}).mark).toBe('claude')
+    expect(profileOf(model, {}).glyph).toBe('A')
+    expect(profileOf(model, { models: { [model.id]: { icon: 'letter' } } })).toMatchObject({ mark: undefined, glyph: 'C' })
+    const gpt = { id: 'gpt-6.1-sol', name: 'GPT Sol' }
+    expect(profileOf(gpt, { models: { [gpt.id]: { icon: 'letter' } } })).toMatchObject({ mark: undefined, glyph: 'G' })
+  })
+
+  it('draws the user\'s mark choice, the letter, or the automatic mark', () => {
+    const named = (icon: string) => profileOf(flash, { models: { 'deepseek-flash': { icon } } })
+    expect(named('claude').mark).toBe('claude')
+    expect(named('letter').mark).toBeUndefined()
+    expect(named('retired-mark').mark).toBe('deepseek')
+    expect(profileOf({ id: 'local', name: 'Local model' }, undefined).mark).toBeUndefined()
+  })
+
+  it('keeps a hidden current effort visible', () => {
+    const offered = levels('off', 'max')
+    const advertised = levels('off', 'low', 'high', 'max')
+    expect(visibleEfforts(offered, advertised, undefined)).toBe(offered)
+    expect(visibleEfforts(offered, advertised, 'max')).toBe(offered)
+    expect(visibleEfforts(offered, advertised, 'high').map(level => level.id)).toEqual(['off', 'high', 'max'])
+  })
+
+  it('prefers the carried level, then the catalog default, then high, medium, or the strongest', () => {
+    expect(isOffEffort('none')).toBe(true)
+    expect(isOffEffort('low')).toBe(false)
+    expect(preferredEffort(levels('off', 'low', 'high', 'max'), 'high', 'max')).toBe('max')
+    expect(preferredEffort(levels('off', 'low', 'high'), 'high', 'xhigh')).toBe('high')
+    expect(preferredEffort(levels('minimal', 'low', 'medium'), undefined, 'off')).toBe('medium')
+    expect(preferredEffort(levels('low', 'max'), undefined, undefined)).toBe('max')
+    expect(preferredEffort(levels('off'), 'off', undefined)).toBeUndefined()
+  })
+
+  it('scales the first-token wait with the thinking level', () => {
+    const efforts = levels('off', 'low', 'high', 'max')
+    expect(thinkingLatency(undefined, efforts, 'max')).toBeUndefined()
+    expect(thinkingLatency(1000, efforts, undefined)).toBe(1000)
+    expect(thinkingLatency(1000, efforts, 'off')).toBe(1000)
+    expect(thinkingLatency(1000, efforts, 'low')).toBeCloseTo(1600)
+    expect(thinkingLatency(1000, efforts, 'high')).toBeCloseTo(2480)
+    expect(thinkingLatency(1000, efforts, 'unknown')).toBeCloseTo(1600)
+    expect(thinkingLatency(1000, levels('a', 'b', 'c', 'd', 'e', 'f'), 'f')).toBe(8000)
+  })
+})
+
+describe('vendor marks', () => {
+  it('uses the preset vendor\'s family mark', () => {
+    expect(autoMark('claude-opus-5-5', 'Claude Opus 5.5', presetFor('claude-opus-5-5'))).toBe('claude')
+    expect(autoMark('glm-5.3', 'GLM-5.3', presetFor('glm-5.3'))).toBe('zhipu')
+    expect(autoMark('grok-4.7', 'Grok 4.7', presetFor('grok-4.7'))).toBe('grok')
+  })
+
+  it.each([
+    ['claude-3-haiku', 'claude'], ['gpt-4o-mini', 'openai'], ['o3-mini', 'openai'], ['openai/codex-mini', 'openai'],
+    ['gemma-3-27b', 'gemini'], ['moonshot-v1-8k', 'kimi'], ['qwq-32b', 'qwen'], ['chatglm-6b', 'zhipu'],
+    ['abab6.5s', 'minimax'], ['deepseek-coder', 'deepseek'], ['grok-2', 'grok'], ['codestral-latest', 'mistral'],
+    ['llama-3.3-70b', 'meta'], ['doubao-seed-1.6', 'doubao'], ['hunyuan-turbo', 'hunyuan'], ['ernie-4.5', 'wenxin'],
+    ['step-2-16k', 'stepfun'],
+  ])('finds the family mark in %s', (id, mark) => {
+    expect(autoMark(id, id, undefined)).toBe(mark)
+  })
+
+  it('keeps the letter for unknown families and accepts only known mark ids', () => {
+    expect(autoMark('my-local-model', 'Local helper', undefined)).toBeUndefined()
+    expect(autoMark('photo-v1', 'Photo', undefined)).toBeUndefined()
+    expect(isVendorMark('meta')).toBe(true)
+    expect(isVendorMark('toString')).toBe(false)
+    expect(MARK_IDS).toEqual(Object.keys(VENDOR_MARKS))
+  })
+})
+
+describe('price source', () => {
+  const document = {
+    deepseek: { models: { 'deepseek-flash': { cost: { input: 0.15, output: 0.6, cache_read: 0.003 } } } },
+    zai: { models: { 'GLM-5.3': { cost: { input: 1.4, output: 4.4 } } } },
+    zhipuai: { models: { 'glm-5.3': { cost: { input: 1.2, output: 4.2 } }, 'glm-5.3-flash': { cost: { input: 0.12, output: 0.42 } } } },
+    plan: { models: { 'qwen3.8-max': { cost: { input: 0, output: 0 } } } },
+    broken: { models: { 'bad-model': { cost: { input: 'x', output: 1 } }, 'no-cost': {} } },
+    arrayish: [],
+  }
+
+  it('reads route prices first, then the preset vendor, skipping unpriced and malformed entries', () => {
+    expect(pricesFrom(document, [
+      { provider: 'deepseek-official', model: 'deepseek-flash' },
+      { provider: 'deepseek-account', model: 'deepseek-flash' },
+      { provider: 'zai', model: 'glm-5.3' },
+      { provider: 'custom-route', model: 'glm-5.3-flash' },
+      { provider: 'plan', model: 'qwen3.8-max' },
+      { provider: 'broken', model: 'bad-model' },
+      { provider: 'broken', model: 'no-cost' },
+      { provider: 'arrayish', model: 'x' },
+      { provider: 'missing', model: 'nothing' },
+      { provider: 'deepseek-official', model: 'unlisted' },
+    ])).toEqual({
+      'deepseek-flash': { input: 0.15, output: 0.6, cacheRead: 0.003, provider: 'deepseek' },
+      'glm-5.3': { input: 1.4, output: 4.4, provider: 'zai' },
+      'glm-5.3-flash': { input: 0.12, output: 0.42, provider: 'zhipuai' },
+    })
+    expect(pricesFrom(null, [{ provider: 'deepseek', model: 'deepseek-flash' }])).toEqual({})
+    expect(pricesFrom([], [])).toEqual({})
+  })
+
+  it('downloads the public document and reports HTTP failures', async () => {
+    const fetcher = vi.fn(async () => new Response(JSON.stringify(document), { status: 200 }))
+    const controller = new AbortController()
+    await expect(fetchPrices([{ provider: 'deepseek-official', model: 'deepseek-flash' }], fetcher, controller.signal))
+      .resolves.toEqual({ 'deepseek-flash': { input: 0.15, output: 0.6, cacheRead: 0.003, provider: 'deepseek' } })
+    expect(fetcher).toHaveBeenCalledWith(PRICE_SOURCE_URL, { headers: { accept: 'application/json' }, signal: controller.signal })
+    await fetchPrices([], fetcher)
+    expect(fetcher).toHaveBeenLastCalledWith(PRICE_SOURCE_URL, { headers: { accept: 'application/json' } })
+    const failing = vi.fn(async () => new Response('nope', { status: 503 }))
+    await expect(fetchPrices([], failing)).rejects.toThrow('HTTP 503')
+  })
+})
