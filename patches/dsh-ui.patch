diff --git a/apps/web/tests/citation-sources.e2e.ts b/apps/web/tests/citation-sources.e2e.ts
new file mode 100644
index 0000000000000000000000000000000000000000..148bc023c54fb3e1de69b4376c43d2ca1f845eee
--- /dev/null
+++ b/apps/web/tests/citation-sources.e2e.ts
@@ -0,0 +1,136 @@
+/** Numbered citations render as site-named chips and source chips with local hover/focus linkage, previews, and safe touch navigation. */
+import type { Browser, Page } from 'playwright'
+import { mkdir } from 'node:fs/promises'
+import { join } from 'node:path'
+import { chromium } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it, onTestFailed } from 'vitest'
+import { createAssistantMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SESSION_FORMAT_VERSION, Session, SessionId } from '@deepseek-ai/dsh-session'
+import { launchWebScaffold, seedSession, watchConsole, type WebScaffold } from './scaffold.ts'
+import { saveFailureShot, REPO_ROOT } from './support.ts'
+
+const SOURCE = 'https://citations.example/first'
+const REPLY = [
+  'Citation alpha.[1] Repeated citation.[1]', '',
+  'Citation beta.[2]', '',
+  '- A cited list item.[1]', '',
+  '```ts', 'const source = 1', '```', '',
+  '[1]: https://citations.example/first "A source title long enough to exercise wrapping and truncation at phone widths"',
+  '[2]: https://citations.example/second "Second source"',
+].join('\n')
+
+/** Persist two independent replies containing the same citation number. */
+function citationFixture(): string {
+  const session = Session.create(SessionId('citation-sources-fixture'))
+  for (const turn of [1, 2]) {
+    session.append('turn/start', { turn })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: `Explain source ${turn}. User numeric link [1](https://user.example).` }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('step/start', { turn, step: 1 })
+    session.append('assistant/message', {
+      stream: [], turn, step: 1,
+      message: createAssistantMessage({
+        content: [{ type: 'text', text: turn === 1 ? REPLY : 'Independent reply.[1](https://citations.example/independent)' }],
+        source: { provider: 'fixture', model: 'fixture' },
+      }),
+    }, { surfaceOp: 'append' })
+    session.append('step/end', { turn, step: 1 })
+    session.append('turn/end', { turn, reason: { kind: 'completed' } })
+  }
+  return [
+    JSON.stringify({ type: 'session', version: SESSION_FORMAT_VERSION, id: '{{sessionId}}', createdAt: 0, cwd: '{{cwd}}', isSeeded: false, delegationDepth: 0 }),
+    ...session.snapshotEvents().map(event => JSON.stringify(event)), '',
+  ].join('\n')
+}
+
+describe('web e2e: numbered source citations', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({})
+    await scaffold.ctx.settings.update('ui-chat', { linkOpening: 'new-tab' })
+    await seedSession(scaffold, citationFixture(), 'citation-sources')
+    browser = await chromium.launch()
+    page = await browser.newPage({ viewport: { width: 1680, height: 1000 }, locale: 'en-US', hasTouch: true })
+    await page.context().route('https://citations.example/**', route => route.fulfill({ contentType: 'text/html', body: '<title>Source fixture</title>Source fixture' }))
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+    await page.locator('[role="treeitem"]').first().click()
+    await page.locator('[role="treeitem"]').nth(1).click()
+    await page.getByText('Independent reply.', { exact: false }).waitFor()
+    await page.locator('[data-citation-sources]').nth(1).waitFor()
+  })
+
+  afterAll(async () => {
+    try { await browser?.close() } finally { await scaffold?.close() }
+  })
+
+  it('links body chips and source chips without resetting a collapsed code block', async () => {
+    expect(await page.locator('[data-citation-sources]').count()).toBe(2)
+    onTestFailed(() => saveFailureShot(page, 'citation-sources-desktop'))
+    const reply = page.locator('[data-citation-sources]').first().locator('..')
+    const independent = page.locator('[data-citation-sources]').nth(1).locator('..')
+    const source = reply.locator('[data-citation-kind="source"][data-citation-id="1"]')
+    const marker = reply.locator('[data-citation-kind="reference"][data-citation-id="1"]').first()
+    expect(await reply.locator('[data-citation-kind="reference"]').allTextContents()).toEqual(Array(4).fill('citations.example'))
+    expect(await reply.locator('[data-citation-kind="reference"]').evaluateAll(chips => chips.map(chip => (chip as HTMLElement).dataset['citationId']))).toEqual(['1', '1', '2', '1'])
+    await reply.getByRole('button', { name: 'Collapse code', exact: true }).click()
+    const content = reply.locator('[data-code-block-content]')
+    expect(await content.isHidden()).toBe(true)
+    await source.hover()
+    await expect.poll(() => reply.locator('[data-citation-id="1"][data-citation-state="active"]').count()).toBe(4)
+    expect(await reply.locator('p[data-citation-ids="1"]').getAttribute('data-citation-state')).toBe('active')
+    expect(await independent.locator('[data-citation-state]').count()).toBe(0)
+    const directory = join(REPO_ROOT, '.artifacts/screenshots/citations')
+    await mkdir(directory, { recursive: true })
+    await reply.screenshot({ path: join(directory, 'source-highlight.png'), animations: 'allow' })
+    await marker.hover()
+    expect(await source.getAttribute('data-citation-state')).toBe('active')
+    const preview = page.locator('[role="tooltip"]:has([data-citation-preview])')
+    await preview.waitFor()
+    expect(await preview.textContent()).toContain('citations.example')
+    expect(await marker.getAttribute('aria-describedby')).toBe(await preview.getAttribute('id'))
+    await page.keyboard.press('Escape')
+    await preview.waitFor({ state: 'detached' })
+    await page.mouse.move(0, 0)
+    await expect.poll(() => reply.locator('[data-citation-state]').count()).toBe(0)
+    await page.keyboard.press('Tab')
+    await source.focus()
+    expect(await marker.getAttribute('data-citation-state')).toBe('active')
+    expect(await source.evaluate(element => getComputedStyle(element).outlineStyle)).not.toBe('none')
+    await page.keyboard.press('Tab')
+    expect(await source.getAttribute('data-citation-state')).toBe('muted')
+    expect(await content.isHidden()).toBe(true)
+    expect(await page.getByText('User numeric link', { exact: false }).count()).toBeGreaterThan(0)
+  })
+
+  it('fits source chips at 320px and opens a source from touch without an opener', async () => {
+    onTestFailed(() => saveFailureShot(page, 'citation-sources-phone'))
+    await page.setViewportSize({ width: 320, height: 800 })
+    const source = page.locator('[data-citation-kind="source"][data-citation-id="1"]').first()
+    await source.scrollIntoViewIfNeeded()
+    const geometry = await source.evaluate((element) => {
+      const rect = element.getBoundingClientRect()
+      return { left: rect.left, right: rect.right, width: rect.width, viewport: window.innerWidth }
+    })
+    expect(geometry.left).toBeGreaterThanOrEqual(0)
+    expect(geometry.right).toBeLessThanOrEqual(geometry.viewport + 1)
+    expect(geometry.width).toBeGreaterThan(80)
+    expect(await source.getAttribute('rel')).toBe('noopener noreferrer')
+    const opened = page.waitForEvent('popup')
+    await source.tap()
+    const popup = await opened
+    try {
+      await popup.waitForURL(SOURCE)
+      expect(await popup.evaluate(() => window.opener === null)).toBe(true)
+    } finally {
+      await popup.close()
+    }
+    expect(tripwire.pageErrors).toEqual([])
+    expect(tripwire.warnings).toEqual([])
+  })
+})
