+import { describe, expect, it } from 'vitest'
+import { citationPreviewMaxWidth, placeCitationPreview } from '../src/markdown/preview-placement.ts'
+import type { PreviewPlacementInput } from '../src/markdown/preview-placement.ts'
+
+const base: PreviewPlacementInput = {
+  anchor: { left: 120, right: 180, top: 300, bottom: 322 },
+  column: { left: 100, right: 700 },
+  size: { width: 280, height: 120 },
+  viewport: { width: 1000, height: 800 },
+  topInset: 8,
+  gap: 8,
+}
+
+describe('citation preview placement', () => {
+  it('bounds the card width by the preferred width, the column, and the viewport edges', () => {
+    expect(citationPreviewMaxWidth({ left: 100, right: 700 }, 1000, 320)).toBe(320)
+    expect(citationPreviewMaxWidth({ left: 100, right: 340 }, 1000, 320)).toBe(240)
+    expect(citationPreviewMaxWidth({ left: -50, right: 1200 }, 400, 1500)).toBe(384)
+    expect(citationPreviewMaxWidth({ left: 600, right: 560 }, 1000, 320)).toBe(0)
+  })
+
+  it('opens below the chip, left-aligned with it, when the card fits', () => {
+    expect(placeCitationPreview(base)).toEqual({ left: 120, top: 330 })
+  })
+
+  it('shifts left to stay inside the right edge of the column', () => {
+    const placement = placeCitationPreview({ ...base, anchor: { left: 600, right: 660, top: 300, bottom: 322 } })
+    expect(placement.left).toBe(420)
+    expect(placement.left + 280).toBe(700)
+  })
+
+  it('never starts left of the column', () => {
+    expect(placeCitationPreview({ ...base, anchor: { left: 40, right: 90, top: 300, bottom: 322 } }).left).toBe(100)
+  })
+
+  it('stays inside the viewport when the column reaches past it', () => {
+    const placement = placeCitationPreview({
+      ...base, column: { left: -50, right: 1200 }, anchor: { left: 950, right: 990, top: 300, bottom: 322 },
+    })
+    expect(placement.left).toBe(712)
+  })
+
+  it('caps the width at the column width and pins narrow columns to their left edge', () => {
+    const placement = placeCitationPreview({
+      ...base, column: { left: 20, right: 260 }, anchor: { left: 200, right: 240, top: 300, bottom: 322 },
+    })
+    expect(placement).toEqual({ left: 20, top: 330 })
+  })
+
+  it('opens above the chip when there is no room below but there is above', () => {
+    const placement = placeCitationPreview({ ...base, anchor: { left: 120, right: 180, top: 700, bottom: 722 } })
+    expect(placement.top).toBe(700 - 8 - 120)
+  })
+
+  it('takes the roomier side, clamped, when neither side fits', () => {
+    const tall = { ...base, size: { width: 280, height: 500 }, viewport: { width: 1000, height: 600 } }
+    const lower = placeCitationPreview({ ...tall, anchor: { left: 120, right: 180, top: 200, bottom: 222 } })
+    expect(lower.top).toBe(92)
+    const upper = placeCitationPreview({ ...tall, anchor: { left: 120, right: 180, top: 400, bottom: 422 } })
+    expect(upper.top).toBe(8)
+  })
+
+  it('keeps a card taller than the viewport pinned at the top inset', () => {
+    const placement = placeCitationPreview({ ...base, size: { width: 280, height: 900 }, topInset: 40 })
+    expect(placement.top).toBe(40)
+  })
+
+  it('respects the top inset reserved by the application frame', () => {
+    const placement = placeCitationPreview({
+      ...base, anchor: { left: 120, right: 180, top: 300, bottom: 322 }, size: { width: 280, height: 330 },
+      viewport: { width: 1000, height: 400 }, topInset: 48,
+    })
+    expect(placement.top).toBe(48)
+  })
+})
