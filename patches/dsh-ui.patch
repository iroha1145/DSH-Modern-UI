+describe('webSearch projection fold', () => {
+  function fold(events: readonly SessionEvent[]): WebSearchUnitState {
+    let state: WebSearchUnitState = webSearchProjectionDefinition.init()
+    for (const event of events) state = webSearchProjectionDefinition.apply(state, event)
+    return state
+  }
+
+  function view(events: readonly SessionEvent[]): WebSearchProjection {
+    return webSearchProjectionDefinition.wire.view(fold(events))
+  }
+
+  it('folds the command lifecycle into pending and the last web/search into the logged state', () => {
+    const log = Session.create(SessionId('fold-log'))
+    expect(view(log.snapshotEvents())).toEqual({ enabled: true, pending: false })
+    log.append('command/run', { commandId: CommandId('c1'), name: 'web', args: ' off', source: { kind: 'user' } })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: true, pending: false })
+    log.append('command/done', { commandId: CommandId('c1'), kind: 'success' })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: true, pending: true })
+    log.append('web/search', { enabled: false })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: false, pending: false })
+    log.append('command/run', { commandId: CommandId('c2'), name: 'web', args: 'on', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('c2'), kind: 'error', text: 'failed' })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: false, pending: false })
+    log.append('command/run', { commandId: CommandId('c3'), name: 'web', args: ' off', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('c3'), kind: 'success' })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: false, pending: false })
+    log.append('command/run', { commandId: CommandId('c4'), name: 'web', args: ' on', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('c4'), kind: 'success' })
+    expect(view(log.snapshotEvents())).toEqual({ enabled: false, pending: true })
+  })
+
+  it('returns the same state for records that select nothing', () => {
+    const before = fold([])
+    const log = Session.create(SessionId('fold-ignored'))
+    log.append('command/run', { commandId: CommandId('other'), name: 'compact', args: '', source: { kind: 'user' } })
+    log.append('command/run', { commandId: CommandId('no-input'), name: 'web', source: { kind: 'user' } })
+    log.append('command/run', { commandId: CommandId('bad'), name: 'web', args: ' maybe', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('bad'), kind: 'error', text: 'Use /web on or /web off.' })
+    log.append('command/done', { commandId: CommandId('constructor'), kind: 'success' })
+    for (const event of log.snapshotEvents()) {
+      expect(webSearchProjectionDefinition.apply(before, event)).toBe(before)
+    }
+  })
+
+  it('restores successful targets through usable checkpoints and full replay with missing or older checkpoints', async () => {
+    const ctx = new Context()
+    mounted.push(ctx)
+    await ctx.plugin(SessionProjectionRegistry)
+    await ctx.sessionProjections.register(webSearchProjectionDefinition)
+    const log = Session.create(SessionId('checkpoint-selection'))
+    log.append('command/run', { commandId: CommandId('off'), name: 'web', args: ' off', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('off'), kind: 'success' })
+    const checkpoint = ctx.sessionProjections.checkpoint(log)
+    const offset = SessionLogOffset(log.snapshotEvents().length)
+    log.append('command/run', { commandId: CommandId('on-failed'), name: 'web', args: ' on', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('on-failed'), kind: 'error' })
+    const events = log.snapshotEvents()
+    const restored = ctx.sessionProjections.restore(checkpoint, events.slice(offset), offset, log.header, log.inheritedEventCount)
+    const full = ctx.sessionProjections.restore({}, events, SessionLogOffset(0), log.header, log.inheritedEventCount)
+    expect(restored).toEqual(full)
+    expect(restored.snapshot.values.webSearch).toEqual({ enabled: true, pending: true })
+    expect(restored.checkpoint.webSearch?.val).toMatchObject({ running: {} })
+    const previous = checkpoint.webSearch
+    if (previous === undefined) throw new Error('missing webSearch checkpoint')
+    const stale = { webSearch: { ...previous, ver: 1 } }
+    expect(ctx.sessionProjections.restore(stale, events, SessionLogOffset(0), log.header, log.inheritedEventCount)).toEqual(full)
+    expect(() => ctx.sessionProjections.restore(stale, events.slice(offset), offset, log.header, log.inheritedEventCount))
+      .toThrow('re-read from seq 0')
+    expect(() => ctx.sessionProjections.restore({}, events.slice(offset), offset, log.header, log.inheritedEventCount))
+      .toThrow('re-read from seq 0')
+  })
+
+  it('reuses one view object per visible value', () => {
+    const log = Session.create(SessionId('fold-views'))
+    const first = view(log.snapshotEvents())
+    log.append('command/run', { commandId: CommandId('c1'), name: 'web', args: ' on', source: { kind: 'user' } })
+    log.append('command/done', { commandId: CommandId('c1'), kind: 'success' })
+    expect(view(log.snapshotEvents())).toBe(first)
+  })
+})
