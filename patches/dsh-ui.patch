+    serverHits.length = 0
+    await page.route(`${networkOrigin}/**`, async (route) => { routes.push(route.request().url()); await route.continue() })
+    page.on('request', (request) => { if (request.url().startsWith(networkOrigin)) network.push(request.url()) })
+    page.on('requestfailed', (request) => {
+      if (request.url().startsWith(networkOrigin)) failures.push({ url: request.url(), error: request.failure()?.errorText })
