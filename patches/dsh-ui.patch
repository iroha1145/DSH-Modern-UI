+}
+
+.animate-fade-in {
+  animation: fade-in var(--dsh-feel-dialog-duration) var(--dsh-feel-dialog-curve) both;
+}
+
+.animate-pop-in {
+  animation: pop-in var(--dsh-feel-dialog-duration) var(--dsh-feel-dialog-curve) both;
+}
+
+@keyframes pixel-on {
+  0%,
+  100% {
+    opacity: 0.18;
+    transform: scale(0.88);
+  }
+  50% {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.animate-spin-slow {
+  animation: spin 1.1s linear infinite;
+}
+
+@keyframes eq-bounce {
+  0%,
+  100% {
+    transform: scaleY(0.3);
+  }
+  50% {
+    transform: scaleY(1);
+  }
 }
 
