index 0000000000000000000000000000000000000000..3782ac1a28398aedd933b442c72906e7cf8d677d
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/presets.ts
@@ -0,0 +1,150 @@
+/**
+ * Built-in picker details for well-known models, keyed by the model id their
+ * vendor publishes. Strength ratings run from 1 to 5 and are editorial
+ * starting points; prices are the vendor's own list prices as recorded by the
+ * public price source (US dollars per million tokens, 2026-10-25), never a
+ * reseller's. Users override any field from the Models settings page, and a
+ * price refresh replaces the recorded prices.
+ */
+
+/** Description keys under the `preset.` locale prefix. */
+export type PresetBlurb =
+  | 'hardest' | 'complex' | 'everyday' | 'quick' | 'reasoning' | 'multimodal' | 'balanced' | 'cheapest'
+  | 'longContext' | 'highspeed' | 'coding' | 'chinese' | 'value' | 'agents' | 'light' | 'agentTasks'
+  | 'budget' | 'realtime'
+
+/** Every description key, in dictionary order. */
+export const PRESET_BLURBS: readonly PresetBlurb[] = [
+  'hardest', 'complex', 'everyday', 'quick', 'reasoning', 'multimodal', 'balanced', 'cheapest',
+  'longContext', 'highspeed', 'coding', 'chinese', 'value', 'agents', 'light', 'agentTasks',
+  'budget', 'realtime',
+]
+
+/** Monogram per vendor, so models of one family share a tile. */
+const VENDOR_GLYPHS = {
+  anthropic: 'A',
+  openai: 'O',
+  google: 'G',
+  moonshotai: 'K',
+  alibaba: 'Q',
+  zhipuai: 'Z',
+  minimax: 'M',
+  deepseek: 'D',
+  xai: 'X',
+} as const
+
+/** Price-source provider ids of the vendors with presets. */
+export type PresetVendor = keyof typeof VENDOR_GLYPHS
+
+/** One model's built-in picker details. */
+export interface ModelPreset {
+  /** Price-source provider id of the model's vendor. */
+  readonly vendor: PresetVendor
+  /** Description key under `preset.`. */
+  readonly blurb: PresetBlurb
+  /** Relative response speed, 1 (slowest) to 5 (fastest). */
+  readonly speed: number
+  /** Relative answer quality, 1 to 5. */
+  readonly quality: number
+  /** Typical wait for the first token with thinking off, in milliseconds. */
+  readonly latencyMs: number
+  /** Vendor list price in US dollars per million tokens. */
+  readonly price: { readonly input: number; readonly output: number; readonly cacheRead?: number }
+  /**
+   * Reasoning levels the vendor's API accepts, in escalation order, as pi-ai's
+   * model data (1.3.0, 2026-10-25) records them — or, for a model newer than
+   * that data, as the vendor's own model listing reports them. Where a route
+   * advertises a broader generic list, the picker offers only these. DeepSeek's
+   * own adapter declares its models' levels, so DeepSeek presets carry none.
+   */
+  readonly efforts?: readonly string[]
+}
+
+/** Speed, quality, and first-token wait by size tier. */
+const TIERS = {
+  top: { speed: 1, quality: 5, latencyMs: 2600 },
+  large: { speed: 2, quality: 5, latencyMs: 1800 },
+  mid: { speed: 4, quality: 4, latencyMs: 900 },
+  small: { speed: 5, quality: 3, latencyMs: 450 },
+} as const
+
+function preset(
+  vendor: PresetVendor, blurb: PresetBlurb, tier: keyof typeof TIERS,
+  input: number, output: number, cacheRead?: number, efforts?: string,
+): ModelPreset {
+  return {
+    vendor,
+    blurb,
+    ...TIERS[tier],
+    price: cacheRead === undefined ? { input, output } : { input, output, cacheRead },
+    ...efforts === undefined ? {} : { efforts: efforts.split(' ') },
+  }
+}
+
+/** Built-in details keyed by lower-case model id. */
+const PRESETS: ReadonlyMap<string, ModelPreset> = new Map<string, ModelPreset>([
+  ['claude-fable-5-1', preset('anthropic', 'hardest', 'top', 10, 50, 0.25, 'minimal low medium high xhigh max')],
+  ['claude-opus-5-5', preset('anthropic', 'complex', 'large', 4, 20, 0.2, 'low medium high xhigh max')],
+  ['claude-sonnet-5-5', preset('anthropic', 'everyday', 'mid', 2, 10, 0.1, 'low medium high xhigh max')],
+  ['claude-haiku-5-5', preset('anthropic', 'quick', 'small', 0.1, 0.5, 0.01, 'off low medium high xhigh max')],
+  ['gpt-6-astra', preset('openai', 'reasoning', 'top', 10, 50, 1, 'low medium high xhigh max')],
+  ['gpt-6.1-sol', preset('openai', 'everyday', 'mid', 2, 10, 0.1, 'low medium high xhigh max')],
+  ['gpt-6-luna', preset('openai', 'quick', 'small', 0.1, 0.5, 0.01)],
+  ['gemini-4-argon', preset('google', 'multimodal', 'large', 2, 10, 0.1, 'low medium high')],
+  ['gemini-3.8-flash', preset('google', 'balanced', 'mid', 0.75, 3.75, 0.075, 'low medium high')],
+  ['gemini-flash-lite-latest', preset('google', 'cheapest', 'small', 0.3, 2.5, 0.03, 'minimal low medium high')],
+  ['kimi-k3.1-pro', preset('moonshotai', 'longContext', 'large', 2, 10, 0.2, 'low high max')],
+  ['kimi-k3.1-pro-highspeed', preset('moonshotai', 'highspeed', 'mid', 4, 20, 0.2)],
+  ['kimi-k3', preset('moonshotai', 'complex', 'large', 3, 15, 0.3, 'low high max')],
+  ['kimi-k2.7-code', preset('moonshotai', 'coding', 'mid', 0.95, 4, undefined, 'minimal low medium high')],
+  ['qwen3.8-max', preset('alibaba', 'chinese', 'large', 2, 6, 0.25, 'low medium xhigh')],
+  ['qwen3.8-flash', preset('alibaba', 'value', 'small', 0.15, 0.47, 0.016, 'low medium xhigh')],
+  ['glm-5.3', preset('zhipuai', 'agents', 'large', 1.19516, 4.18306, 0.29879, 'low high max')],
+  ['glm-5.3-flash', preset('zhipuai', 'light', 'small', 0.11952, 0.41831, 0.03436, 'low high max')],
+  ['minimax-m3', preset('minimax', 'agentTasks', 'mid', 0.3, 1.2, 0.06)],
+  ['minimax-m3.1-flash', preset('minimax', 'budget', 'small', 0.15, 0.6, 0.015)],
+  ['deepseek-v4-pro', preset('deepseek', 'reasoning', 'large', 0.66, 1.98, 0.022)],
+  ['deepseek-flash', preset('deepseek', 'everyday', 'mid', 0.15, 0.6, 0.003)],
+  ['grok-4.7', preset('xai', 'realtime', 'large', 2, 6, 0.5, 'low medium high xhigh')],
+])
+
+/** Other published ids of the same model. */
+const ALIASES: ReadonlyMap<string, string> = new Map([
+  ['k3', 'kimi-k3'],
+  ['k3.1-pro', 'kimi-k3.1-pro'],
+  ['k3.1-pro-highspeed', 'kimi-k3.1-pro-highspeed'],
+  ['deepseek-v4-flash', 'deepseek-flash'],
+  ['deepseek-v4.1-flash', 'deepseek-flash'],
+])
+
+/** The id a preset lookup tries: last path segment, lower case. */
+function normalize(modelId: string): string {
+  return modelId.slice(modelId.lastIndexOf('/') + 1).toLowerCase()
+}
+
+/**
+ * Find a model's built-in details: the exact id, a known alias, or the id
+ * without a trailing release-date suffix (`-0813`, `-20251001`).
+ * @param modelId - provider-owned model id; a `vendor/model` route id also matches.
+ * @returns the preset, or undefined for models without one.
+ */
+export function presetFor(modelId: string): ModelPreset | undefined {
+  const id = normalize(modelId)
+  const direct = PRESETS.get(ALIASES.get(id) ?? id)
+  if (direct !== undefined) return direct
+  const undated = id.replace(/-\d{4}(?:\d{4})?$/, '')
+  return undated === id ? undefined : PRESETS.get(ALIASES.get(undated) ?? undated)
+}
+
+/**
+ * The tile monogram: the vendor's letter for preset models, otherwise the
+ * first letter or digit of the display name.
+ * @param modelName - catalog display name.
+ * @param preset - the model's preset, when it has one.
+ * @returns one upper-case character, or an empty string for names without one.
+ */
+export function glyphFor(modelName: string, preset: ModelPreset | undefined): string {
+  if (preset !== undefined) return VENDOR_GLYPHS[preset.vendor]
+  const match = /[\p{L}\p{N}]/u.exec(modelName)
+  return match === null ? '' : match[0].toUpperCase()
+}
diff --git a/packages/client/ui-model-selection/src/client/price-source.ts b/packages/client/ui-model-selection/src/client/price-source.ts
new file mode 100644
index 0000000000000000000000000000000000000000..adc389e3e47d85c3292a4b3b3c96631398359652
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/price-source.ts
@@ -0,0 +1,102 @@
+/**
+ * Price refresh from the public price source (models.dev), which records
+ * vendors' list prices in US dollars per million tokens. A model's price is
+ * read from the provider its route bills through first, then from its preset
+ * vendor; other providers listing the same id are never consulted. Entries
+ * whose input and output are both zero are plan-included or unpriced, so
+ * they are skipped rather than shown as free.
+ */
+import type { FetchedModelPrice } from '../model-settings.ts'
+import { presetFor } from './presets.ts'
+
+/** The public price source's full catalog document. */
+export const PRICE_SOURCE_URL = 'https://models.dev/api.json'
+
+/** Routes whose prices live under another price-source provider id. */
+const ROUTE_VENDORS: ReadonlyMap<string, string> = new Map([
+  ['deepseek-official', 'deepseek'],
+  ['deepseek-account', 'deepseek'],
+])
+
+/** One catalog route and model whose price to look up. */
+export interface PricedModel {
+  /** Catalog provider (route) id. */
+  readonly provider: string
+  /** Provider-owned model id. */
+  readonly model: string
+}
+
+/** Price-source providers to try for one model, most specific first. */
+function vendorsOf(entry: PricedModel): string[] {
+  const route = ROUTE_VENDORS.get(entry.provider) ?? entry.provider
+  const vendor = presetFor(entry.model)?.vendor
+  return vendor === undefined || vendor === route ? [route] : [route, vendor]
+}
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
+}
+
+function amount(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined
+}
+
+/** One provider's listed price for a model id, matched exactly, then case-insensitively. */
+function listed(source: Record<string, unknown>, provider: string, model: string): FetchedModelPrice | undefined {
+  const models = record(record(source[provider])?.models)
+  if (models === undefined) return undefined
+  const key = Object.hasOwn(models, model)
+    ? model
+    : Object.keys(models).find(candidate => candidate.toLowerCase() === model.toLowerCase())
+  const cost = key === undefined ? undefined : record(record(models[key])?.cost)
+  const input = amount(cost?.input)
+  const output = amount(cost?.output)
+  if (input === undefined || output === undefined || (input === 0 && output === 0)) return undefined
+  const cacheRead = amount(cost?.cache_read)
+  return cacheRead === undefined ? { input, output, provider } : { input, output, cacheRead, provider }
+}
+
+/**
+ * Read prices for catalog models out of a price-source document.
+ * @param source - the parsed document; anything malformed yields no prices.
+ * @param models - routes and models to price; the first route listing a model id wins.
+ * @returns prices keyed by model id, only for models the source lists.
+ */
+export function pricesFrom(source: unknown, models: readonly PricedModel[]): Record<string, FetchedModelPrice> {
+  const document = record(source)
+  const prices: Record<string, FetchedModelPrice> = {}
+  if (document === undefined) return prices
+  for (const entry of models) {
+    if (Object.hasOwn(prices, entry.model)) continue
+    for (const vendor of vendorsOf(entry)) {
+      const price = listed(document, vendor, entry.model)
+      if (price !== undefined) {
+        prices[entry.model] = price
+        break
+      }
+    }
+  }
+  return prices
+}
+
+/**
+ * Download the price-source document and read the catalog models' prices.
+ * @param models - routes and models to price.
+ * @param fetcher - the browser fetch (injected for tests).
+ * @param signal - aborts the download.
+ * @returns prices keyed by model id.
+ * @throws when the download fails or the response is not JSON.
+ */
+export async function fetchPrices(
+  models: readonly PricedModel[],
+  fetcher: typeof fetch,
+  signal?: AbortSignal,
+): Promise<Record<string, FetchedModelPrice>> {
+  const response = await fetcher(PRICE_SOURCE_URL, {
+    headers: { accept: 'application/json' },
+    ...signal === undefined ? {} : { signal },
+  })
+  if (!response.ok) throw new Error(`HTTP ${String(response.status)}`)
+  const document: unknown = await response.json()
+  return pricesFrom(document, models)
+}
diff --git a/packages/client/ui-model-selection/src/client/profiles.ts b/packages/client/ui-model-selection/src/client/profiles.ts
new file mode 100644
index 0000000000000000000000000000000000000000..41a3925f7edf42a2e70a7e09ef142f28bd4443a5
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/profiles.ts
@@ -0,0 +1,213 @@
+/**
+ * Picker profile of one catalog model — its built-in preset, the user's
+ * overrides, and the last price refresh combined into what a picker row
+ * shows — plus the effort helpers the thinking switch and effort pills share.
+ * Effort levels always come from the catalog: the adapter advertises what
+ * the model accepts, a preset narrows a generic list to the vendor's own
+ * levels, and a user's effort list narrows it instead.
+ */
+import type { ModelCatalogModel, ModelReasoningEffort } from '@deepseek-ai/dsh-api-session-controller/types'
+import { LETTER_ICON, type ModelPickerSettings } from '../model-settings.ts'
+import type { ModelKey } from './locales.ts'
+import { glyphFor, presetFor, type ModelPreset, type PresetBlurb } from './presets.ts'
+import { autoMark, isVendorMark, type VendorMark } from './vendor-marks.ts'
+
+/** Effort ids that switch thinking off. */
+const OFF_EFFORTS: ReadonlySet<string> = new Set(['off', 'none'])
+
+/** Localized short names of the effort ids adapters commonly advertise; others show the catalog name. */
+export const EFFORT_SHORT: ReadonlyMap<string, ModelKey> = new Map<string, ModelKey>([
+  ['off', 'effort.short.off'],
+  ['none', 'effort.short.none'],
+  ['minimal', 'effort.short.minimal'],
+  ['low', 'effort.short.low'],
+  ['medium', 'effort.short.medium'],
+  ['high', 'effort.short.high'],
+  ['xhigh', 'effort.short.xhigh'],
+  ['max', 'effort.short.max'],
+])
+
+/** First-token wait multiplier of the weakest thinking level; each stronger level multiplies it again, up to the cap. */
+const THINKING_BASE = 1.6
+const THINKING_STEP = 1.55
+const THINKING_CAP = 8
+
+/** Highest output price (US dollars per million tokens) of cost tiers 1 to 4; anything above is tier 5. */
+const COST_TIER_TOPS = [1, 3, 8, 20] as const
+
+/** Which layer supplied a profile's price. */
+export type PriceSource = 'user' | 'fetched' | 'preset'
+
+/** What one picker row shows for a model. */
+export interface ModelProfile {
+  /** Tile monogram; empty when the name has no letter or digit. */
+  readonly glyph: string
+  /** Vendor mark drawn instead of the monogram; undefined keeps the letter. */
+  readonly mark: VendorMark | undefined
+  /** The user's description, else the catalog's when no preset blurb applies. */
+  readonly description: string | undefined
+  /** Built-in description key, shown when the user wrote none. */
+  readonly blurb: PresetBlurb | undefined
+  /** Relative response speed, 1 to 5. */
+  readonly speed: number | undefined
+  /** Relative answer quality, 1 to 5. */
+  readonly quality: number | undefined
+  /** Relative price, 1 to 5: the user's rating, else derived from the output price. */
+  readonly cost: number | undefined
+  /** Typical first-token wait with thinking off, in milliseconds. */
+  readonly latencyMs: number | undefined
+  /** Input price in US dollars per million tokens. */
+  readonly priceInput: number | undefined
+  /** Output price in US dollars per million tokens. */
+  readonly priceOutput: number | undefined
+  /** Layer the prices came from; undefined when the model has none. */
+  readonly priceSource: PriceSource | undefined
+  /** Effort levels the picker offers, in catalog order. */
+  readonly efforts: readonly ModelReasoningEffort[]
+}
+
+/**
+ * Cost rating from an output price.
+ * @param output - output price in US dollars per million tokens.
+ * @returns 1 (cheapest) to 5.
+ */
+export function costTier(output: number): number {
+  const index = COST_TIER_TOPS.findIndex(top => output <= top)
+  return index === -1 ? 5 : index + 1
+}
+
+/**
+ * The levels a model offers before any user choice: the advertised levels its
+ * preset names, or every advertised level when the preset names none of them
+ * or the model has no preset levels.
+ * @param modelId - provider-owned model id.
+ * @param advertised - the levels the catalog advertises for it.
+ * @returns the default levels in catalog order.
+ */
+export function presetEfforts(modelId: string, advertised: readonly ModelReasoningEffort[]): readonly ModelReasoningEffort[] {
+  const known = presetFor(modelId)?.efforts
+  if (known === undefined) return advertised
+  const kept = advertised.filter(effort => known.includes(effort.id))
+  return kept.length === 0 ? advertised : kept
+}
+
+/**
+ * The tile's mark: the user's choice, else the automatic one. Choosing the
+ * letter, or a mark id this build does not know, keeps the monogram or the
+ * automatic mark respectively.
+ * @param model - the exact catalog entry.
+ * @param preset - the model's preset, when it has one.
+ * @param icon - the user's stored choice, if any.
+ * @returns the mark id, or undefined for the monogram.
+ */
+function markOf(model: ModelCatalogModel, preset: ModelPreset | undefined, icon: string | undefined): VendorMark | undefined {
+  if (icon === LETTER_ICON) return undefined
+  if (icon !== undefined && isVendorMark(icon)) return icon
+  return autoMark(model.id, model.name, preset)
+}
+
+/**
+ * Combine a catalog model with its preset, the user's overrides, and fetched prices.
+ * Precedence per field: the user's value, then a fetched price, then the preset,
+ * then the catalog. A user's effort list narrows the catalog's levels and is
+ * ignored when nothing it names is advertised; without one, the preset's levels apply.
+ * @param model - the exact catalog entry.
+ * @param settings - the picker's settings section, when loaded.
+ * @returns the row's profile.
+ */
+export function profileOf(model: ModelCatalogModel, settings: ModelPickerSettings | undefined): ModelProfile {
+  const preset = presetFor(model.id)
+  const user = settings?.models?.[model.id]
+  const fetched = settings?.prices?.[model.id]
+  const userPrice = user?.priceInput !== undefined || user?.priceOutput !== undefined
+  const priceInput = user?.priceInput ?? fetched?.input ?? preset?.price.input
+  const priceOutput = user?.priceOutput ?? fetched?.output ?? preset?.price.output
+  const priceSource: PriceSource | undefined = userPrice
+    ? 'user'
+    : fetched !== undefined ? 'fetched' : preset === undefined ? undefined : 'preset'
+  const advertised = model.reasoning?.efforts ?? []
+  const wanted = user?.efforts === undefined ? undefined : new Set(user.efforts)
+  const narrowed = wanted === undefined ? [] : advertised.filter(effort => wanted.has(effort.id))
+  return {
+    glyph: glyphFor(model.name, user?.icon === LETTER_ICON ? undefined : preset),
+    mark: markOf(model, preset, user?.icon),
+    description: user?.description ?? (preset === undefined ? model.description : undefined),
+    blurb: user?.description === undefined ? preset?.blurb : undefined,
+    speed: user?.speed ?? preset?.speed,
+    quality: user?.quality ?? preset?.quality,
+    cost: user?.cost ?? (priceOutput === undefined ? undefined : costTier(priceOutput)),
+    latencyMs: user?.latencyMs ?? preset?.latencyMs,
+    priceInput,
+    priceOutput,
+    priceSource,
+    efforts: narrowed.length === 0 ? presetEfforts(model.id, advertised) : narrowed,
+  }
+}
+
+/**
+ * Whether an effort id switches thinking off.
+ * @param effort - effort id.
+ * @returns true for `off` and `none`.
+ */
+export function isOffEffort(effort: string): boolean {
+  return OFF_EFFORTS.has(effort)
+}
+
+/**
+ * The levels the picker shows: the profile's offered levels plus the current
+ * one when the user's list hides it, so the shown state stays truthful.
+ * @param offered - the profile's offered levels.
+ * @param advertised - every level the catalog advertises.
+ * @param current - the selection's effort id.
+ * @returns visible levels in catalog order.
+ */
+export function visibleEfforts(
+  offered: readonly ModelReasoningEffort[],
+  advertised: readonly ModelReasoningEffort[],
+  current: string | undefined,
+): readonly ModelReasoningEffort[] {
+  if (current === undefined || offered.some(effort => effort.id === current)) return offered
+  const shown = new Set([...offered.map(effort => effort.id), current])
+  return advertised.filter(effort => shown.has(effort.id))
+}
+
+/**
+ * The thinking level a model switch or a thinking-on gesture applies: the
+ * level in use when the target offers it, so a chosen strength survives the
+ * switch, else the catalog default, else `high`, `medium`, or the strongest.
+ * @param efforts - levels the picker offers for the target model.
+ * @param catalogDefault - the target model's catalog default.
+ * @param carried - the effort in use before the switch or gesture.
+ * @returns an effort id, or undefined when the model advertises no thinking level.
+ */
+export function preferredEffort(
+  efforts: readonly ModelReasoningEffort[],
+  catalogDefault: string | undefined,
+  carried: string | undefined,
+): string | undefined {
+  const thinking = efforts.filter(effort => !isOffEffort(effort.id))
+  const ids = new Set(thinking.map(effort => effort.id))
+  for (const candidate of [carried, catalogDefault, 'high', 'medium']) {
+    if (candidate !== undefined && ids.has(candidate)) return candidate
+  }
+  return thinking.at(-1)?.id
+}
+
+/**
+ * First-token wait under a thinking level: the base wait times a factor that
+ * grows with the level's rank among the thinking levels.
+ * @param latencyMs - base wait with thinking off.
+ * @param efforts - levels the picker offers.
+ * @param effort - the selected effort id.
+ * @returns milliseconds, or undefined without a base wait.
+ */
+export function thinkingLatency(
+  latencyMs: number | undefined,
+  efforts: readonly ModelReasoningEffort[],
+  effort: string | undefined,
+): number | undefined {
+  if (latencyMs === undefined) return undefined
+  if (effort === undefined || isOffEffort(effort)) return latencyMs
+  const rank = efforts.filter(level => !isOffEffort(level.id)).findIndex(level => level.id === effort)
+  return latencyMs * Math.min(THINKING_BASE * THINKING_STEP ** Math.max(rank, 0), THINKING_CAP)
+}
