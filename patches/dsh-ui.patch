+// @vitest-environment jsdom
+import { afterEach, describe, expect, it } from 'vitest'
+import { defaultHostStyle, frameStyles, iconsFor, readHostStyle } from '../src/client/design-system.ts'
+import { ICONS } from '../src/client/icons.ts'
+
+afterEach(() => { document.body.replaceChildren() })
+
+describe('frame design system', () => {
+  it('captures chat typography and colors and rejects values outside the allowlist', () => {
+    const wrapper = document.createElement('div')
+    wrapper.style.background = 'rgb(23, 23, 23)'
+    const element = document.createElement('div')
+    element.style.color = 'rgb(237, 237, 237)'
+    element.style.fontSize = '15px'
+    element.style.setProperty('--ink-2', '#b0b0b0')
+    element.style.setProperty('--line', '} body { display: none')
+    wrapper.appendChild(element)
+    document.body.appendChild(wrapper)
+    const host = readHostStyle(element, 'dark')
+    expect(host.fg).toBe('rgb(237, 237, 237)')
+    expect(host.fontSize).toBe('15px')
+    expect(host.bg).toBe('rgb(23, 23, 23)')
+    expect(host.muted).toBe('#b0b0b0')
+    expect(host.line).toBe(defaultHostStyle('dark').line)
+  })
+  it('selects icon geometry for mentioned names and aliases only', () => {
+    const icons = iconsFor('<i data-icon="shield-check"></i><i data-icon="alert-triangle"></i><i data-icon="no-such-icon"></i>')
+    expect(icons['shield-check']).toBe(ICONS['shield-check'])
+    expect(icons['alert-triangle']).toBe(ICONS['triangle-alert'])
+    expect(icons).not.toHaveProperty('no-such-icon')
+    const shapes = /^(<(path|circle|rect|line|polyline|polygon|ellipse)( [a-z0-9-]+="[^"<>]*")+\/>)+$/
+    for (const markup of Object.values(ICONS)) expect(markup).toMatch(shapes)
+  })
+  it('keeps one entry for an icon named more than once', () => {
+    expect(Object.keys(iconsFor('<i data-icon="shield-check"></i><i data-icon="shield-check"></i>'))).toEqual(['shield-check'])
+  })
+  it('emits palette-specific tokens, OpenIntelligentUI color classes, and the component kit', () => {
+    const light = frameStyles('light', defaultHostStyle('light'))
+    const dark = frameStyles('dark', defaultHostStyle('dark'))
+    expect(light).toContain('color-scheme:light')
+    expect(dark).toContain('color-scheme:dark')
+    expect(light).toContain('fill:#E6F1FB;stroke:#185FA5')
+    expect(dark).toContain('fill:#0C447C;stroke:#85B7EB')
+    for (const name of ['.ui-card', '.ui-grid', '.ui-list', '.ui-tag', '.ui-flow', '.ui-arrow', '.ui-steps', '.ui-stats', '.ui-profile', '.ui-callout', '--color-text-primary']) {
+      expect(light).toContain(name)
+    }
+    expect(light).toContain('background:transparent')
+  })
+})
