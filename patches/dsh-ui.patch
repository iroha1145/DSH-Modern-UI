diff --git a/packages/web/web-fetch-http/tests/malformed-response.spec.ts b/packages/web/web-fetch-http/tests/malformed-response.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c6d14eca91b767a2e050c0e3a09b6dc4255bea44
--- /dev/null
+++ b/packages/web/web-fetch-http/tests/malformed-response.spec.ts
@@ -0,0 +1,36 @@
+/** Malformed loopback responses fail one fetch without preventing subsequent fetches. */
+import { createServer } from 'node:http'
+import { once } from 'node:events'
+import { expect, it } from 'vitest'
+import { HttpFetchProvider } from '../src/provider.ts'
+
+it('contains malformed gzip and disconnected bodies, then fetches a healthy response', async () => {
+  const server = createServer((request, response) => {
+    if (request.url === '/gzip') {
+      response.writeHead(200, { 'content-type': 'text/plain', 'content-encoding': 'gzip' })
+      response.end('not a gzip stream')
+    } else if (request.url === '/disconnect') {
+      response.writeHead(200, { 'content-type': 'text/plain', 'content-length': '1000', 'content-encoding': 'gzip' })
+      response.write(Buffer.from([0x1f, 0x8b, 0x08]))
+      response.flushHeaders()
+      setImmediate(() => response.destroy())
+    } else {
+      response.writeHead(200, { 'content-type': 'text/plain' })
+      response.end('healthy')
+    }
+  })
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+  const address = server.address()
+  if (address === null || typeof address === 'string') throw new Error('Expected TCP address')
+  const base = `http://127.0.0.1:${address.port}`
+  const provider = new HttpFetchProvider({ maxResponseBytes: 4096, maxBodyChars: 4096, timeoutMs: 2000, maxRedirects: 2, userAgent: 'fixture' })
+  try {
+    await expect(provider.fetch({ url: `${base}/gzip` })).rejects.toMatchObject({ code: 'WEB_PROVIDER_ERROR' })
+    await expect(provider.fetch({ url: `${base}/disconnect` })).rejects.toMatchObject({ code: 'WEB_PROVIDER_ERROR' })
+    expect((await provider.fetch({ url: `${base}/healthy` })).body.content).toBe('healthy')
+  } finally {
+    server.closeAllConnections()
+    await new Promise<void>((resolve, reject) => server.close((error) => { if (error) reject(error); else resolve() }))
+  }
+})
