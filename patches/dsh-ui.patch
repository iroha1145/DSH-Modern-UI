+/* Inline chip: a pill named after the cited site, seated on the text baseline. */
+.chip {
+  display: inline-block;
+  box-sizing: border-box;
+  margin-inline: 0.22em 0.08em;
+  padding: 0.02em 0.55em 0.08em;
