+/**
+ * The Models settings card's controller over a stubbed settings form and a
+ * catalog store: what it lists, what each blank editor field falls back to,
+ * what saving writes, and how a price refresh reads and stores prices.
+ */
+
+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import type { ModelCatalogState } from '../src/client/catalog.ts'
+import { glyphFor } from '../src/client/presets.ts'
+import { PRICE_SOURCE_URL } from '../src/client/price-source.ts'
