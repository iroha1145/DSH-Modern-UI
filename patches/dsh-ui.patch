+import { describe, expect, it } from 'vitest'
+import { formatPrice } from '../src/client/format-price.ts'
+
+describe('price text', () => {
+  it.each([0.0001, 0.00049, 0.00000001, Number.MIN_VALUE])('keeps the nonzero price %s visible', (value) => {
+    expect(Number(formatPrice(value))).toBeGreaterThan(0)
+    expect(formatPrice(value)).not.toBe('0')
+  })
+
+  it.each([[0, '0'], [0.0001, '0.0001'], [0.15, '0.15'], [1.23456, '1.235'], [120, '120']] as const)('formats %s as %s', (value, expected) => {
+    expect(formatPrice(value)).toBe(expected)
+  })
+})
