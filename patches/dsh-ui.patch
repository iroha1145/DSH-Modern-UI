@@ -0,0 +1,106 @@
+import { describe, expect, it } from 'vitest'
+import { citationChipName, citationGlyph, citationLocation, citationSiteName } from '../src/markdown/site-name.ts'
+
+describe('citation site names', () => {
+  it.each([
+    ['https://github.com/deepseek-ai/deepseek-harness', 'GitHub'],
+    ['https://gist.github.com/someone/abc', 'GitHub'],
+    ['https://www.github.com/', 'GitHub'],
+    ['https://en.wikipedia.org/wiki/Linux', 'Wikipedia'],
+    ['https://zh.wikipedia.org/wiki/Linux', 'Wikipedia'],
+    ['https://arxiv.org/abs/1706.03762', 'arXiv'],
+    ['https://stackoverflow.com/questions/1', 'Stack Overflow'],
+    ['https://someone.medium.com/post', 'Medium'],
+    ['https://www.youtube.com/watch?v=1', 'YouTube'],
+    ['https://youtu.be/1', 'YouTube'],
+    ['https://x.com/user', 'X'],
+    ['https://twitter.com/user', 'X'],
+    ['https://old.reddit.com/r/programming', 'Reddit'],
+    ['https://docs.python.org/3/library/os.html', 'Python Docs'],
+    ['https://www.python.org/', 'Python'],
+    ['https://developer.mozilla.org/en-US/docs/Web', 'MDN'],
+    ['https://news.ycombinator.com/item?id=1', 'Hacker News'],
+    ['https://www.zhihu.com/question/1', '知乎'],
+    ['https://www.bilibili.com/video/BV1', '哔哩哔哩'],
+    ['https://weibo.com/1', '微博'],
+    ['https://baike.baidu.com/item/Linux', '百度百科'],
+    ['https://www.baidu.com/s?wd=1', '百度'],
+    ['https://blog.csdn.net/u/article/details/1', 'CSDN'],
+    ['https://juejin.cn/post/1', '稀土掘金'],
+    ['https://news.sina.com.cn/c/1.shtml', '新浪'],
+    ['https://www.qq.com/', '腾讯'],
+    ['https://mp.weixin.qq.com/s/abc', '微信公众平台'],
+    ['https://news.163.com/', '网易'],
+    ['https://www.weather.com.cn/weather/101010100.shtml', '中国天气网'],
+  ])('maps well-known site %s to its brand name', (href, name) => {
+    expect(citationSiteName(href)).toBe(name)
+  })
+
+  it('prefers the most specific known suffix over its parent domain', () => {
+    expect(citationSiteName('https://docs.google.com/document/d/1')).toBe('Google Docs')
+    expect(citationSiteName('https://maps.google.com/')).toBe('Google')
+    expect(citationSiteName('https://docs.aws.amazon.com/s3')).toBe('AWS Docs')
+    expect(citationSiteName('https://aws.amazon.com/s3')).toBe('AWS')
+    expect(citationSiteName('https://www.amazon.com/dp/1')).toBe('Amazon')
+  })
+
+  it('names a hosting-platform site by its own label', () => {
+    expect(citationSiteName('https://firecracker-microvm.github.io/')).toBe('firecracker-microvm')
+    expect(citationSiteName('https://docs.project.readthedocs.io/en/latest/')).toBe('project')
+    expect(citationSiteName('https://example.vercel.app/')).toBe('example')
+    expect(citationSiteName('https://github.io/')).toBe('github.io')
+  })
+
+  it('falls back to the registrable domain with its original spelling', () => {
+    expect(citationSiteName('https://gvisor.dev/docs/')).toBe('gvisor.dev')
+    expect(citationSiteName('https://www.Example.COM/Path')).toBe('example.com')
+    expect(citationSiteName('https://docs.example.com/')).toBe('example.com')
+    expect(citationSiteName('https://a.b.docs.example.org/')).toBe('example.org')
+    expect(citationSiteName('https://news.example.co.uk/')).toBe('example.co.uk')
+    expect(citationSiteName('https://shop.example.com.cn/')).toBe('example.com.cn')
+    expect(citationSiteName('https://citations.example/first')).toBe('citations.example')
+    expect(citationSiteName('https://example.com./')).toBe('example.com')
+  })
+
+  it('does not let a brand entry claim every site under a registry suffix', () => {
+    expect(citationSiteName('https://www.gov.cn/')).toBe('gov.cn')
+    expect(citationSiteName('https://www.beijing.gov.cn/')).toBe('beijing.gov.cn')
+    expect(citationSiteName('https://www.miit.gov.cn/jgsj')).toBe('miit.gov.cn')
+  })
+
+  it('keeps addresses and single-label hosts as written', () => {
+    expect(citationSiteName('http://192.168.0.1:8080/status')).toBe('192.168.0.1')
+    expect(citationSiteName('http://[::1]:3000/')).toBe('[::1]')
+    expect(citationSiteName('http://localhost:3000/docs')).toBe('localhost')
+    expect(citationSiteName('http://constructor/')).toBe('constructor')
+  })
+
+  it('returns an unparseable value unchanged', () => {
+    expect(citationSiteName('not a url')).toBe('not a url')
+    expect(citationLocation('not a url')).toBe('not a url')
+  })
+})
+
+describe('citation presentation helpers', () => {
+  it('shows the host and path without query, fragment, or a bare root slash', () => {
+    expect(citationLocation('https://github.com/deepseek-ai/deepseek-harness?tab=readme#install')).toBe('github.com/deepseek-ai/deepseek-harness')
+    expect(citationLocation('https://example.com/')).toBe('example.com')
+    expect(citationLocation('https://example.com')).toBe('example.com')
+    expect(citationLocation('http://localhost:3000/a/b/')).toBe('localhost:3000/a/b/')
+  })
+
+  it('takes the first code point as the glyph', () => {
+    expect(citationGlyph('GitHub')).toBe('G')
+    expect(citationGlyph('arXiv')).toBe('A')
+    expect(citationGlyph('知乎')).toBe('知')
+    expect(citationGlyph('𠮷野家')).toBe('𠮷')
+    expect(citationGlyph('')).toBe('?')
+  })
+
+  it('cuts only chip names beyond 24 code points', () => {
+    expect(citationChipName('GitHub')).toBe('GitHub')
+    expect(citationChipName('a'.repeat(24))).toBe('a'.repeat(24))
+    expect(citationChipName('a'.repeat(25))).toBe(`${'a'.repeat(23)}…`)
+    expect(citationChipName('知'.repeat(30))).toBe(`${'知'.repeat(23)}…`)
+  })
+})
