+/** Native nested sandboxes: trusted outer policy contains navigation by the generated inner frame. */
+import { defaultHostStyle, type HostStyle } from './design-system.ts'
+import { FRAME_CSP, FRAME_EVENT_TYPE, frameDocument, frameProgram } from './frame-content.ts'
+import { MAX_HEIGHT, MIN_HEIGHT, reportedHeight, type IntelligentContent } from './schema.ts'
+
+/** Local mount events contain no model or host-service actions. */
+export interface FrameCallbacks {
+  ready(): void
+  /** The frame missed its deadline or navigated away; it has been removed. */
+  failed(): void
+  /** An authored script threw; the frame stays mounted with whatever it rendered. */
+  scriptError(): void
+  resized(height: number): void
+  /** An untrusted frame requests an HTTPS link; the host must obtain its own confirmation. */
+  openLink(href: string): void
+}
+
+/** Presentation inputs that the page supplies to one frame. */
+export interface FrameOptions {
+  readonly scheme?: 'light' | 'dark'
+  readonly host?: HostStyle
+  readonly icons?: Readonly<Record<string, string>>
+}
+
+const LINK_LIMIT = 2048
+
+function scriptData(value: string): string {
+  return JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029')
+}
+
+/**
+ * Build a fixed outer program with one data-only inner document and no code-message or host API receiver.
+ * @param content - Validated completed content.
+ * @param token - Per-mount display message token.
+ * @param options - Palette, chat typography, and icon geometry for this frame.
+ * @returns The trusted policy container's complete document.
+ */
+export function outerDocument(content: IntelligentContent, token: string, options: FrameOptions = {}): string {
+  const scheme = options.scheme ?? 'light'
+  const program = frameProgram(content, token, scheme, options.host ?? defaultHostStyle(scheme), options.icons ?? {})
+  // A replacer function keeps `$$`, `$&`, and `$'` in authored code literal; a replacement string expands them.
+  const innerDocument = frameDocument().replace('</body>', () => `<script>${program}</script></body>`)
+  return `<!doctype html><html><head><meta http-equiv="Content-Security-Policy" content="${FRAME_CSP}"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>html,body{width:100%;height:100%;margin:0;overflow:hidden;background:transparent;color-scheme:${scheme}}iframe{display:block;width:100%;height:100%;border:0;background:transparent;color-scheme:inherit}</style></head><body><script>(()=>{
+    const token=${scriptData(token)};
+    const kind=${scriptData(FRAME_EVENT_TYPE)};
+    const inner=document.createElement('iframe');
+    inner.setAttribute('sandbox','allow-scripts');
+    inner.referrerPolicy='no-referrer';
+    inner.title=${scriptData(content.title)};
+    inner.setAttribute('allow',${scriptData(DENIED_PERMISSIONS)});
+    let started = false;
+    inner.addEventListener('load', () => {
+      if(started) { parent.postMessage({type:kind,token,state:'failed'},'*'); return; }
+      started = true;
+      inner.contentWindow.postMessage({type:kind,token,state:'start'},'*');
+    });
+    addEventListener('message',event=>{
+      if(event.source!==inner.contentWindow)return;
+      const data=event.data;
+      if(!data||typeof data!=='object'||data.type!==kind||data.token!==token)return;
+      if(data.state==='resize'){
+        if(typeof data.height!=='number'||!Number.isFinite(data.height))return;
+        parent.postMessage({type:kind,token,state:'resize',height:Math.min(${MAX_HEIGHT},Math.max(${MIN_HEIGHT},Math.ceil(data.height)))},'*');
+      }else if(data.state==='open'){
+        if(typeof data.href!=='string'||data.href.length>${LINK_LIMIT}||!/^https:/i.test(data.href))return;
+        parent.postMessage({type:kind,token,state:'open',href:data.href},'*');
+      }else if(data.state==='error'||data.state==='ready'){
+        parent.postMessage({type:kind,token,state:data.state},'*');
+      }
+    });
+    inner.srcdoc=${scriptData(innerDocument)};
+    document.body.appendChild(inner);
+  })();</script></body></html>`
+}
+
+const DENIED_PERMISSIONS = "accelerometer 'none'; autoplay 'none'; camera 'none'; clipboard-read 'none'; clipboard-write 'none'; display-capture 'none'; encrypted-media 'none'; fullscreen 'none'; geolocation 'none'; gyroscope 'none'; hid 'none'; microphone 'none'; midi 'none'; payment 'none'; picture-in-picture 'none'; publickey-credentials-get 'none'; screen-wake-lock 'none'; serial 'none'; usb 'none'; web-share 'none'; xr-spatial-tracking 'none'"
+
+// crypto.getRandomValues stays available on plain-HTTP LAN pages, where crypto.randomUUID is withheld.
+function messageToken(): string {
+  return Array.from(crypto.getRandomValues(new Uint8Array(16)), byte => byte.toString(16).padStart(2, '0')).join('')
+}
+
+function linkTarget(value: unknown): string | undefined {
+  if (typeof value !== 'string' || value.length > LINK_LIMIT) return undefined
+  try {
+    const url = new URL(value)
+    // A user part reads as the site: https://docs.python.org@evil.example/ goes to evil.example.
+    if (url.username !== '' || url.password !== '') return undefined
+    return url.protocol === 'https:' ? url.href : undefined
+  } catch (_error) {
+    // A malformed address from the frame is ignored; the click already stayed inside the sandbox.
+    return undefined
+  }
+}
+
+/**
+ * Mount one completed visualization and return its complete resource disposer.
+ * @param container - This instance's empty frame container.
+ * @param content - Validated model-authored content.
+ * @param callbacks - Local display state, bounded layout updates, and reader link clicks.
+ * @param options - Palette, chat typography, and icon geometry for this frame.
+ * @returns Disposer for the timeout, message listener, and both nested frames.
+ */
+export function mountVisualization(
+  container: Element, content: IntelligentContent, callbacks: FrameCallbacks, options: FrameOptions = {},
+): () => void {
+  const frame = document.createElement('iframe')
+  const token = messageToken()
+  let disposed = false
+  let failed = false
+  let scriptFailed = false
+  const fail = (): void => {
+    if (disposed || failed) return
+    failed = true
+    clearTimeout(timeout)
+    frame.remove()
+    callbacks.failed()
+  }
+  const timeout = window.setTimeout(fail, 15_000)
+  const onMessage = (event: MessageEvent<unknown>): void => {
+    if (disposed || failed || event.source !== frame.contentWindow) return
+    const data = event.data
+    if (data === null || typeof data !== 'object' || !('type' in data) || data.type !== FRAME_EVENT_TYPE
+      || !('token' in data) || data.token !== token || !('state' in data)) return
+    if (data.state === 'failed') fail()
+    else if (data.state === 'error') {
+      if (scriptFailed) return
+      scriptFailed = true
+      callbacks.scriptError()
+    } else if (data.state === 'ready') {
+      clearTimeout(timeout)
+      callbacks.ready()
+    } else if (data.state === 'resize' && 'height' in data) {
+      const height = reportedHeight(data.height)
+      if (height !== undefined) callbacks.resized(height)
+    } else if (data.state === 'open' && 'href' in data) {
+      const href = linkTarget(data.href)
+      if (href !== undefined) callbacks.openLink(href)
+    }
+  }
+  window.addEventListener('message', onMessage)
+  frame.title = content.title
+  frame.referrerPolicy = 'no-referrer'
+  frame.setAttribute('sandbox', 'allow-scripts')
+  frame.setAttribute('allow', DENIED_PERMISSIONS)
+  // A matching color scheme on the embedding element keeps the frame canvas transparent.
+  frame.style.colorScheme = options.scheme ?? 'light'
+  frame.srcdoc = outerDocument(content, token, options)
+  container.appendChild(frame)
+  return () => {
+    disposed = true
+    clearTimeout(timeout)
+    window.removeEventListener('message', onMessage)
+    frame.remove()
+  }
+}
diff --git a/packages/client/ui-intelligent-ui/src/client/schema.ts b/packages/client/ui-intelligent-ui/src/client/schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7292cc1b88a4d4c1991dae4a0c13f2f6166898b5
--- /dev/null
+++ b/packages/client/ui-intelligent-ui/src/client/schema.ts
@@ -0,0 +1,128 @@
+/** Completed DSH visualization source: an HTML fragment, or JSON adapted from OpenIntelligentUI's content fields. */
+import z from '@deepseek-ai/schemastery'
+
+/** A single completed visualization; execution never accepts partial streaming source. */
+export interface IntelligentContent {
+  version: 1
+  title: string
+  /** Standalone explanation; JSON blocks require it, HTML fragments rely on the surrounding answer. */
+  fallback?: string
+  initialHeight?: number
+  css?: string
+  html: string | string[]
+  jsFunctions?: string
+  jsExpressions?: string | string[]
+}
+
+/** Authored notation of one fence body. */
+export type ContentFormat = 'html' | 'json'
+
+/** Security limits apply to model-authored content, independently of deployment settings. */
+export const CONTENT_LIMIT = 128_000
+/** Minimum visible frame height in CSS pixels. */
+export const MIN_HEIGHT = 24
+/** Maximum frame height; taller content scrolls inside the frame. */
+export const MAX_HEIGHT = 2400
+/** Maximum JSON fragments, or inline scripts in one HTML fragment. */
+export const MAX_FRAGMENTS = 128
+
+const TITLE_LIMIT = 200
+const fragments = z.union([z.string(), z.array(z.string()).max(MAX_FRAGMENTS)])
+const contentSchema: z<IntelligentContent> = z.object({
+  version: z.const(1).required(),
+  title: z.string().min(1).max(TITLE_LIMIT).required(),
+  fallback: z.string().min(1).max(16_000).required(),
+  initialHeight: z.number().min(MIN_HEIGHT).max(MAX_HEIGHT),
+  css: z.string().max(32_000),
+  html: fragments.required(),
+  jsFunctions: z.string().max(32_000),
+  jsExpressions: fragments,
+})
+
+const TITLE_ELEMENT = /<title\b[^>]*>([\s\S]*?)<\/title\s*>/i
+const SCRIPT_ELEMENT = /<script\b[^>]*>([\s\S]*?)<\/script\s*>/gi
+const JSON_TITLE = /^\s*\{[\s\S]*?"title"\s*:\s*"((?:[^"\\]|\\.)*)"/
+
+/** Validated result retains source elsewhere so a rejected visualization remains readable. */
+export type ContentResult =
+  | { ok: true; format: ContentFormat; content: IntelligentContent }
+  | { ok: false; reason: 'invalid' | 'tooLarge' }
+
+/**
+ * Parse completed untrusted source; a body starting with `{` or `[` is JSON, anything else an HTML fragment.
+ * @param source - Raw openui fence body.
+ * @param defaultTitle - Localized title for a fragment without a `<title>` element.
+ * @returns Validated content with its notation, or a localized failure category.
+ */
+export function parseContent(source: string, defaultTitle: string): ContentResult {
+  if (source.length > CONTENT_LIMIT) return { ok: false, reason: 'tooLarge' }
+  return sourceFormat(source) === 'json' ? parseJson(source) : parseFragment(source, defaultTitle)
+}
+
+/**
+ * Name the notation of a possibly partial fence body.
+ * @param source - Fence body.
+ * @returns `json` when the body starts with `{` or `[`, otherwise `html`.
+ */
+export function sourceFormat(source: string): ContentFormat {
+  return /^\s*[[{]/.test(source) ? 'json' : 'html'
+}
+
+/**
+ * Read the title written so far, for the placeholder shown while the answer streams.
+ * @param source - Possibly partial fence body.
+ * @returns The plain-text title, or undefined until one is complete.
+ */
+export function partialTitle(source: string): string | undefined {
+  const title = sourceFormat(source) === 'json'
+    ? JSON_TITLE.exec(source)?.[1]?.replace(/\\(.)/g, '$1')
+    : TITLE_ELEMENT.exec(source)?.[1]
+  const text = title?.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim().slice(0, TITLE_LIMIT) ?? ''
+  return text === '' ? undefined : text
+}
+
+function parseFragment(source: string, defaultTitle: string): ContentResult {
+  if (!/<[a-z]/i.test(source)) return { ok: false, reason: 'invalid' }
+  const scripts: string[] = []
+  // Replacer functions keep `$` sequences in authored code literal.
+  const markup = source.replace(TITLE_ELEMENT, () => '').replace(SCRIPT_ELEMENT, (_element: string, text: string) => {
+    if (text.trim() !== '') scripts.push(text)
+    return ''
+  })
+  if (markup.trim() === '' && scripts.length === 0) return { ok: false, reason: 'invalid' }
+  if (scripts.length > MAX_FRAGMENTS) return { ok: false, reason: 'tooLarge' }
+  return {
+    ok: true,
+    format: 'html',
+    content: { version: 1, title: partialTitle(source) ?? defaultTitle, html: markup, jsExpressions: scripts },
+  }
+}
+
+function parseJson(source: string): ContentResult {
+  try {
+    const input: unknown = JSON.parse(source)
+    if (input === null || typeof input !== 'object' || Array.isArray(input)) return { ok: false, reason: 'invalid' }
+    const allowed = new Set(['version', 'title', 'fallback', 'initialHeight', 'css', 'html', 'jsFunctions', 'jsExpressions'])
+    if (Object.values(input).some(value => value === null)) return { ok: false, reason: 'invalid' }
+    if (Object.keys(input).some(key => !allowed.has(key))) return { ok: false, reason: 'invalid' }
+    const content = z.resolve(input, contentSchema, {})[0] as IntelligentContent
+    if (content.title.trim() === '' || content.fallback?.trim() === ''
+      || (Array.isArray(content.html) ? content.html.join('') : content.html).trim() === '') return { ok: false, reason: 'invalid' }
+    if (content.initialHeight !== undefined && !Number.isFinite(content.initialHeight)) return { ok: false, reason: 'invalid' }
+    return { ok: true, format: 'json', content }
+  } catch (_error) {
+    // JSON and schema failures have one owner-visible state; the source remains available.
+    return { ok: false, reason: 'invalid' }
+  }
+}
+
+/**
+ * Accept finite frame measurements only and bound their layout impact.
+ * @param value - Untrusted postMessage height.
+ * @returns Rounded bounded height, or undefined for invalid measurements.
+ */
+export function reportedHeight(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value)
+    ? Math.min(MAX_HEIGHT, Math.max(MIN_HEIGHT, Math.ceil(value)))
+    : undefined
+}
