@@ -0,0 +1,18 @@
+/** One vendor mark as a decorative inline SVG that takes the tile's text color. */
+import type { ReactNode } from 'react'
+import { VENDOR_MARKS, type VendorMark } from './vendor-marks.ts'
+
+/**
+ * Draw a vendor mark in `currentColor`.
+ * @param props - the mark id and an optional class for sizing.
+ * @returns the hidden-from-assistive-technology SVG.
+ */
+export function VendorMarkIcon({ mark, className }: { mark: VendorMark; className?: string | undefined }): ReactNode {
+  return (
+    <svg className={className} viewBox="0 0 24 24" fill="currentColor" fillRule="evenodd" aria-hidden="true" focusable="false">
+      {VENDOR_MARKS[mark].map((shape, index) => typeof shape === 'string'
+        ? <path key={index} d={shape} />
+        : <path key={index} d={shape.d} fillOpacity={shape.opacity} />)}
+    </svg>
+  )
+}
diff --git a/packages/client/ui-model-selection/src/client/format-price.ts b/packages/client/ui-model-selection/src/client/format-price.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b1cd24308f2d743fe43340f9a3fe58cc59625e0e
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/format-price.ts
@@ -0,0 +1,10 @@
+/**
+ * A price per million tokens, with four significant digits and no trailing
+ * zeros. Scientific notation keeps every finite nonzero price visibly nonzero,
+ * including values smaller than the browser's fixed-decimal precision.
+ * @param value - US dollars per million tokens.
+ * @returns the numeric amount shared by picker text, tooltips, and settings.
+ */
+export function formatPrice(value: number): string {
+  return String(Number(value.toPrecision(4)))
+}
