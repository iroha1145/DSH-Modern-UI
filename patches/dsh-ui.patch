+  session.append('turn/start', { turn: 2 })
+  session.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'A stopped response must keep source only.' }], source: { kind: 'user' } }), { surfaceOp: 'append' })
+  session.append('step/start', { turn: 2, step: 1 })
