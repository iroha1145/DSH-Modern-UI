@@ -0,0 +1,504 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { allowAllAccess, makeTranslate, sessionSnapshot } from '@deepseek-ai/dsh-client-test-runtime'
+import type {
+  SessionListState, SessionSnapshot, SessionSummary,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import type {
+  SessionPendingInteraction, SessionStatus, SessionStatusSnapshot,
+} from '@deepseek-ai/dsh-client-ui-session/client'
+import { SessionSeq, type SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SubagentCatalogEntry, SubagentTimingProjection } from '@deepseek-ai/dsh-subagent/client'
+import { AgentTree, type AgentNode, type AgentStatus } from '../src/client/agent-tree/AgentTree.tsx'
+import { AgentsView, type AgentsViewProps } from '../src/client/agent-tree/AgentsView.tsx'
+import { deriveAgentTree, type AgentTreeInput, type AgentTreeList } from '../src/client/agent-tree/model.ts'
+import {
+  activeDuration, formatDuration, formatExactDuration, formatTokens, tokenTotal,
+} from '../src/client/format.ts'
+import { en, zh } from '../src/client/locales.ts'
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+const t: AgentsViewProps['t'] = makeTranslate(zh)
+const tEn: AgentsViewProps['t'] = makeTranslate(en)
+const sid = (id: string) => id as SessionId
+const NOW = 1_800_000_000_000
+
+type ProjectionSnapshot = SessionListState['projectionsBySession'][SessionId]
+
+function row(id: string, over: Partial<SessionSummary> = {}): SessionSummary {
+  return { id: sid(id), displayTitle: id, running: false, retainedBy: {}, blank: false, updatedAt: 0, ...over }
+}
+
+function child(id: string, parent: string, over: Partial<SessionSummary> = {}): SessionSummary {
+  return row(id, { origin: 'subagent', parentId: sid(parent), ...over })
+}
+
+function entry(id: string, label = id): SubagentCatalogEntry {
+  return { id: sid(id), createdAt: 1, mode: 'continuable', label }
+}
+
+function unlabeled(id: string, mode: 'one-shot' | 'external'): SubagentCatalogEntry {
+  return { id: sid(id), createdAt: 1, mode }
+}
+
+function snapshot(over: Partial<ProjectionSnapshot> = {}): ProjectionSnapshot {
+  return { values: {}, state: 'ready', error: null, ...over }
+}
+
+function listOf(
+  rows: readonly SessionSummary[],
+  projections: Readonly<Record<string, ProjectionSnapshot>> = {},
+): AgentTreeList {
+  return {
+    byId: Object.fromEntries(rows.map(value => [value.id, value])),
+    projectionsBySession: projections,
+  }
+}
+
+function status(over: Partial<SessionStatus>): SessionStatus {
+  return { running: undefined, pendingInteraction: undefined, completionUnread: false, ...over }
+}
+
+function input(over: Partial<AgentTreeInput> & Pick<AgentTreeInput, 'list'>): AgentTreeInput {
+  return { currentSessionId: sid('root'), currentParentId: undefined, statuses: new Map(), ...over }
+}
+
+function node(id: string, over: Partial<AgentNode> = {}): AgentNode {
+  return {
+    id: sid(id), name: id, running: false, external: false, current: false, openable: true, children: [], ...over,
+  }
+}
+
+function timing(over: Partial<SubagentTimingProjection>): SubagentTimingProjection {
+  return { settledMs: 0, ...over }
+}
+
+describe('format helpers', () => {
+  it('formats compact and exact durations across scales', () => {
+    expect(formatDuration(9_400, tEn)).toBe('9s')
+    expect(formatDuration(72_000, tEn)).toBe('1m 12s')
+    expect(formatDuration(3_725_000, tEn)).toBe('1h 02m 05s')
+    expect(formatDuration(86_400_000, tEn)).toBe('1d')
+    expect(formatDuration(90_000_000, tEn)).toBe('1d 1h')
+    expect(formatDuration(30 * 86_400_000, tEn)).toBe('~1mo')
+    expect(formatDuration(32 * 86_400_000, tEn)).toBe('~1mo 2d')
+    expect(formatDuration(365 * 86_400_000, tEn)).toBe('~1y')
+    expect(formatDuration(400 * 86_400_000, tEn)).toBe('~1y 1mo')
+    expect(formatDuration(-5, tEn)).toBe('0s')
+    expect(formatExactDuration(72_000, tEn)).toBe('1m 12s')
+    expect(formatExactDuration(90_061_000, tEn)).toBe('1d 01h 01m 01s')
+  })
+
+  it('formats token totals and sums the four usage buckets', () => {
+    expect(formatTokens(999, tEn)).toBe('999')
+    expect(formatTokens(12_340, tEn)).toBe('12.3K')
+    expect(formatTokens(182_340, tEn)).toBe('182K')
+    expect(formatTokens(2_500_000, tEn)).toBe('2.5M')
+    expect(tokenTotal(undefined)).toBeUndefined()
+    expect(tokenTotal({ uncachedInputTokens: 1, outputTokens: 2, cacheReadTokens: 3, cacheWriteTokens: 4 })).toBe(10)
+  })
+
+  it('advances an open turn to the clock only while the agent runs', () => {
+    expect(activeDuration(undefined, true, NOW)).toBeUndefined()
+    expect(activeDuration(timing({ settledMs: 5_000 }), true, NOW)).toBe(5_000)
+    const open = timing({ settledMs: 5_000, active: { since: NOW - 10_000, through: NOW - 4_000 } })
+    expect(activeDuration(open, true, NOW)).toBe(15_000)
+    expect(activeDuration(open, false, NOW)).toBe(11_000)
+    expect(activeDuration(open, true, NOW - 20_000)).toBe(5_000)
+  })
+})
+
+describe('deriveAgentTree', () => {
+  it('roots at the top ancestor and orders catalog children before listed fallbacks', () => {
+    const rows = [
+      row('root', { displayTitle: 'Refactor login', running: true }),
+      child('a', 'root', { title: 'Audit the middleware', updatedAt: 3 }),
+      child('b', 'root', { updatedAt: 2 }),
+      child('late', 'root', { updatedAt: 9 }),
+      child('early-2', 'root', { updatedAt: 1 }),
+      child('early-1', 'root', { updatedAt: 1 }),
+      child('grand', 'a'),
+      // A historical fork keeps its parent id without being a subagent.
+      row('fork', { parentId: sid('root') }),
+    ]
+    const model = deriveAgentTree(input({
+      currentSessionId: sid('grand'),
+      list: listOf(rows, {
+        root: snapshot({
+          values: {
