+// @vitest-environment jsdom
+import { useState } from 'react'
+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { allowAllAccess, makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import type { GlobalStandardProps } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { MainPanelId } from '@deepseek-ai/dsh-client-ui-layout/client'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { SidebarRoot } from '../src/client/SidebarRoot.tsx'
+import type { SidebarRootComponentProps, SidebarSectionOwnerProps } from '../src/client/contract/slots.ts'
+import { en } from '../src/client/locales.ts'
+
+const t: SidebarRootComponentProps['t'] = makeTranslate({ ...commonEn, ...en })
+const unused = (() => { throw new Error('unexpected global read') }) as never
+const useResource = (() => ({ status: 'none', value: undefined, failure: undefined, reload: () => {} })) as GlobalStandardProps['useResource']
+const plugins = 'plugins' as MainPanelId
+const schedules = 'schedules' as MainPanelId
+
+afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+
+function bench(width: number, canCreate = true, initiallyCollapsed = true) {
+  let resizeFrame: ((width: number) => void) | undefined
+  const session = { id: 'phone' as SessionId, displayTitle: 'Phone conversation', running: false, retainedBy: { mainView: 1 }, blank: false, updatedAt: 1 }
+  const startSession = vi.fn()
+  const selectPanel = vi.fn()
+  const openedSession = vi.fn()
+  function Harness() {
+    const [currentWidth, setWidth] = useState(width)
+    const [collapsed, setCollapsed] = useState(initiallyCollapsed)
+    resizeFrame = (next) => { setWidth(next); if (next <= 640 && currentWidth > 640) setCollapsed(true) }
+    const [activePanelId, setActivePanelId] = useState<MainPanelId | null>(null)
+    return <><SidebarRoot mobile={currentWidth <= 640} collapsed={collapsed} width={currentWidth}
+      useSessions={selector => selector({
+        ids: [session.id], byId: { [session.id]: session },
+        phase: 'ready', projectionsBySession: {},
+      })} useSessionStatus={unused} useSessionRetainInfo={unused} useWorkspaces={unused}
+      useResource={useResource} {...allowAllAccess}
+      useRemoteAccess={endpoint => endpoint !== 'session/create' || canCreate}
+      usePanelInfo={selector => selector({ activePanelId })}
+      usePanels={selector => selector([{ id: plugins, label: 'Plugins', order: 1 }, { id: schedules, label: 'Schedules', order: 2 }])}
+      useEntryPins={selector => selector([])} useEntryActions={selector => selector(false)}
+      useShortcuts={selector => selector([])} setPinned={vi.fn()} trackEntryClick={vi.fn()}
+      startSession={startSession} toggleSidebar={() => { setCollapsed(value => !value) }}
+      selectPanel={(id) => { selectPanel(id); setActivePanelId(id) }} t={t}
+      renderSlot={((key: string, owner: SidebarSectionOwnerProps) => {
+        if (key === 'sidebar.workspaces') return <div>
+          <button type="button">Search sessions</button>
+          <button type="button">Add workspace</button>
+          <button type="button" onClick={() => { openedSession(); owner.onNavigate?.() }}>Open saved session</button>
+        </div>
+        if (key === 'sidebar.settings') return <button type="button">Settings</button>
+        if (key === 'sidebar.panellist') return <svg aria-hidden="true" />
+        return null
+      }) as SidebarRootComponentProps['renderSlot']}
+    /><input aria-label="External settings field" /></>
+  }
+  const view = render(<Harness />)
+  return {
+    ...view, startSession, selectPanel, openedSession,
+    resize(next: number) { act(() => { resizeFrame?.(next) }) },
+  }
+}
+
+for (const width of [390, 320]) {
+  describe(`phone navigation at ${width}px`, () => {
+    it('shows named primary actions and opens the full workspace browser with focus contained', () => {
+      bench(width)
+      const navigation = screen.getByRole('navigation', { name: 'Main navigation' })
+      expect(within(navigation).getAllByRole('button').map(button => button.getAttribute('aria-label'))).toEqual(['Sessions', 'New session'])
+      expect(within(navigation).getByText('Phone conversation')).toBeTruthy()
+      const trigger = within(navigation).getByRole('button', { name: 'Sessions' })
+      fireEvent.click(trigger)
+      const drawer = screen.getByRole('dialog', { name: 'Sessions' })
+      const close = within(drawer).getByRole('button', { name: 'Close navigation panel' })
+      expect(document.activeElement).toBe(close)
+      expect(within(drawer).getByRole('button', { name: 'Search sessions' })).toBeTruthy()
+      expect(within(drawer).getByRole('button', { name: 'Add workspace' })).toBeTruthy()
+      fireEvent.keyDown(close, { key: 'Tab', shiftKey: true })
+      expect(document.activeElement).toBe(within(drawer).getByRole('button', { name: 'Settings' }))
+      fireEvent.keyDown(document.activeElement!, { key: 'Tab' })
+      expect(document.activeElement).toBe(close)
+      fireEvent.keyDown(close, { key: 'Escape' })
+      expect(screen.queryByRole('dialog')).toBeNull()
+      expect(document.activeElement).toBe(trigger)
+    })
+
+    it('closes after session navigation and routes new-session and panel actions', () => {
+      const view = bench(width)
+      const navigation = screen.getByRole('navigation', { name: 'Main navigation' })
+      fireEvent.click(within(navigation).getByRole('button', { name: 'Sessions' }))
+      fireEvent.click(screen.getByRole('button', { name: 'Open saved session' }))
+      expect(view.openedSession).toHaveBeenCalledOnce()
+      expect(screen.queryByRole('dialog')).toBeNull()
+      fireEvent.click(within(navigation).getByRole('button', { name: 'New session' }))
+      expect(view.startSession).toHaveBeenCalledOnce()
+      fireEvent.click(within(navigation).getByRole('button', { name: 'Sessions' }))
+      const drawer = screen.getByRole('dialog', { name: 'Sessions' })
+      expect(within(drawer).getByRole('button', { name: 'Settings' })).toBeTruthy()
+      fireEvent.click(within(drawer).getByRole('button', { name: 'Plugins' }))
+      expect(view.selectPanel).toHaveBeenLastCalledWith(plugins)
+      expect(screen.queryByRole('dialog')).toBeNull()
+      expect(within(navigation).getByText('Plugins')).toBeTruthy()
+      fireEvent.click(within(navigation).getByRole('button', { name: 'Sessions' }))
+      fireEvent.click(within(screen.getByRole('dialog')).getByRole('button', { name: 'Schedules' }))
+      expect(view.selectPanel).toHaveBeenLastCalledWith(schedules)
+      expect(screen.queryByRole('dialog')).toBeNull()
+    })
+
+    it('dismisses from the backdrop and keeps focus reachable after returning to desktop', () => {
+      const view = bench(width)
+      const trigger = screen.getByRole('button', { name: 'Sessions' })
+      fireEvent.click(trigger)
+      fireEvent.click(view.container.querySelector('[aria-hidden="true"][class*="mobileBackdrop"]')!)
+      expect(screen.queryByRole('dialog')).toBeNull()
+      expect(document.activeElement).toBe(trigger)
+      view.resize(900)
+      expect(screen.queryByRole('navigation', { name: 'Main navigation' })).toBeNull()
+      expect(document.activeElement?.getAttribute('data-sidebar-toggle')).toBe('')
+    })
+  })
+}
+
+it('omits the new-session entry when the deployment denies creation', () => {
+  bench(390, false)
+  expect(within(screen.getByRole('navigation', { name: 'Main navigation' })).queryByRole('button', { name: 'New session' })).toBeNull()
+})
+
+it('keeps an external settings field focused when the frame enters phone mode collapsed', () => {
+  const view = bench(1680, true, false)
+  const field = screen.getByRole('textbox', { name: 'External settings field' })
+  field.focus()
+  view.resize(600)
+  expect(document.activeElement).toBe(field)
+  expect(screen.queryByRole('dialog', { name: 'Sessions' })).toBeNull()
+  fireEvent.click(screen.getByRole('button', { name: 'Sessions' }))
+  const close = within(screen.getByRole('dialog', { name: 'Sessions' })).getByRole('button', { name: 'Close navigation panel' })
+  expect(document.activeElement).toBe(close)
+  fireEvent.keyDown(close, { key: 'Escape' })
+  expect(screen.queryByRole('dialog')).toBeNull()
+  expect(document.activeElement).toBe(screen.getByRole('button', { name: 'Sessions' }))
+})
