+describe('citation runs', () => {
+  const link = (id: string, url: string): Md.Link => ({ type: 'link', url, title: null, children: [{ type: 'text', value: id }] })
+  const text = (value: string): Md.Text => ({ type: 'text', value })
+  const run = (nodes: Md.RootContent[]) => {
+    const sources: CitationSources = new Map()
+    const [first, ...rest] = nodes
+    return { result: citationRun(first!, nodes, 1, new Map(), sources), rest, sources }
+  }
+
+  it('is undefined for a node that is not a citation', () => {
+    expect(run([text('plain'), link('1', 'https://github.com/a')]).result).toBeUndefined()
+    expect(run([link('x', 'https://github.com/a')]).result).toBeUndefined()
+  })
+
+  it('absorbs separators only when a marker follows them', () => {
+    const a = link('1', 'https://github.com/a')
+    const b = link('2', 'https://en.wikipedia.org/wiki/B')
+    const { result, sources } = run([a, text(', '), b, text(' tail')])
+    expect(result?.sources.map(source => source.id)).toEqual(['1', '2'])
+    expect(result?.consumed).toBe(2)
+    expect([...sources.keys()]).toEqual(['1', '2'])
+    expect(run([a, text(' , ')]).result?.consumed).toBe(0)
+    expect(run([a, b]).result?.consumed).toBe(1)
+  })
+
+  it('does not read a reference without a definition as a citation', () => {
+    const orphan: Md.LinkReference = {
+      type: 'linkReference', identifier: '1', label: '1', referenceType: 'shortcut', children: [text('1')],
+    }
+    expect(run([orphan]).result).toBeUndefined()
+  })
+
+  it('stops at a second separator node, which stays text', () => {
+    const a = link('1', 'https://github.com/a')
+    const b = link('2', 'https://en.wikipedia.org/wiki/B')
+    const { result } = run([a, text(', '), text(', '), b])
+    expect(result?.consumed).toBe(0)
+  })
+})
