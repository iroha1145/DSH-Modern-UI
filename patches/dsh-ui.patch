index 0000000000000000000000000000000000000000..a3b6fc9346b1a158b3eec93649aa86967adb6f04
--- /dev/null
+++ b/packages/web/tool-web/src/switch.ts
@@ -0,0 +1,405 @@
+/**
+ * The per-Session web-search switch. One selected state decides whether a
+ * model step may admit `web_search` and `web_fetch`, and whether other
+ * inherited tools whose names start with a configured prefix stay visible to
+ * the Agent. `/web on` and `/web off` select the state. Between turns the
+ * successful command settlement records a recoverable selection; the next
+ * accepted pre-step appends `web/search` to consolidate it,
+ * while the next step's admission already reads it.
+ *
+ * The switch activates only where `ctx.sessionProjections` is composed, and
+ * its command only where `ctx.commands` and `ctx.agents` are composed as well;
+ * without the projection registry both tools follow provider readiness alone.
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { CommandDefinition, CommandDefinitionId, CommandId, CommandResult } from '@deepseek-ai/dsh-commands'
+import { scopeOf } from '@deepseek-ai/dsh-scope'
+import type { Session } from '@deepseek-ai/dsh-session'
+import type { ProjectionDefinition, ProjectionHandle } from '@deepseek-ai/dsh-session-projection'
+import { z as zod } from 'zod'
+import type { ZodType } from 'zod'
+import type { WebSearchProjection, WebSearchUnitState } from './types.ts'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /**
+     * Whether `web_search`, `web_fetch`, and the configured prefix-matched
+     * tools may be offered from this point on: log-only, non-surface,
+     * whole-value replace. The last `web/search` wins; a log with none folds
+     * to enabled.
+     */
+    'web/search': { enabled: boolean }
+  }
+}
+
+/** The human command that selects the web-search state. */
+export const WEB_SEARCH_COMMAND = 'web'
+
+/** What one selection did to a Session's web-search state. */
+export type WebSearchSelectionOutcome = 'committed' | 'queued' | 'cancelled' | 'noop'
+
+/**
+ * Whether one Agent's next step may admit `web_search` and `web_fetch`.
+ * @param agent - the Agent preparing the step.
+ * @returns the selected state while the switch is active, otherwise true.
+ * @throws while the switch is activating, so a step cannot run without the logged state.
+ */
+export type WebSearchAdmission = (agent: Agent) => boolean
+
+/**
+ * Read the state one `/web` argument selects.
+ * @param input - the text after the command name, separator whitespace included.
+ * @returns true for `on`, false for `off`, and undefined for any other text.
+ */
+function selectedState(input: string): boolean | undefined {
+  switch (input.trim()) {
+    case 'on':
+      return true
+    case 'off':
+      return false
+    default:
+      return undefined
+  }
+}
+
+const webSearchUnitStateSchema: ZodType<WebSearchUnitState> = zod.object({
+  enabled: zod.boolean(),
+  wanted: zod.boolean().nullable(),
+  running: zod.record(zod.string().transform(brandString<CommandId>), zod.boolean()),
+}).strict()
+
+/** Wire payload schema of the `webSearch` projection. */
+const webSearchProjectionSchema: ZodType<WebSearchProjection> = zod.object({
+  enabled: zod.boolean(),
+  pending: zod.boolean(),
+})
+
+// The four possible wire values; reusing them keeps an unchanged view's
+// reference, so command bookkeeping that leaves the view equal publishes nothing.
+const ENABLED_VIEW: WebSearchProjection = Object.freeze({ enabled: true, pending: false })
+const ENABLED_PENDING_VIEW: WebSearchProjection = Object.freeze({ enabled: true, pending: true })
+const DISABLED_VIEW: WebSearchProjection = Object.freeze({ enabled: false, pending: false })
+const DISABLED_PENDING_VIEW: WebSearchProjection = Object.freeze({ enabled: false, pending: true })
+
+/**
+ * Select the shared wire value for one state.
+ * @param enabled - the logged state.
+ * @param pending - whether an outstanding selection targets the other state.
+ * @returns the frozen view for that combination.
+ */
+function webSearchView(enabled: boolean, pending: boolean): WebSearchProjection {
+  if (enabled) return pending ? ENABLED_PENDING_VIEW : ENABLED_VIEW
+  return pending ? DISABLED_PENDING_VIEW : DISABLED_VIEW
+}
+
+/** Projection of logged `/web` selections and the committed web-search state. */
+export const webSearchProjectionDefinition = {
+  key: 'webSearch',
+  stateVersion: 2,
+  stateSchema: webSearchUnitStateSchema,
+  init: () => ({ enabled: true, wanted: null, running: {} }),
+  apply: (state, event) => {
+    if (event.type === 'command/run' && event.data.name === WEB_SEARCH_COMMAND) {
+      const wanted = event.data.args === undefined ? undefined : selectedState(event.data.args)
+      return wanted === undefined ? state : { ...state, running: { ...state.running, [event.data.commandId]: wanted } }
+    }
+    if (event.type === 'command/done') {
+      const target = Object.hasOwn(state.running, event.data.commandId) ? state.running[event.data.commandId] : undefined
+      if (target === undefined) return state
+      const { [event.data.commandId]: _settled, ...running } = state.running
+      const wanted = event.data.kind === 'success'
+        ? target === state.enabled ? null : target
+        : state.wanted
+      return { ...state, wanted, running }
+    }
+    if (event.type === 'web/search') {
+      return { ...state, enabled: event.data.enabled, wanted: null }
+    }
+    return state
+  },
+  wire: {
+    viewSchema: webSearchProjectionSchema,
+    view: (state) => {
+      const wanted = state.wanted
+      return webSearchView(state.enabled, wanted !== null && wanted !== state.enabled)
+    },
+  },
+} satisfies ProjectionDefinition<'webSearch', WebSearchUnitState>
+
+/**
+ * The switch's own tools. Off withholds them by restriction as well as by their
+ * activation condition, so they stay hidden even when a plugin that wraps
+ * `ctx.tools.register` drops registration options such as `when`.
+ */
+const WEB_TOOL_NAMES: ReadonlySet<string> = new Set(['web_search', 'web_fetch'])
+
+/** Restrictions one Agent holds while its selected state is off. */
+interface ToolDenial {
+  /** Every name a held restriction removes. */
+  readonly names: Set<string>
+  /** Disposers of the held restrictions. */
+  readonly releases: (() => void)[]
+}
+
+/**
+ * Removes `web_search`, `web_fetch`, and inherited tools whose names start
+ * with a configured prefix from the Agents whose selected web-search state is
+ * off. Candidates come from the tool-web plugin's own registry view, the global
+ * and preset tools every Agent under that plugin inherits, so
+ * `tools.restrict()` accepts each name.
+ */
+class WebToolDenials {
+  private readonly denials = new Map<Agent, ToolDenial>()
+
+  /**
+   * @param ctx - tool-web's plugin context, whose scope supplies the candidate tools.
+   * @param prefixes - validated tool-name prefixes; empty limits the restriction to the switch's own tools.
+   */
+  constructor(private readonly ctx: Context, private readonly prefixes: readonly string[]) {}
+
+  /**
+   * Match one Agent's restrictions to a selected state. Off adds a
+   * restriction for matching names that no held restriction removes yet, and
+   * makes no `tools.restrict()` call when there is none; on lifts every held
+   * restriction.
+   * @param agent - the Agent whose visible tools change.
+   * @param enabled - the Agent's selected web-search state.
+   */
+  update(agent: Agent, enabled: boolean): void {
+    if (enabled) {
+      this.release(agent)
+      return
+    }
+    const held = this.denials.get(agent)
+    const names = this.ctx.tools.definitions(scopeOf(this.ctx))
+      .map(definition => definition.name)
+      .filter(name => (WEB_TOOL_NAMES.has(name) || this.prefixes.some(prefix => name.startsWith(prefix)))
+        && held?.names.has(name) !== true)
+    if (names.length === 0) return
+    const release = agent.ctx.tools.restrict({ deny: names })
+    const denial = held ?? { names: new Set<string>(), releases: [] }
+    for (const name of names) denial.names.add(name)
+    denial.releases.push(release)
+    this.denials.set(agent, denial)
+  }
+
+  /**
+   * Lift every restriction held for one Agent.
+   * @param agent - the Agent whose tools become visible again.
+   */
+  release(agent: Agent): void {
+    const denial = this.denials.get(agent)
+    if (denial === undefined) return
+    this.denials.delete(agent)
+    for (const release of denial.releases) release()
+  }
+
+  /**
+   * Drop one disposed Agent; its scope already unwound the restrictions.
+   * @param agent - the Agent that left the registry.
+   */
+  forget(agent: Agent): void {
+    this.denials.delete(agent)
+  }
+
+  /** Lift every held restriction when the switch unloads. */
+  releaseAll(): void {
+    for (const agent of [...this.denials.keys()]) this.release(agent)
+  }
+}
+
+/**
+ * Selected web-search state for the Sessions one projection handle reads: the
+ * logged state plus selections that wait for the next accepted in-turn
+ * pre-step.
+ */
+class WebSearchSelections {
+  /** @param handle - the retained reader of the `webSearch` unit. */
+  constructor(private readonly handle: ProjectionHandle<WebSearchUnitState>) {}
+
+  /**
+   * @param session - the Session to read.
+   * @returns the logged state.
+   */
+  logged(session: Session): boolean {
+    return this.handle.stateOf(session).enabled
+  }
+
+  /**
+   * @param session - the Session to read.
+   * @returns the state the next proposed step presents: a pending selection, else the logged state.
+   */
+  selected(session: Session): boolean {
+    const state = this.handle.stateOf(session)
+    return state.wanted ?? state.enabled
+  }
+
+  /**
+   * Describe a selection without changing its state. Successful command
+   * settlement records the target; failed or unfinished commands do not
+   * replace an earlier successful target. An accepted pre-step consolidates it.
+   * @param session - the Session to switch.
+   * @param enabled - the selected state.
+   * @param openTurn - whether the Session has an open turn.
+   * @returns `committed` (selected between turns), `queued` (selected during
+   * a turn), `cancelled` (an opposite pending selection was cleared;
+   * the logged state already matches), or `noop` (already selected).
+   */
+  select(session: Session, enabled: boolean, openTurn: boolean): WebSearchSelectionOutcome {
+    const logged = this.logged(session)
+    if (enabled === this.selected(session)) return 'noop'
+    if (enabled === logged) return 'cancelled'
+    return openTurn ? 'queued' : 'committed'
+  }
+
+  /**
+   * Append one pending selection before the next request assembly. Only a
+   * target that differs from the logged state needs an append.
+   * @param session - the Session whose pending selection is appended.
+   */
+  flush(session: Session): void {
+    const pending = this.handle.stateOf(session).wanted
+    if (pending === null) return
+    if (pending !== this.logged(session)) session.append('web/search', { enabled: pending })
+  }
+}
+
+/**
+ * The `/web` result text for one selection.
+ * @param outcome - what the selection did.
+ * @param enabled - the selected state.
+ * @param logged - the logged state after the selection.
+ * @returns the confirmation shown to the user.
+ */
+function selectionText(outcome: WebSearchSelectionOutcome, enabled: boolean, logged: boolean): string {
+  const state = enabled ? 'on' : 'off'
+  const queued = `Turning web search ${state} (applies from the next step).`
+  const texts: Record<WebSearchSelectionOutcome, string> = {
+    committed: `Web search ${state}.`,
+    queued,
+    cancelled: `Web search stays ${state}.`,
+    // Repeat the queued wording while the selection still awaits the next
+    // accepted pre-step; only a matching logged state reads idempotent.
+    noop: logged === enabled ? `Web search is already ${state}.` : queued,
+  }
+  return texts[outcome]
+}
+
+/**
+ * Build the `/web on|off` command.
+ * @param selections - the switch state the command selects.
+ * @param openTurn - whether a Session has an open turn.
+ * @returns the command definition.
+ */
+function webSearchCommand(
+  selections: WebSearchSelections,
+  openTurn: (session: Session) => boolean,
+): CommandDefinition {
+  return {
+    definitionId: brandString<CommandDefinitionId>('@deepseek-ai/dsh-tool-web'),
+    name: WEB_SEARCH_COMMAND,
+    description: 'Turn web search on or off for this session',
+    input: { hint: 'on|off' },
+    handler: ({ agent, rawInput }): CommandResult => {
+      const enabled = selectedState(rawInput)
+      if (enabled === undefined) return { kind: 'error', text: 'Use /web on or /web off.' }
+      const session = agent.session
+      const outcome = selections.select(session, enabled, openTurn(session))
+      return { kind: 'success', text: selectionText(outcome, enabled, selections.logged(session)) }
+    },
+  }
+}
+
+/**
+ * Install the web-search switch under tool-web's plugin context. The
+ * projection child activates once `ctx.sessionProjections` exists and owns the
+ * `webSearch` unit, the pre-step append, and the prefix-matched tool
+ * restrictions; its nested command child adds `/web` once `ctx.commands` and
+ * `ctx.agents` exist. Both children unwind with the plugin.
+ * @param ctx - tool-web's plugin context.
+ * @param toolPrefixes - validated name prefixes of other inherited tools withheld while the state is off.
+ * @returns the admission check `web_search` and `web_fetch` combine with provider readiness.
+ */
+export function applyWebSearchSwitch(ctx: Context, toolPrefixes: readonly string[]): WebSearchAdmission {
+  const active: { selections: WebSearchSelections | undefined; activating: boolean } = { selections: undefined, activating: false }
+
+  ctx.inject(['sessionProjections'], async (projectionCtx) => {
+    active.activating = true
+    let handle: ProjectionHandle<WebSearchUnitState>
+    try {
+      handle = await projectionCtx.sessionProjections.register(webSearchProjectionDefinition)
+    } finally {
+      active.activating = false
+    }
+    const selections = new WebSearchSelections(handle)
+    const denials = new WebToolDenials(ctx, toolPrefixes)
+    projectionCtx.effect(() => {
+      active.selections = selections
+      return () => {
+        active.selections = undefined
+        denials.releaseAll()
+      }
+    }, 'dsh-tool-web: web search switch')
+
+    // Restore the restriction a resumed or forked Session logged before its
+    // first step; a failure leaves the Agent usable and is retried at the
+    // next accepted pre-step.
+    projectionCtx.on('agent/created', ({ agent }) => {
+      try {
+        denials.update(agent, selections.selected(agent.session))
+      } catch (error) {
+        projectionCtx.logger.warn('dsh-tool-web: failed to withhold web tools for a new agent: %o', error)
+      }
+    })
+    projectionCtx.on('agent/disposed', ({ agent }) => { denials.forget(agent) })
+
+    // Pre-step is outside Session.append publication, so it can append the
+    // log-only state event inside an open turn. Tool admission for this step
+    // already read the selected state; re-deriving the restriction here covers
+    // matching tools registered since, from the next step. Failures stay
+    // pending or retried at a later accepted pre-step and cannot block the step.
+    projectionCtx.on('agent/pre-step', async ({ agent, signal }, next): Promise<PreStepDecision> => {
+      const decision = await next()
+      if (decision.kind === 'reject' || signal.aborted) return decision
+      try {
+        selections.flush(agent.session)
+      } catch (error) {
+        projectionCtx.logger.warn('dsh-tool-web: failed to append the selected web search state at step start: %o', error)
+      }
+      try {
+        denials.update(agent, selections.selected(agent.session))
+      } catch (error) {
+        projectionCtx.logger.warn('dsh-tool-web: failed to withhold web tools at step start: %o', error)
+      }
+      return decision
+    })
+
+    projectionCtx.inject(['commands', 'agents'], (commandCtx) => {
+      commandCtx.on('session/event', (session, event) => {
+        if (event.type !== 'command/done' && event.type !== 'web/search') return
+        const agent = commandCtx.agents.get(session.id)
+        if (agent === undefined || agent.session !== session || commandCtx.commands.find(agent, WEB_SEARCH_COMMAND) === undefined) return
+        try {
+          denials.update(agent, selections.selected(session))
+        } catch (error) {
+          commandCtx.logger.warn('dsh-tool-web: failed to withhold web tools after a selection: %o', error)
+        }
+      })
+      commandCtx.commands.register(webSearchCommand(
+        selections,
+        session => commandCtx.agents.turnBoundaryOf(session).openTurnStartSeq !== null,
+      ))
+    })
+  })
+
+  return (agent) => {
+    if (active.selections !== undefined) return active.selections.selected(agent.session)
+    if (active.activating) {
+      throw new Error('the web search switch is not ready; await plugin activation before running an agent')
+    }
+    return true
+  }
+}
diff --git a/packages/web/tool-web/src/types.ts b/packages/web/tool-web/src/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..73e56a1bdc541d47f39b58334928f924ff425c1f
--- /dev/null
+++ b/packages/web/tool-web/src/types.ts
@@ -0,0 +1,41 @@
+/**
+ * Pure types of the per-Session web-search switch: the one home of the
+ * `webSearch` projection-key declaration, free of this package's host-side
+ * value imports (cordis, dsh-tools, dsh-web). Two namespace projections serve
+ * it — `./types` for host consumers and `./client` for client aggregates —
+ * with zero content duplication.
+ *
+ * @module @deepseek-ai/dsh-tool-web/types
+ */
+
+import type { CommandId } from '@deepseek-ai/dsh-commands/brand'
+
+/**
+ * The `webSearch` projection's wire value. `enabled` is the logged state in
+ * force (the last `web/search`, enabled before the first); `pending` is true
+ * while a successfully settled `/web` selection targets the other state
+ * and no later `web/search` event has
+ * recorded that state. The key is globally registered; its presence alone
+ * does not establish that a Session's agent scope offers the `/web` command.
+ */
+export interface WebSearchProjection {
+  enabled: boolean
+  pending: boolean
+}
+
+/** Host state used to derive {@link WebSearchProjection}. */
+export interface WebSearchUnitState {
+  /** Logged web-search state. */
+  enabled: boolean
+  /** The settled selection's target state; null when no selection is outstanding. */
+  wanted: boolean | null
+  /** Unsettled `/web` targets keyed by their lifecycle id; settlement removes each entry. */
+  running: Partial<Record<CommandId, boolean>>
+}
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    /** Web-search switch state folded from the `/web` command lifecycle and `web/search` events. */
+    webSearch: WebSearchProjection
+  }
+}
diff --git a/packages/web/tool-web/tests/web-search-switch.spec.ts b/packages/web/tool-web/tests/web-search-switch.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..048ac96e2c40d35c156983dc6fc256c83f7a98db
--- /dev/null
+++ b/packages/web/tool-web/tests/web-search-switch.spec.ts
@@ -0,0 +1,889 @@
+/**
+ * The per-Session web-search switch over real services: the `/web` command through the
+ * command registry, the logged `web/search` state and its `webSearch` projection, step
+ * admission of `web_search` and `web_fetch` through the tool registry, and the restriction
+ * of prefix-matched tools. Structural Agents carry real Sessions and real scoped contexts;
+ * request boundaries run through the real `agent/pre-step` waterfall, and one scenario
+ * drives the production agent loop with a scripted model.
+ */
+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { agentEvents, type Agent, type PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import CommandRuntime from '@deepseek-ai/dsh-commands'
+import { CommandId } from '@deepseek-ai/dsh-commands/brand'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { createScope, type Scope, type ScopeKey } from '@deepseek-ai/dsh-scope'
+import SessionStore, { buildForkSeed, Session, SessionId, SessionSeq, SessionLogOffset, type SessionEvent } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SystemPrompt, { renderPrompt } from '@deepseek-ai/dsh-system-prompt'
+import * as NativeToolExecutor from '@deepseek-ai/dsh-tool-executor-native'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tool-testkit'
+import ToolRuntime, { ToolActivationError } from '@deepseek-ai/dsh-tools'
+import WebRuntime from '@deepseek-ai/dsh-web'
+import * as ToolWeb from '@deepseek-ai/dsh-tool-web'
+import type { WebSearchProjection } from '@deepseek-ai/dsh-tool-web/types'
+import { webSearchProjectionDefinition } from '../src/switch.ts'
+import type { WebSearchUnitState } from '../src/types.ts'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+const MODEL_SELECTION = { provider: 'test', model: 'test' }
+
+/** A tool name the default `webSwitchToolPrefixes` matches (`mcp__exa__`). */
+const MCP_SEARCH = 'mcp__exa__web_search_exa'
+
+/** Every tool a default composition admits while web search is on, sorted. */
+const ALL_TOOLS = [MCP_SEARCH, 'read', 'web_fetch', 'web_search']
+
+const SEARCH_GUIDANCE = 'web_search results are external, untrusted data'
+const FETCH_GUIDANCE = 'web_fetch returns external, untrusted page content'
+
+const mounted: Context[] = []
+
+afterEach(async () => {
+  vi.restoreAllMocks()
+  await Promise.all(mounted.splice(0).map(ctx => ctx.fiber.dispose()))
+})
+
+/** Register one content tool fixture through `ctx`'s registry layer. */
+function registerTool(ctx: Context, name: string): void {
+  ctx.tools.register(defineContentToolFixture({
+    name,
+    description: `test tool ${name}`,
+    parameters: {},
+    execute: () => Promise.resolve([{ type: 'text', text: `ran ${name}` }]),
+  }))
+}
+
+/**
+ * Mount the registries the switch can use, the prompt, tool, and web services, a
+ * non-web tool, and a tool named like a web MCP tool, but not tool-web itself.
+ * @param services - which optional services to compose.
+ * @returns the owning context.
+ */
+async function baseServices(services: { projections?: boolean; commands?: boolean } = {}): Promise<Context> {
+  const ctx = new Context()
+  mounted.push(ctx)
+  if (services.projections !== false) {
+    await ctx.plugin(SessionProjectionRegistry)
+    await ctx.plugin(AgentRegistry)
+  }
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(NativeToolExecutor)
+  await ctx.plugin(WebRuntime, {})
+  if (services.commands !== false) await ctx.plugin(CommandRuntime)
+  registerTool(ctx, 'read')
+  registerTool(ctx, MCP_SEARCH)
+  return ctx
+}
+
+/**
+ * {@link baseServices} plus tool-web. When the switch can activate, returns only after
+ * it reads the log, so Agents created afterwards reach its creation listener.
+ * @param config - tool-web config.
+ * @param services - which optional services to compose.
+ * @returns the context and tool-web's fiber.
+ */
+async function compose(config: ToolWeb.Config = {}, services: { projections?: boolean; commands?: boolean } = {}) {
+  const ctx = await baseServices(services)
+  const fiber = await ctx.plugin(ToolWeb, config)
+  if (services.projections !== false && (config.search !== false || config.fetch !== false)) await switchActive(ctx)
+  return { ctx, fiber }
+}
+
+let probes = 0
+
+/**
+ * Wait until the switch reads the log: a probe Agent whose log recorded web search
+ * off stops being offered either web tool.
+ */
+async function switchActive(ctx: Context): Promise<void> {
+  const { agent } = await agentWithSession(ctx, `switch-probe-${++probes}`, { seed: offLog() })
+  await vi.waitFor(async () => {
+    const names = await admitted(ctx, agent)
+    expect(names).not.toContain('web_search')
+    expect(names).not.toContain('web_fetch')
+  })
+}
+
+/**
+ * A structural Agent with a real Session and a real scoped context. With the agent
+ * registry composed it is entered and announced, as the loop does at startup.
+ * @param ctx - the owning context.
+ * @param id - shared Agent and Session id.
+ * @param options - seed events and the scope the Agent is bound under.
+ * @returns the Agent and its registry detach capability.
+ */
+async function agentWithSession(
+  ctx: Context, id: string, options: { seed?: readonly SessionEvent[]; parent?: ScopeKey } = {},
+): Promise<{ agent: Agent; detach: () => void }> {
+  if (ctx.get('sessions') === undefined) await ctx.plugin(SessionStore)
+  const holder: { id: SessionId; session: Session; ctx?: Context } = {
+    id: SessionId(id),
+    session: Session.create(SessionId(id), options.seed),
+  }
+  const agent = holder as Agent
+  await ctx.plugin(Object.assign((inner: Context) => {
+    holder.ctx = createScope(inner, agent, options.parent === undefined ? undefined : { parent: options.parent }).ctx
+  }, { inject: ['tools', 'sessions'] }))
+  holder.session = agent.ctx.sessions.create(SessionId(id), options.seed === undefined ? undefined : { seed: options.seed })
+  const agents = ctx.get('agents')
+  if (agents === undefined) return { agent, detach: () => {} }
+  const detach = agents.enter(agent, undefined)
+  await agents.announce(agent, 'startup')
+  return { agent, detach }
+}
+
+/**
+ * Wait until the switch's command child activated for the Agent. The switch's
+ * plugin children mount asynchronously after tool-web's own activation.
+ */
+async function switchReady(ctx: Context, agent: Agent): Promise<void> {
+  await vi.waitFor(() => { expect(ctx.commands.find(agent, 'web')).toBeDefined() })
+}
+
+/** Resolve one step's admitted tool names, as the loop does before assembly. */
+async function admitted(ctx: Context, agent: Agent): Promise<string[]> {
+  const toolSet = await ctx.tools.resolve({ agent, modelSelection: MODEL_SELECTION, signal: new AbortController().signal })
+  try {
+    return [...toolSet.view(agent).keys()].sort()
+  } finally {
+    toolSet.dispose()
+  }
+}
+
+/** Render one step's prompt for the Agent with its admitted tools. */
+async function stepPrompt(ctx: Context, agent: Agent): Promise<string> {
+  const toolSet = await ctx.tools.resolve({ agent, modelSelection: MODEL_SELECTION, signal: new AbortController().signal })
+  try {
+    return renderPrompt(await ctx.systemPrompt.assemble({ scope: agent, agent, modelSelection: MODEL_SELECTION, toolSet }))
+  } finally {
+    toolSet.dispose()
+  }
+}
+
+/** Run one `/web` line and return its settled result. */
+async function web(ctx: Context, agent: Agent, args: string) {
+  return (await ctx.commands.execute(agent, `/web${args}`, [], new AbortController().signal))?.result
+}
+
+/** Dispatch one proposed step through the real pre-step waterfall. */
+async function preStep(
+  ctx: Context, agent: Agent, verdict: 'enter' | 'reject' = 'enter', signal = new AbortController().signal,
+): Promise<PreStepDecision> {
+  const message = createUserMessage({ content: [{ type: 'text', text: 'boundary probe' }], source: { kind: 'user' } })
+  return agentEvents(ctx, agent).waterfall(
+    'agent/pre-step',
+    { modelSelection: MODEL_SELECTION, messages: [message], turn: 1, step: 1, signal },
+    () => Promise.resolve<PreStepDecision>(verdict === 'enter' ? { kind: 'enter', messages: [message] } : { kind: 'reject' }),
+  )
+}
+
+function openTurn(session: Session, turn = 1): void {
+  session.append('turn/start', { turn })
+}
+
+function closeTurn(session: Session, turn = 1): void {
+  session.append('turn/end', { turn, reason: { kind: 'completed' } })
+}
+
+/** The logged `web/search` payloads, in order. */
+function webSearchEvents(agent: Agent): { enabled: boolean }[] {
+  return agent.session.snapshotEvents().flatMap(event => event.type === 'web/search' ? [event.data] : [])
+}
+
+function projection(ctx: Context, agent: Agent): WebSearchProjection | undefined {
+  return ctx.sessionProjections.snapshot(agent.session).values.webSearch
+}
+
+const QUEUED_OFF = { kind: 'success', text: 'Turning web search off (applies from the next step).' }
+const QUEUED_ON = { kind: 'success', text: 'Turning web search on (applies from the next step).' }
+
+describe('web-search switch defaults', () => {
+  it('admits both web tools and serves the enabled state for a log without web/search', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'default-agent')
+    await switchReady(ctx, agent)
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: false })
+    expect(ctx.commands.list(agent)).toContainEqual({
+      definitionId: '@deepseek-ai/dsh-tool-web',
+      name: 'web',
+      description: 'Turn web search on or off for this session',
+      input: { hint: 'on|off' },
+    })
+    const prompt = await stepPrompt(ctx, agent)
+    expect(prompt).toContain(SEARCH_GUIDANCE)
+    expect(prompt).toContain(FETCH_GUIDANCE)
+  })
+
+  it('defaults the switch tool prefixes to common web MCP servers', () => {
+    expect(ToolWeb.DEFAULT_WEB_SWITCH_TOOL_PREFIXES).toEqual([
+      'mcp__exa__', 'mcp__tavily', 'mcp__brave', 'mcp__perplexity', 'mcp__firecrawl', 'mcp__fetch__', 'mcp__jina',
+    ])
+  })
+})
+
+describe('/web between turns', () => {
+  it('/web off durably selects off and withholds web tools and guidance before pre-step consolidation; /web on restores them', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'idle-agent')
+    await switchReady(ctx, agent)
+
+    expect(await web(ctx, agent, ' off')).toEqual({ kind: 'success', text: 'Web search off.' })
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: true })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    expect(webSearchEvents(agent)).toEqual([])
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+    expect(projection(ctx, agent)).toEqual({ enabled: false, pending: false })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    const offPrompt = await stepPrompt(ctx, agent)
+    expect(offPrompt).not.toContain(SEARCH_GUIDANCE)
+    expect(offPrompt).not.toContain(FETCH_GUIDANCE)
+
+    expect(await web(ctx, agent, ' on')).toEqual({ kind: 'success', text: 'Web search on.' })
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }, { enabled: true }])
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: false })
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+    expect(await stepPrompt(ctx, agent)).toContain(SEARCH_GUIDANCE)
+  })
+
+  it('answers an already-selected state with idempotent wording and logs nothing', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'idempotent-agent')
+    await switchReady(ctx, agent)
+    expect(await web(ctx, agent, ' on')).toEqual({ kind: 'success', text: 'Web search is already on.' })
+    expect(webSearchEvents(agent)).toEqual([])
+    await web(ctx, agent, ' off')
+    expect(await web(ctx, agent, '   off  ')).toEqual(QUEUED_OFF)
+    expect(webSearchEvents(agent)).toEqual([])
+    await preStep(ctx, agent)
+    expect(await web(ctx, agent, ' off')).toEqual({ kind: 'success', text: 'Web search is already off.' })
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+  })
+
+  it('rejects any argument other than on or off without changing the state', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'bad-argument-agent')
+    await switchReady(ctx, agent)
+    for (const args of ['', ' ', ' maybe', ' ON', ' off now']) {
+      expect(await web(ctx, agent, args)).toEqual({ kind: 'error', text: 'Use /web on or /web off.' })
+    }
+    expect(webSearchEvents(agent)).toEqual([])
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: false })
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+  })
+})
+
+describe('/web during an open turn', () => {
+  it('keeps the selection pending, admits from it at once, and appends it at the next accepted pre-step only', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'turn-agent')
+    await switchReady(ctx, agent)
+    openTurn(agent.session)
+
+    expect(await web(ctx, agent, ' off')).toEqual(QUEUED_OFF)
+    expect(webSearchEvents(agent)).toEqual([])
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: true })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    expect(await web(ctx, agent, ' off')).toEqual(QUEUED_OFF)
+
+    await preStep(ctx, agent, 'reject')
+    expect(webSearchEvents(agent)).toEqual([])
+    const aborted = new AbortController()
+    aborted.abort()
+    await preStep(ctx, agent, 'enter', aborted.signal)
+    expect(webSearchEvents(agent)).toEqual([])
+    expect(projection(ctx, agent)).toEqual({ enabled: true, pending: true })
+
+    const decision = await preStep(ctx, agent)
+    expect(decision.kind).toBe('enter')
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+    expect(projection(ctx, agent)).toEqual({ enabled: false, pending: false })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+  })
+
+  it('a reversal of a pending selection cancels it, restores the tools, and logs nothing', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'cancel-agent', { seed: offLog() })
+    await switchReady(ctx, agent)
+    openTurn(agent.session)
+
+    expect(await web(ctx, agent, ' on')).toEqual(QUEUED_ON)
+    expect(projection(ctx, agent)).toEqual({ enabled: false, pending: true })
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+
+    expect(await web(ctx, agent, ' off')).toEqual({ kind: 'success', text: 'Web search stays off.' })
+    expect(projection(ctx, agent)).toEqual({ enabled: false, pending: false })
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+  })
+
+  it('carries a selection made after the last step into the next turn and cancels it between turns', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'next-turn-agent')
+    await switchReady(ctx, agent)
+    openTurn(agent.session)
+    await web(ctx, agent, ' off')
+    closeTurn(agent.session)
+    expect(await admitted(ctx, agent)).toEqual(['read'])
+    expect(await web(ctx, agent, ' on')).toEqual({ kind: 'success', text: 'Web search stays on.' })
+    expect(await admitted(ctx, agent)).toEqual(ALL_TOOLS)
+
+    openTurn(agent.session, 2)
+    await web(ctx, agent, ' off')
+    closeTurn(agent.session, 2)
+    openTurn(agent.session, 3)
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+  })
+
+  it('clears a pending selection the log already records without a second event', async () => {
+    const { ctx } = await compose()
+    const { agent } = await agentWithSession(ctx, 'recorded-agent')
+    await switchReady(ctx, agent)
+    openTurn(agent.session)
+    await web(ctx, agent, ' off')
+    agent.session.append('web/search', { enabled: false })
+    await preStep(ctx, agent)
+    expect(webSearchEvents(agent)).toEqual([{ enabled: false }])
+    expect(projection(ctx, agent)).toEqual({ enabled: false, pending: false })
+  })
+
+  it('keeps a selection pending when its append fails and appends it at a later accepted pre-step', async () => {
+    const { ctx } = await compose()
+    const warn = vi.spyOn(ctx.logger, 'warn')
