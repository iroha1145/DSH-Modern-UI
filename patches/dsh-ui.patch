+  /* control: snappy, precise; m 1, k 604, c 44.73.
+   * 3.91 Hz gives the crisp control response; damping ratio 0.91 avoids visible overshoot.
+   * Duration computed from the settle time plus the official export tail. */
+  --dsh-feel-control-duration: 225ms; /* computed from Feel.words and its official CSS export */
+  --dsh-feel-control-curve: linear(0, 0.0062 2.1%, 0.0231 4.2%, 0.0485 6.3%, 0.0804 8.3%, 0.1173 10.4%, 0.1578 12.5%, 0.2007 14.6%, 0.2451 16.7%, 0.29 18.8%, 0.335 20.8%, 0.3794 22.9%, 0.4228 25%, 0.4649 27.1%, 0.5055 29.2%, 0.5443 31.3%, 0.5812 33.3%, 0.6161 35.4%, 0.649 37.5%, 0.6799 39.6%, 0.7088 41.7%, 0.7357 43.8%, 0.7607 45.8%, 0.7838 47.9%, 0.8051 50%, 0.8247 52.1%, 0.8427 54.2%, 0.8592 56.3%, 0.8742 58.3%, 0.8879 60.4%, 0.9004 62.5%, 0.9117 64.6%, 0.9219 66.7%, 0.9311 68.8%, 0.9394 70.8%, 0.9469 72.9%, 0.9535 75%, 0.9595 77.1%, 0.9648 79.2%, 0.9696 81.3%, 0.9738 83.3%, 0.9775 85.4%, 0.9808 87.5%, 0.9837 89.6%, 0.9862 91.7%, 0.9884 93.8%, 0.9904 95.8%, 0.9921 97.9%, 1);
+  /* dialog: crisp; m 1, k 570.1, c 43.93.
+   * 3.8 Hz gives the crisp control response; damping ratio 0.92 avoids visible overshoot.
+   * Duration computed from the settle time plus the official export tail. */
+  --dsh-feel-dialog-duration: 237ms; /* computed from Feel.words and its official CSS export */
+  --dsh-feel-dialog-curve: linear(0, 0.0065 2.1%, 0.024 4.2%, 0.0504 6.3%, 0.0834 8.3%, 0.1214 10.4%, 0.163 12.5%, 0.2069 14.6%, 0.2521 16.7%, 0.2978 18.8%, 0.3434 20.8%, 0.3883 22.9%, 0.432 25%, 0.4743 27.1%, 0.515 29.2%, 0.5537 31.3%, 0.5905 33.3%, 0.6252 35.4%, 0.6578 37.5%, 0.6883 39.6%, 0.7167 41.7%, 0.7432 43.8%, 0.7677 45.8%, 0.7903 47.9%, 0.8111 50%, 0.8302 52.1%, 0.8477 54.2%, 0.8637 56.3%, 0.8783 58.3%, 0.8915 60.4%, 0.9036 62.5%, 0.9144 64.6%, 0.9243 66.7%, 0.9331 68.8%, 0.9411 70.8%, 0.9482 72.9%, 0.9546 75%, 0.9604 77.1%, 0.9654 79.2%, 0.97 81.3%, 0.974 83.3%, 0.9776 85.4%, 0.9807 87.5%, 0.9835 89.6%, 0.9859 91.7%, 0.9881 93.8%, 0.9899 95.8%, 0.9916 97.9%, 1);
