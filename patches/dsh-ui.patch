@@ -0,0 +1,133 @@
+/**
+ * Shared fixtures of the model-settings specs: a catalog whose routes overlap
+ * (one model id served by three routes, one preset-less model, one
+ * single-level model), a models.dev document that prices three of its
+ * models, and ready settings forms.
+ */
+
+import { vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { stubConfigForm } from '@deepseek-ai/dsh-client-test-runtime'
+import type { ModelPickerSettings } from '../src/model-settings.ts'
+import type { ModelCatalogState } from '../src/client/catalog.ts'
+import { presetFor, type ModelPreset, type PresetBlurb } from '../src/client/presets.ts'
+
+/**
+ * The built-in preset of a fixture model. The fixtures name only models that
+ * have one, and specs read their expectations from it rather than pinning the
+ * numbers, so a preset change does not turn a layering spec red.
+ * @param id - fixture model id.
+ * @returns the preset.
+ */
+export function presetOf(id: string): ModelPreset {
+  const preset = presetFor(id)
+  if (preset === undefined) throw new Error(`fixture model "${id}" has no built-in preset`)
+  return preset
+}
+
+/** The loaded catalog value. */
+export type CatalogValue = NonNullable<ModelCatalogState['value']>
+
+/** Effort levels with capitalized names. */
+function levels(...ids: string[]): { id: string; name: string }[] {
+  return ids.map(id => ({ id, name: `${id.slice(0, 1).toUpperCase()}${id.slice(1)}` }))
+}
+
+/**
+ * A catalog in raw group order: external, official, then account. The picker
+ * order puts the account first, so the rows read: deepseek-flash (named by
+ * the account route), gpt-6-luna, claude-opus-5-5, custom-model.
+ * @returns a fresh catalog value.
+ */
+export function catalogValue(): CatalogValue {
+  return {
+    default: { provider: 'deepseek-official', model: 'deepseek-flash' },
+    routableProviders: ['deepseek-official'],
+    failures: [],
+    groups: [
+      {
+        id: 'external',
+        name: 'External',
+        models: [
+          { id: 'custom-model', name: 'Custom Model', description: 'Words from the catalog' },
+          { id: 'deepseek-flash', name: 'Flash (external)', reasoning: { efforts: levels('off', 'high', 'extra'), defaultEffort: 'high' } },
+        ],
+      },
+      {
+        id: 'deepseek-official',
+        name: 'DeepSeek',
+        models: [
+          { id: 'deepseek-flash', name: 'DeepSeek Flash', reasoning: { efforts: levels('off', 'high', 'max'), defaultEffort: 'high' } },
+          { id: 'claude-opus-5-5', name: 'Claude Opus 5.5' },
+        ],
+      },
+      {
+        id: 'deepseek-account',
+        name: 'Account',
+        models: [
+          { id: 'deepseek-flash', name: 'Flash (account)' },
+          { id: 'gpt-6-luna', name: 'GPT Luna', reasoning: { efforts: levels('low'), defaultEffort: 'low' } },
+        ],
+      },
+    ],
+  }
+}
+
+/** A catalog store in the given state. */
+export function catalogStore(state: Partial<ModelCatalogState> = {}) {
+  return createSnapshotStore<ModelCatalogState>({ value: catalogValue(), status: 'ready', error: null, ...state })
+}
+
+/**
+ * A settings form already holding a section.
+ * @param value - the resolved section.
+ * @param user - the raw user layer.
+ * @param writable - whether the document accepts writes.
+ * @returns the stub handle.
+ */
+export function readyForm(value: ModelPickerSettings = {}, user?: unknown, writable = true) {
+  const form = stubConfigForm<ModelPickerSettings>()
+  form.publish({ status: 'ready', value, user: user ?? value, writable, revision: 1 })
+  return form
+}
+
+/**
+ * The public price document, with prices for three of the catalog's models.
+ * @returns a parsed models.dev document.
+ */
+export function priceDocument(): unknown {
+  return {
+    deepseek: { models: { 'deepseek-flash': { cost: { input: 0.14, output: 0.28, cache_read: 0.0028 } } } },
+    [presetOf('gpt-6-luna').vendor]: { models: { 'gpt-6-luna': { cost: { input: 0.2, output: 0.8 } } } },
+    [presetOf('claude-opus-5-5').vendor]: { models: { 'claude-opus-5-5': { cost: { input: 5, output: 25 } } } },
+  }
+}
+
+/** The prices the document above yields for the catalog above: routed through the account's own provider, then each model's vendor. */
+export const FETCHED_PRICES = {
+  'deepseek-flash': { input: 0.14, output: 0.28, cacheRead: 0.0028, provider: 'deepseek' },
+  'gpt-6-luna': { input: 0.2, output: 0.8, provider: presetOf('gpt-6-luna').vendor },
+  'claude-opus-5-5': { input: 5, output: 25, provider: presetOf('claude-opus-5-5').vendor },
+}
+
+/**
+ * A fetch that answers the price source's document.
+ * @param document - the parsed body to answer with.
+ * @returns the fetch double.
+ */
+export function priceFetch(document: unknown = priceDocument()) {
+  return vi.fn((_url: string | URL | Request, _init?: RequestInit) => Promise.resolve(Response.json(document)))
+}
+
+/** Stand-in for the picker's preset description lookup. */
+export function blurbOf(key: PresetBlurb): string {
+  return `blurb:${key}`
+}
+
+/** Short names the stand-in effort lookup knows; other ids keep the catalog name. */
+const SHORT_EFFORTS: Readonly<Record<string, string>> = { off: '关闭', high: '高', max: '最高' }
+
+/** Stand-in for the picker's reasoning level names. */
+export function effortNameOf(id: string, fallback: string): string {
+  return SHORT_EFFORTS[id] ?? fallback
+}
