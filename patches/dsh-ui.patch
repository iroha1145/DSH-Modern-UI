diff --git a/packages/client/ui-theme/tests/icon-motion-styles.client.spec.ts b/packages/client/ui-theme/tests/icon-motion-styles.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dee25a6a279fe40777b4459e578fba20e1f6355a
--- /dev/null
+++ b/packages/client/ui-theme/tests/icon-motion-styles.client.spec.ts
@@ -0,0 +1,59 @@
+/**
+ * icon-motion.css against the default artwork: every product glyph moves (or is
+ * named as still), every part class and keyframe it names exists, and nothing
+ * moves without a hover-capable pointer or under reduced motion.
+ */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { ICON_SYMBOLS } from '@deepseek-ai/dsh-client-ui-primitives'
+
+const css = readFileSync(fileURLToPath(new URL('../src/styles/icon-motion.css', import.meta.url)), 'utf8')
+
+/** Glyphs that keep still: the loader already spins, and the tree connector is structure, not a control. */
+const STILL = new Set(['loading-outline', 'tree-corner'])
+
+const symbols = Object.entries(ICON_SYMBOLS)
+const glyphs = new Set(symbols.map(([id]) => id.replace(/^dsw-icon-/, '').replace(/-(?:regular|medium)$/, '')))
+const partClasses = (markup: string): string[] =>
+  [...markup.matchAll(/ class="([^"]*)"/g)].flatMap(match => match[1]!.split(/\s+/))
+const cssClasses = new Set([...css.matchAll(/\.dsw-motion-([a-z-]+)/g)].map(match => match[1]!))
+const cssGlyphs = new Set([...css.matchAll(/data-icon\^="dsw-icon-([a-z0-9-]+)-"/g)].map(match => match[1]!))
+const keyframes = new Set([...css.matchAll(/@keyframes ([a-z-]+)/g)].map(match => match[1]!))
+
+describe('icon motion styles', () => {
+  it('gives every product glyph a whole-glyph or part motion except the still ones', () => {
+    const moving = new Set(symbols.filter(([, markup]) => partClasses(markup).length > 0)
+      .map(([id]) => id.replace(/^dsw-icon-/, '').replace(/-(?:regular|medium)$/, '')))
+    const missing = [...glyphs].filter(glyph => !STILL.has(glyph) && !moving.has(glyph) && !cssGlyphs.has(glyph))
+    expect(missing).toEqual([])
+    expect([...STILL].filter(glyph => moving.has(glyph) || cssGlyphs.has(glyph))).toEqual([])
+    expect([...cssGlyphs].filter(glyph => !glyphs.has(glyph))).toEqual([])
+  })
+
+  it('styles every part class the artwork uses, and draws only measured paths', () => {
+    for (const [id, markup] of symbols) {
+      for (const name of partClasses(markup)) {
+        expect(name, id).toMatch(/^dsw-motion-/)
+        expect(cssClasses.has(name.slice('dsw-motion-'.length)), `${id} ${name}`).toBe(true)
+      }
+      for (const [tag] of markup.matchAll(/<[a-z]+ class="[^"]*\bdsw-motion-draw\b[^>]*>/g)) {
+        expect(tag, id).toContain(' pathLength="1"')
+      }
+    }
+  })
+
+  it('defines every keyframes rule a motion falls back to', () => {
+    const named = [...css.matchAll(/var\(--dsw-icon-play, ([a-z-]+)\)/g)].map(match => match[1]!)
+    expect(named.length).toBeGreaterThan(0)
+    expect(named.filter(name => !keyframes.has(name))).toEqual([])
+  })
+
+  it('switches motion on only for hover-capable pointers without reduced motion', () => {
+    expect(css.match(/--dsw-icon-play: initial;/g)).toHaveLength(1)
+    const gate = css.indexOf('@media (hover: hover) and (prefers-reduced-motion: no-preference) {')
+    expect(gate).toBeGreaterThan(-1)
+    expect(css.indexOf('--dsw-icon-play: initial;')).toBeGreaterThan(gate)
+    expect(css).toMatch(/:where\(svg\[data-icon\]\) \{\n {2}--dsw-icon-play: none;\n {2}--dsw-icon-on: 0;\n\}/)
+  })
+})
