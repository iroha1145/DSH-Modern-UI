+/** Actual Chat reasoning with delayed anonymous translation and a controlled keyless stream. */
+import { once } from 'node:events'
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { createServer, type ServerResponse } from 'node:http'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium, type Locator } from 'playwright'
+import { expect, it } from 'vitest'
+import { LlmAdapter, type GenerateOptions, type StreamChunk } from '@deepseek-ai/dsh-llm'
+import type {} from '@deepseek-ai/dsh-agent-default-model'
+import { launchWebScaffold, watchConsole } from './scaffold.ts'
+import { connectFreshWorkspace, expandOwningTurnProcess, newEnglishPage, writeComposerDraft } from './support.ts'
+
+const BUNDLE = fileURLToPath(new URL('../../../packages/experimental/cot-translation-bundle', import.meta.url))
+const PARTS = ['## Original heading\n\n', '**Completed reasoning**\n\nUnfinished tail', ' continues with details.']
+const TRANSLATED_TAIL = '译文末段：' + '检查上下文和待办步骤，保留完整内容。'.repeat(12)
+const TRANSLATED_CODE = 'const translatedValue = "' + 'long_translation_value_'.repeat(24) + '"'
+const TRANSLATIONS = ['## 译文标题', '**已完成的思考段落**', [TRANSLATED_TAIL,
+  '```ts\n' + TRANSLATED_CODE + '\n```',
+  '| 第一列 | 第二列 | 第三列 | 第四列 |\n| --- | --- | --- | --- |\n| 内容 | 内容 | 内容 | 内容 |',
+  '$$\nx^2 + y^2 = z^2\n$$',
+].join('\n\n')]
+
+class TranslationReasoningAdapter extends LlmAdapter {
+  override async listModels(provider: string) { return [{ provider, id: 'paused', name: `${provider}/paused` }] }
+  readonly stages = PARTS.map(text => ({ text, arrived: Promise.withResolvers<undefined>(), proceed: Promise.withResolvers<undefined>() }))
+  release(): void { for (const stage of this.stages) stage.proceed.resolve(undefined) }
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    yield { type: 'block-start', index: 0, blockType: 'reasoning' }
+    for (const stage of this.stages) {
+      yield { type: 'reasoning-delta', index: 0, text: stage.text }
+      stage.arrived.resolve(undefined)
+      await stage.proceed.promise
+      options.signal?.throwIfAborted()
+    }
+    yield { type: 'block-end', index: 0, block: { type: 'reasoning', text: PARTS.join('') } }
+    yield { type: 'block-start', index: 1, blockType: 'text' }
+    yield { type: 'text-delta', index: 1, text: 'Translation fixture done' }
+    yield { type: 'block-end', index: 1, block: { type: 'text', text: 'Translation fixture done' } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+async function expectContained(body: Locator): Promise<void> {
+  const geometry = await body.evaluate((element) => {
+    const rect = element.getBoundingClientRect()
+    return { left: rect.left, right: rect.right, viewport: innerWidth, scroll: element.scrollWidth, client: element.clientWidth }
+  })
+  expect(geometry.left).toBeGreaterThanOrEqual(0)
+  expect(geometry.right).toBeLessThanOrEqual(geometry.viewport)
+  expect(geometry.scroll).toBeLessThanOrEqual(geometry.client + 1)
+}
+
+it('keeps translated reasoning visible through delayed streaming, view switches, completion, and disclosure changes', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-reasoning-translation-ui-'))
+  const requests: { text: string; response: ServerResponse }[] = []
+  const fixtureErrors: unknown[] = []
+  const server = createServer((request, response) => {
+    void (async () => {
+      let body = ''
+      for await (const chunk of request) body += String(chunk)
+      const texts: unknown = JSON.parse(body)
+      if (!Array.isArray(texts) || typeof texts[0] !== 'string') { response.writeHead(400); response.end(); return }
+      requests.push({ text: texts[0], response })
+    })().catch((error: unknown) => { fixtureErrors.push(error); response.destroy() })
+  })
+  const adapter = new TranslationReasoningAdapter()
+  let scaffold: Awaited<ReturnType<typeof launchWebScaffold>> | undefined
+  let browser: Awaited<ReturnType<typeof chromium.launch>> | undefined
+  try {
+    server.listen(0, '127.0.0.1')
+    await once(server, 'listening')
+    const address = server.address()
+    if (address === null || typeof address === 'string') throw new Error('Translation fixture requires an allocated port')
+    const overlay = join(root, 'translator.patch.yml')
+    await writeFile(overlay, `- id: translator\n  config: ${JSON.stringify({ bingEndpoint: `http://127.0.0.1:${address.port}/bing`, timeoutMs: 120_000 })}\n- id: cot-translation\n  config: { provider: bing, targetLanguage: zh }\n`)
+    scaffold = await launchWebScaffold({ profile: { packages: [{ dir: BUNDLE, enabled: true }] }, extraOverlayPath: overlay })
+    scaffold.ctx.effect(() => scaffold!.ctx.llm.registerAdapter(['translation-reasoning-test'], adapter))
+    await scaffold.ctx.agentDefaultModel.saveSelection({ provider: 'translation-reasoning-test', model: 'paused' })
+    const executablePath = process.env.DSH_PLAYWRIGHT_EXECUTABLE_PATH
+    browser = await chromium.launch(executablePath === undefined ? {} : { executablePath })
+    const page = await newEnglishPage(browser)
+    const console = watchConsole(page)
+    await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+    await connectFreshWorkspace(page, scaffold.workspaceCwd)
+    await page.setViewportSize({ width: 360, height: 1000 })
+    const input = page.locator('[data-composer-input]').first()
+    const settled = scaffold.whenTurnSettled()
+    await writeComposerDraft(page, input, 'Show reasoning and translate its completed paragraphs.')
+    await input.press('Enter')
+    const [first, second, third] = adapter.stages
+    if (first === undefined || second === undefined || third === undefined) throw new Error('Reasoning fixture stages missing')
+    await first.arrived.promise
+    const reasoning = page.locator('[data-variant="think"]').first()
+    await expandOwningTurnProcess(page, reasoning)
+    await reasoning.waitFor()
+    const disclosure = reasoning.locator('[data-disclosure-row]').first()
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('false')
+    expect(requests).toHaveLength(0)
+    await disclosure.click()
+    const body = reasoning.locator('[data-cot-translation]')
+    await body.getByRole('heading', { name: 'Original heading', exact: true }).waitFor()
+    await expect.poll(() => requests.length).toBe(1)
+    expect(requests[0]?.text).toBe('## Original heading')
+    expect(await body.getAttribute('data-translation-state')).toBe('pending')
+    requests[0]!.response.writeHead(200, { 'content-type': 'application/json' })
+    requests[0]!.response.end(JSON.stringify([{ translations: [{ text: '   ', to: 'zh-Hans' }] }]))
+    await expect.poll(() => body.getAttribute('data-translation-state')).not.toBe('pending')
+    expect(await body.locator('[data-markdown-variant]').textContent(), 'A blank translation must retain the original reasoning')
+      .toContain('Original heading')
+    expect(await body.getAttribute('data-translation-state')).toBe('failed')
+    await body.getByRole('heading', { name: 'Original heading', exact: true }).waitFor()
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('true')
+    await body.getByRole('button', { name: 'Retry', exact: true }).click()
+    await expect.poll(() => requests.length).toBe(2)
+    requests[1]!.response.writeHead(200, { 'content-type': 'application/json' })
+    requests[1]!.response.end(JSON.stringify([{ translations: [{ text: TRANSLATIONS[0], to: 'zh-Hans' }] }]))
+    await body.getByRole('heading', { name: '译文标题', exact: true }).waitFor()
+    await body.getByRole('button', { name: 'View original', exact: true }).click()
+    await body.getByRole('heading', { name: 'Original heading', exact: true }).waitFor()
+    await body.getByRole('button', { name: 'View translation', exact: true }).click()
+    await body.getByRole('heading', { name: '译文标题', exact: true }).waitFor()
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('true')
+    first.proceed.resolve(undefined)
+    await second.arrived.promise
+    await body.getByText('Unfinished tail', { exact: true }).waitFor()
+    await expect.poll(() => requests.length).toBe(3)
+    requests[2]!.response.writeHead(200, { 'content-type': 'application/json' })
+    requests[2]!.response.end(JSON.stringify([{ translations: [{ text: TRANSLATIONS[1], to: 'zh-Hans' }] }]))
+    await body.getByText('已完成的思考段落', { exact: true }).waitFor()
+    await expectContained(body)
+    second.proceed.resolve(undefined)
+    await third.arrived.promise
+    await body.getByText('Unfinished tail continues with details.', { exact: true }).waitFor()
+    expect(requests).toHaveLength(3)
+    third.proceed.resolve(undefined)
+    await settled
+    await page.getByText('Translation fixture done', { exact: true }).waitFor()
+    await expandOwningTurnProcess(page, reasoning)
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('true')
+    await expect.poll(() => requests.length).toBe(4)
+    const cancelled = requests[3]!.response
+    await disclosure.click()
+    await body.waitFor({ state: 'detached' })
+    await expect.poll(() => cancelled.destroyed).toBe(true)
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('false')
+    await disclosure.click()
+    await expect.poll(() => requests.length).toBe(5)
+    requests[4]!.response.writeHead(200, { 'content-type': 'application/json' })
+    requests[4]!.response.end(JSON.stringify([{ translations: [{ text: TRANSLATIONS[2], to: 'zh-Hans' }] }]))
+    await body.getByText(TRANSLATED_TAIL, { exact: true }).waitFor()
+    await scaffold.ctx.settings.update('ui-theme', { fontSize: 20 })
+    for (const width of [320, 360, 375, 1280]) {
+      await page.setViewportSize({ width, height: 1000 })
+      await body.scrollIntoViewIfNeeded()
+      await expectContained(body)
+    }
+    await disclosure.click()
+    await body.waitFor({ state: 'detached' })
+    expect(await disclosure.getAttribute('aria-expanded')).toBe('false')
+    await disclosure.click()
+    await body.getByText(TRANSLATED_TAIL, { exact: true }).waitFor()
+    expect(requests).toHaveLength(5)
+    expect(console.pageErrors).toEqual([])
+    expect(console.warnings).toEqual([])
+    expect(fixtureErrors).toEqual([])
+  } finally {
+    adapter.release()
+    await browser?.close()
+    await scaffold?.close()
+    for (const { response } of requests) response.destroy()
+    server.closeAllConnections()
+    await new Promise<void>((resolve, reject) => server.close((error) => {
+      if (error) reject(error)
+      else resolve()
+    }))
+    await rm(root, { recursive: true, force: true })
+  }
+})
