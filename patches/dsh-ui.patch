+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import { liveConfig } from '../../../settings/settings/tests/live-config.ts'
+import { plainConfig } from '../../../settings/settings/src/schema.ts'
+import { Config, apply } from '../src/index.ts'
+
+describe('ui-model-selection Host settings', () => {
+  it('accepts picker overrides and fetched prices, and refuses out-of-range values', async () => {
+    const ctx = new Context()
+    const configuration = await liveConfig(ctx, { Config, apply })
+    expect(plainConfig(configuration.fiber.effectiveConfig)).toEqual({ models: {}, prices: {} })
+    const models = {
+      'deepseek-flash': {
+        description: 'Mine', speed: 5, quality: 4, cost: 1, latencyMs: 700, priceInput: 0.3, priceOutput: 1.2, efforts: ['off', 'max'], icon: 'letter',
+      },
+      'claude-opus-5-5': { speed: 2 },
+    }
+    const prices = { 'deepseek-flash': { input: 0.15, output: 0.6, cacheRead: 0.003, provider: 'deepseek' } }
+    await configuration.update({ models, prices, pricesUpdatedAt: '2026-10-25T05:00:00.000Z' })
+    // schemastery materializes an absent array as []; the picker reads an empty list as no override.
+    expect(plainConfig(configuration.fiber.effectiveConfig)).toEqual({
+      models: { ...models, 'claude-opus-5-5': { speed: 2, efforts: [] } },
+      prices,
+      pricesUpdatedAt: '2026-10-25T05:00:00.000Z',
+    })
+    for (const bad of [{ speed: 0 }, { quality: 6 }, { cost: 2.5 }, { latencyMs: -1 }, { priceOutput: -0.1 }]) {
+      await expect(configuration.update({ models: { x: bad } })).rejects.toThrow()
+    }
+    await expect(configuration.update({ prices: { x: { input: 1, provider: 'deepseek' } } })).rejects.toThrow()
+    await configuration.fiber.dispose()
+  })
+})
