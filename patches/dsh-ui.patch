+import {
+  ModelPickerSettingsController, type ModelPickerSettingsDeps, type ModelSettingsState,
+} from '../src/client/settings/controller.ts'
+import type { ModelPickerSettings } from '../src/model-settings.ts'
+import {
+  blurbOf, catalogStore, catalogValue, effortNameOf, FETCHED_PRICES, presetOf, priceDocument, priceFetch, readyForm,
+} from './model-settings-fixtures.client.ts'
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.unstubAllGlobals()
+})
+
+/** A model with a stored override, in both the resolved section and the raw user layer. */
+const STORED = {
+  description: 'Mine',
+  speed: 5,
+  quality: 2,
+  cost: 3,
+  latencyMs: 1234,
+  priceInput: 0.25,
+  priceOutput: 1,
+  efforts: ['off', 'high'],
+}
+
+/** A section holding {@link STORED} for deepseek-flash. */
+function storedSection(): { value: ModelPickerSettings; user: unknown } {
+  return { value: { models: { 'deepseek-flash': { ...STORED } } }, user: { models: { 'deepseek-flash': { ...STORED } } } }
+}
+
+interface BenchOptions {
+  value?: ModelPickerSettings
+  user?: unknown
+  base?: ModelPickerSettings
+  writable?: boolean
+  catalog?: Partial<ModelCatalogState>
+  deps?: Partial<ModelPickerSettingsDeps>
+}
+
+/** A controller over a ready form and a loaded catalog. */
+function bench(options: BenchOptions = {}) {
+  const form = readyForm(options.value ?? {}, options.user, options.writable ?? true)
+  if (options.base !== undefined) form.publish({ base: options.base })
+  const catalog = catalogStore(options.catalog)
+  const loadCatalog = vi.fn()
+  const controller = new ModelPickerSettingsController({
+    form: form.scope, catalog, loadCatalog, blurb: blurbOf, effortName: effortNameOf, ...options.deps,
+  })
+  onTestFinished(() => { controller.dispose() })
+  const state = (): ModelSettingsState => controller.face.hooks.modelSettings.getSnapshot()
+  const editor = () => {
+    const open = state().editor
+    if (open === undefined) throw new Error('no editor is open')
+    return open
+  }
+  return { form, catalog, loadCatalog, controller, face: controller.face, state, editor }
+}
+
+/** The row of one model. */
+function rowOf(state: ModelSettingsState, id: string) {
+  const row = state.rows.find(candidate => candidate.id === id)
+  if (row === undefined) throw new Error(`no row for ${id}`)
+  return row
+}
+
