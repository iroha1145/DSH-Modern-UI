+  it.each([
+    ['refuses the write', () => Promise.resolve(false)],
+    ['fails the write', () => Promise.reject(new Error('connection lost'))],
+  ])('reports a save failure when the Host %s', async (_name, answer) => {
+    const { face, form, state } = bench({ deps: { fetcher: priceFetch() } })
+    form.mutate.mockImplementationOnce(answer)
+
+    face.refreshPrices()
+    await vi.waitFor(() => { expect(state().prices.busy).toBe(false) })
+
+    expect(state().prices.failure).toEqual({ kind: 'save' })
+  })
+
+  it('clears an earlier failure when the next refresh starts', async () => {
+    const fetcher = vi.fn()
+      .mockRejectedValueOnce(new Error('offline'))
+      .mockImplementation(priceFetch())
+    const { face, state } = bench({ deps: { fetcher } })
+    face.refreshPrices()
+    await vi.waitFor(() => { expect(state().prices.failure).toEqual({ kind: 'read', message: 'offline' }) })
+
+    face.refreshPrices()
+    expect(state().prices).toMatchObject({ busy: true, failure: undefined })
+    await vi.waitFor(() => { expect(state().prices.busy).toBe(false) })
+
+    expect(state().prices.failure).toBeUndefined()
+  })
+
+  it('runs one refresh at a time, and none without a writable document or a catalog', async () => {
+    const fetcher = priceFetch()
+    const { face, state } = bench({ deps: { fetcher } })
+    face.refreshPrices()
+    face.refreshPrices()
+    await vi.waitFor(() => { expect(state().prices.busy).toBe(false) })
+    expect(fetcher).toHaveBeenCalledTimes(1)
+
+    const readOnly = bench({ writable: false, deps: { fetcher } })
+    readOnly.face.refreshPrices()
+    const empty = bench({ catalog: { value: null, status: 'loading' }, deps: { fetcher } })
+    empty.face.refreshPrices()
+
+    expect(fetcher).toHaveBeenCalledTimes(1)
+    expect(readOnly.state().prices.busy).toBe(false)
+    expect(empty.state().prices.busy).toBe(false)
+  })
+
+  it('abandons a read in flight when disposed', async () => {
+    const fetcher = vi.fn((_url: string | URL | Request, init?: RequestInit) => new Promise<Response>((_resolve, reject) => {
+      init?.signal?.addEventListener('abort', () => { reject(new DOMException('aborted', 'AbortError')) })
+    }))
+    const { face, form, controller, state } = bench({ deps: { fetcher } })
+
+    face.refreshPrices()
+    controller.dispose()
+    await new Promise<void>((resolve) => { setTimeout(resolve, 0) })
+
+    expect(form.mutate).not.toHaveBeenCalled()
+    // Nothing is published once disposed, so the last state still shows the read in progress.
+    expect(state().prices.busy).toBe(true)
+  })
+
+  it('does not write an answer that arrives after it was disposed', async () => {
+    let respond: (response: Response) => void = () => {}
+    const fetcher = vi.fn(() => new Promise<Response>((resolve) => { respond = resolve }))
+    const { face, form, controller } = bench({ deps: { fetcher } })
+    face.refreshPrices()
+
+    controller.dispose()
+    respond(Response.json(priceDocument()))
+    await new Promise<void>((resolve) => { setTimeout(resolve, 0) })
+
+    expect(form.mutate).not.toHaveBeenCalled()
+  })
+})
