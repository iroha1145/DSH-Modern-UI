@@ -0,0 +1,35 @@
+/* Adapted from slev12397/beautiful-ui LoadingState.tsx and globals.css (MIT). */
+.content {
+  gap: 10px;
+}
+
+.label {
+  min-width: 0;
+  font-size: 13px;
+  font-weight: 500;
+  color: transparent;
+  background-image: linear-gradient(90deg, var(--bui-ink-3, var(--dsw-alias-label-tertiary)) 35%, var(--bui-ink, var(--dsw-alias-label-primary)) 50%, var(--bui-ink-3, var(--dsw-alias-label-tertiary)) 65%);
+  background-clip: text;
+  background-size: 200% 100%;
+  animation: loading-shimmer-text 1.4s linear infinite;
+}
+
+.elapsed {
+  font-family: var(--ds-font-family-code);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+  color: var(--bui-ink-3, var(--dsw-alias-label-tertiary));
+}
+
+@keyframes loading-shimmer-text {
+  from { background-position: 150% center; }
+  to { background-position: -50% center; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .label {
+    animation: none;
+    background: none;
+    color: var(--bui-ink-3, var(--dsw-alias-label-tertiary));
+  }
+}
diff --git a/packages/client/ui-chat/src/client/chat/MessageCode.tsx b/packages/client/ui-chat/src/client/chat/MessageCode.tsx
new file mode 100644
