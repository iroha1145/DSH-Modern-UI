 .activityExpanded { flex: 1; min-width: 0; }
+
+.suggestionRow:disabled {
+  cursor: default;
+  opacity: 0.5;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .suggestionRow,
+  .card,
+  .add,
+  .primary {
+    animation: none;
+    transition: none;
+  }
+}
+
+@media (max-width: 640px) {
+  .root {
+    padding-bottom: 8px;
+  }
+
+  /* Suggested tasks remain available on desktop; phones keep the input at
+     the bottom without a second block underneath the message field. */
+  .heroSuggestions {
+    display: none;
+  }
+}
