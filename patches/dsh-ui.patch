diff --git a/packages/mcp/mcp-client/tests/transport-redirects.spec.ts b/packages/mcp/mcp-client/tests/transport-redirects.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d21f01299bfc4a1076b55ac4c888ce948ebafae4
--- /dev/null
+++ b/packages/mcp/mcp-client/tests/transport-redirects.spec.ts
@@ -0,0 +1,61 @@
+/** Real loopback HTTP transport coverage; credentials and bodies are synthetic. */
+import { createServer } from 'node:http'
+import type { Server, IncomingMessage, ServerResponse } from 'node:http'
+import { once } from 'node:events'
+import { describe, expect, it } from 'vitest'
+import { createTransport } from '../src/transport.ts'
+
+async function listen(handler: (request: IncomingMessage, response: ServerResponse) => void): Promise<{ server: Server; url: string }> {
+  const server = createServer(handler)
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+  const address = server.address()
+  if (address === null || typeof address === 'string') throw new Error('Expected TCP address')
+  return { server, url: `http://127.0.0.1:${address.port}/mcp` }
+}
+
+async function close(server: Server): Promise<void> {
+  server.closeAllConnections()
+  await new Promise<void>((resolve, reject) => server.close((error) => { if (error) reject(error); else resolve() }))
+}
+
+describe('MCP HTTP redirect policy', () => {
+  it.each([{ status: 307, sameOrigin: false }, { status: 308, sameOrigin: false }, { status: 307, sameOrigin: true }, { status: 308, sameOrigin: true }])('refuses $status before contacting its target (same origin: $sameOrigin)', async ({ status, sameOrigin }) => {
+    let targetRequests = 0
+    let initialHeader: string | string[] | undefined
+    let initialBody = ''
+    const target = await listen((_request, response) => { targetRequests++; response.writeHead(202).end() })
+    const origin = await listen((request, response) => {
+      if (request.url === '/target') { targetRequests++; response.writeHead(202).end(); return }
+      initialHeader = request.headers['x-fixture-secret']
+      request.setEncoding('utf8')
+      request.on('data', (chunk: string) => { initialBody += chunk })
+      request.on('end', () => response.writeHead(status, { location: sameOrigin ? origin.url.replace('/mcp', '/target') : target.url }).end())
+    })
+    const transport = createTransport({ transport: 'streamable-http', serverName: 'redirect-test', url: origin.url, headers: { 'X-Fixture-Secret': 'synthetic-secret' }, toolCallTimeoutMs: 1000, failOnStartupError: true })
+    try {
+      await transport.start()
+      await expect(transport.send({ jsonrpc: '2.0', method: 'notifications/initialized', params: { fixture: 'synthetic-body' } })).rejects.toThrow()
+      expect(initialHeader).toBe('synthetic-secret')
+      expect(initialBody).toContain('synthetic-body')
+      expect(targetRequests).toBe(0)
+    } finally {
+      await transport.close()
+      await Promise.all([close(origin.server), close(target.server)])
+    }
+  })
+
+  it('delivers the same request to a nonredirecting configured endpoint', async () => {
+    let requests = 0
+    const origin = await listen((request, response) => { requests++; request.resume(); response.writeHead(202).end() })
+    const transport = createTransport({ transport: 'streamable-http', serverName: 'direct-test', url: origin.url, headers: { 'X-Fixture-Secret': 'synthetic-secret' }, toolCallTimeoutMs: 1000, failOnStartupError: true })
+    try {
+      await transport.start()
+      await expect(transport.send({ jsonrpc: '2.0', method: 'notifications/initialized' })).resolves.toBeUndefined()
+      expect(requests).toBe(1)
+    } finally {
+      await transport.close()
+      await close(origin.server)
+    }
+  })
+})
