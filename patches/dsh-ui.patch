+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+import { IntelligentUI } from '../src/client/IntelligentUI.tsx'
+import type { ThemeSnapshot } from '@deepseek-ai/dsh-client-ui-theme/client'
+import type { FrameCallbacks, FrameOptions } from '../src/client/sandbox.ts'
+import type { IntelligentContent } from '../src/client/schema.ts'
+import { en } from '../src/client/locales.ts'
+
+interface MountRecord { content: IntelligentContent; callbacks: FrameCallbacks; options: FrameOptions; dispose: ReturnType<typeof vi.fn> }
+const instances = vi.hoisted(() => ({ mounts: [] as MountRecord[] }))
+vi.mock('../src/client/sandbox.ts', () => ({ mountVisualization: vi.fn((_container, content: IntelligentContent, callbacks: FrameCallbacks, options: FrameOptions) => {
+  const dispose = vi.fn()
+  instances.mounts.push({ content, callbacks, options, dispose })
+  return dispose
+}) }))
+vi.mock('@deepseek-ai/dsh-client-ui-primitives', () => ({
+  CodeBlock: ({ code, lang }: { code: string; lang: string }) => <pre data-testid="source" data-lang={lang}><code>{code}</code></pre>,
+  TextShimmer: ({ children }: { children: ReactNode }) => <span>{children}</span>,
+}))
+afterEach(() => { cleanup(); instances.mounts.length = 0; vi.restoreAllMocks() })
+
+// jsdom has no scrollIntoView; a link request scrolls itself into view when it appears.
+const scrollIntoView = vi.fn()
+beforeEach(() => {
+  scrollIntoView.mockClear()
+  const descriptor = Object.getOwnPropertyDescriptor(Element.prototype, 'scrollIntoView')
+  Object.defineProperty(Element.prototype, 'scrollIntoView', { configurable: true, writable: true, value: scrollIntoView })
+  onTestFinished(() => {
+    if (descriptor === undefined) Reflect.deleteProperty(Element.prototype, 'scrollIntoView')
+    else Object.defineProperty(Element.prototype, 'scrollIntoView', descriptor)
+  })
+})
+
+const content = { version: 1, title: 'Growth', fallback: 'Growth was 20%.', html: '<button>Next</button>' }
+const source = JSON.stringify(content)
+const fragment = '<title>Hourly rain</title>\n<section class="ui-card"><i data-icon="cloud-rain"></i><div id="bars"></div></section>\n<script>draw()</script>'
+const props = { settled: true, closed: true, matched: {}, lang: 'openui', useTheme: <T,>(selector: (snapshot: ThemeSnapshot) => T): T => selector({ active: { colorScheme: 'light' } } as ThemeSnapshot), code: source, streaming: false, labels: { copyLabel: 'Copy', copiedLabel: 'Copied' }, t: (key: keyof typeof en) => en[key] } as Parameters<typeof IntelligentUI>[0]
+
+describe('assistant visualization lifecycle', () => {
+  it('shows a quiet placeholder while the fence is still open and never mounts it', () => {
+    const view = render(<IntelligentUI {...props} code={'<title>Hourly rain</title>\n<div'} streaming settled={false} closed={false} />)
+    expect(instances.mounts).toHaveLength(0)
+    expect(view.getByText(en.preparing)).toBeTruthy()
+    expect(view.getByText('Hourly rain')).toBeTruthy()
+    expect(view.queryByTestId('source')).toBeNull()
+  })
+  it('renders as soon as the fence closes while the answer keeps streaming, without remounting at completion', () => {
+    const view = render(<IntelligentUI {...props} code={fragment} streaming settled={false} />)
+    expect(instances.mounts).toHaveLength(1)
+    view.rerender(<IntelligentUI {...props} code={fragment} />)
+    expect(instances.mounts).toHaveLength(1)
+    expect(instances.mounts[0]!.dispose).not.toHaveBeenCalled()
+  })
+  it('keeps exact source for rejected input without mounting it', () => {
+    const view = render(<IntelligentUI {...props} code="{truncated" />)
+    expect(instances.mounts).toHaveLength(0)
+    expect(view.getByText(en.invalid)).toBeTruthy()
+    expect(view.getByTestId('source').textContent).toBe('{truncated')
+  })
+  it.each([{ settled: false, closed: true }, { settled: true, closed: false }, { settled: false, closed: false }])('does not execute a stopped or unclosed block %o', (state) => {
+    const view = render(<IntelligentUI {...props} {...state} />)
+    expect(instances.mounts).toHaveLength(0)
+    expect(view.getByText(en.incomplete)).toBeTruthy()
+    expect(view.getByTestId('source').textContent).toBe(source)
+    expect(view.queryByText(en.preparing)).toBeNull()
+  })
+  it('mounts independent frames and disposes each one', () => {
+    const view = render(<><IntelligentUI {...props} /><IntelligentUI {...props} /></>)
+    expect(instances.mounts).toHaveLength(2)
+    const mounted = [...instances.mounts]
+    view.unmount()
+    for (const instance of mounted) expect(instance.dispose).toHaveBeenCalledOnce()
+  })
+  it('mounts an HTML fragment inline with its scripts, palette, and only the icons it mentions', () => {
+    const view = render(<IntelligentUI {...props} code={fragment} />)
+    expect(instances.mounts).toHaveLength(1)
+    const mounted = instances.mounts[0]!
+    expect(mounted.content).toMatchObject({ title: 'Hourly rain', jsExpressions: ['draw()'] })
+    expect(mounted.options.scheme).toBe('light')
+    expect(Object.keys(mounted.options.icons ?? {})).toEqual(['cloud-rain'])
+    expect(mounted.options.host?.fontSize).toMatch(/px$/)
+    expect(view.container.querySelector('[data-intelligent-fallback]')).toBeNull()
+    expect(view.queryByText('Hourly rain')).toBeNull()
+    fireEvent.click(view.getByRole('button', { name: en.source }))
+    expect(view.getByTestId('source').dataset.lang).toBe('html')
+    expect(view.getByTestId('source').textContent).toBe(fragment)
+  })
+  it('keeps the measured height across remounts and evicts the oldest beyond its limit', () => {
+    const frame = (view: ReturnType<typeof render>): HTMLElement => view.container.querySelector<HTMLElement>('[data-intelligent-frame]')!
+    const first = render(<IntelligentUI {...props} code={fragment} />)
+    act(() => { instances.mounts[0]!.callbacks.resized(321); instances.mounts[0]!.callbacks.ready() })
+    expect(frame(first).style.height).toBe('321px')
+    expect(frame(first).dataset.ready).toBe('true')
+    first.unmount()
+    const again = render(<IntelligentUI {...props} code={fragment} />)
+    expect(frame(again).style.height).toBe('321px')
+    again.unmount()
+    // Sixty-four other blocks measured since push the first one out of the remembered heights.
+    for (let index = 0; index < 64; index += 1) {
+      const other = render(<IntelligentUI {...props} code={`${fragment}<!-- ${index} -->`} />)
+      act(() => { instances.mounts.at(-1)!.callbacks.resized(200 + index) })
+      other.unmount()
+    }
+    const evicted = render(<IntelligentUI {...props} code={fragment} />)
+    expect(frame(evicted).style.height).not.toBe('321px')
+  })
+  it('treats frame links as untrusted requests and opens only after host confirmation', () => {
+    vi.useFakeTimers()
+    try {
+      const open = vi.spyOn(window, 'open').mockReturnValue(null)
+      const view = render(<IntelligentUI {...props} code={fragment} />)
+      const request = (href: string): void => { act(() => { instances.mounts[0]!.callbacks.openLink(href) }) }
+      const openButton = (): HTMLButtonElement => view.getByRole('button', { name: en.openLink }) as HTMLButtonElement
+      request('https://example.com/docs')
+      expect(open).not.toHaveBeenCalled()
+      expect(view.getByText('https://example.com/docs')).toBeTruthy()
+      expect(scrollIntoView).toHaveBeenCalledWith({ block: 'nearest' })
+      expect(view.getByRole('group', { name: en.openLinkQuestion }).getAttribute('aria-live')).toBe('polite')
+      // A script cannot replace the destination while the reader is deciding.
+      request('https://different.example/replacement')
+      expect(view.queryByText('https://different.example/replacement')).toBeNull()
+      // The button arms only after the request has been on screen, so a click aimed elsewhere cannot confirm it.
+      expect(openButton().disabled).toBe(true)
+      fireEvent.click(openButton())
+      expect(open).not.toHaveBeenCalled()
+      act(() => { vi.advanceTimersByTime(500) })
+      fireEvent.click(openButton())
+      expect(open).toHaveBeenCalledExactlyOnceWith('https://example.com/docs', '_blank', 'noopener,noreferrer')
+      expect(view.queryByRole('group', { name: en.openLinkQuestion })).toBeNull()
+      // A request right after the answer is dropped, so a second click cannot meet a new destination.
+      request('https://swap.example/')
+      expect(view.queryByText('https://swap.example/')).toBeNull()
+      act(() => { vi.advanceTimersByTime(1000) })
+      request('https://example.com/cancelled')
+      fireEvent.click(view.getByRole('button', { name: en.cancelLink }))
+      expect(open).toHaveBeenCalledOnce()
+      expect(view.queryByText('https://example.com/cancelled')).toBeNull()
+      request('https://example.com/after-cancel')
+      expect(view.queryByText('https://example.com/after-cancel')).toBeNull()
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+  it('clears pending destinations when the frame fails or is retried', () => {
+    const open = vi.spyOn(window, 'open').mockReturnValue(null)
+    const view = render(<IntelligentUI {...props} />)
+    act(() => { instances.mounts[0]!.callbacks.openLink('https://example.com/old') })
+    act(() => { instances.mounts[0]!.callbacks.failed() })
+    expect(view.queryByRole('button', { name: en.openLink })).toBeNull()
+    fireEvent.click(view.getByRole('button', { name: en.retry }))
+    act(() => { instances.mounts[1]!.callbacks.openLink('https://example.com/retry') })
+    act(() => { instances.mounts[1]!.callbacks.scriptError() })
+    fireEvent.click(view.getByRole('button', { name: en.retry }))
+    expect(view.queryByRole('button', { name: en.openLink })).toBeNull()
+    expect(open).not.toHaveBeenCalled()
+  })
+  it('shows JSON fallback and source controls after a failure, and retries locally', () => {
+    const view = render(<IntelligentUI {...props} />)
+    expect(view.queryByText(content.fallback)).toBeNull()
+    const first = instances.mounts[0]!
+    act(() => { first.callbacks.failed() })
+    expect(view.getByText(en.failed)).toBeTruthy()
+    expect(view.getByText(content.fallback)).toBeTruthy()
+    expect(view.queryByTestId('source')).toBeNull()
+    expect(first.dispose).toHaveBeenCalledOnce()
+    fireEvent.click(view.getByRole('button', { name: en.source }))
+    expect(view.getByTestId('source').textContent).toBe(source)
+    fireEvent.click(view.getByRole('button', { name: en.retry }))
+    expect(instances.mounts).toHaveLength(2)
+    expect(view.queryByText(en.failed)).toBeNull()
+  })
+  it('keeps the frame after a script error and offers a local retry', () => {
+    const view = render(<IntelligentUI {...props} code={fragment} />)
+    const first = instances.mounts[0]!
+    act(() => { first.callbacks.scriptError() })
+    expect(view.getByText(en.scriptError)).toBeTruthy()
+    expect(first.dispose).not.toHaveBeenCalled()
+    expect(view.container.querySelector('[data-intelligent-frame]')).not.toBeNull()
+    fireEvent.click(view.getByRole('button', { name: en.retry }))
+    expect(first.dispose).toHaveBeenCalledOnce()
+    expect(instances.mounts).toHaveLength(2)
+    expect(view.queryByText(en.scriptError)).toBeNull()
+  })
+})
